# --------------------------------------------------------------------------------------------
# Vendored-path resolution (the one function both checks share)
# --------------------------------------------------------------------------------------------


def resolve_vendored(written_path: str) -> tuple[Path, str | None]:
    """Resolve `written_path` as it is spelled in a trailer `source:` line or a
    `// PORT SRC:` marker -- always relative to `vendor/OrcaSlicer/` itself, and always
    against the real repository root, never `--tree`.

    Returns (absolute filesystem path on the pinned vendor tree, the manifest `path`-column
    key `written_path` corresponds to, or None if `written_path` does not carry the required
    `src/libslic3r/` prefix -- in which case it can never match a manifest row.

    A written path that climbs out of `vendor/OrcaSlicer/` (e.g. via a `..` segment, or an
    absolute path) is never a legitimate vendored source: it resolves to a sentinel path that
    cannot exist, so the caller's ordinary `is_file()` / read failure reports it as
    `source-path-absent` like any other path that is not on the pinned tree, rather than opening
    a real file outside the repository.

    This is the one function used by the trailer check and the `// PORT SRC:` check alike, so
    the two cannot resolve the same spelling two different ways."""
    abs_path = VENDOR_ROOT / written_path
    manifest_key = (
        written_path[len(VENDOR_SRC_PREFIX) :] if written_path.startswith(VENDOR_SRC_PREFIX) else None
    )
    try:
        escapes = not abs_path.resolve().is_relative_to(VENDOR_ROOT.resolve())
    except OSError:
        escapes = True
    if escapes:
        return VENDOR_ROOT / "__escapes_vendor_root__", manifest_key
    return abs_path, manifest_key


# --------------------------------------------------------------------------------------------
# Manifest
# --------------------------------------------------------------------------------------------


def load_manifest(path: Path) -> list[dict[str, str]]:
    """Parse `path` by its header row, not by column position (14-manifest-columns owns the
    spellings). Returns [] if the file is missing or empty. A fixture's manifest may carry
    only the columns this script actually reads; a row short of the header is padded with
    empty cells, the same tolerant read `port/inventory` already uses."""
    if not path.is_file():
        return []
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines:
        return []
    header = lines[0].split("\t")
    rows: list[dict[str, str]] = []
    for line in lines[1:]:
        if not line:
            continue
        cells = line.split("\t")
        cells += [""] * (len(header) - len(cells))
        rows.append(dict(zip(header, cells[: len(header)])))
    return rows


def index_manifest(rows: list[dict[str, str]]) -> dict[str, dict[str, str]]:
    """Index manifest rows by their `path` column."""
    return {row.get("path", ""): row for row in rows if row.get("path")}


def index_target_modules(rows: list[dict[str, str]]) -> set[str]:
    """Index manifest rows by their `target module` column (task.md's second index, "by their
    target crate and module"): the set of every ported-module path a manifest row names. This
    is what selects a real ported module for scanning even when it carries no trailer or marker
    yet -- see `scan_tree`."""
    return {row["target module"] for row in rows if row.get("target module")}


# --------------------------------------------------------------------------------------------
# Line classification: code / comment, exempt positions, contiguous comment runs
# --------------------------------------------------------------------------------------------


def split_code_comment(line: str) -> tuple[str, str]:
    """Split `line` into (code part, comment part including the leading `//`), finding the
    first `//` that is outside a string or char literal. Does not understand raw strings
    (`r"..."`, `r#"..."#`) or byte strings -- a documented limit of a text-based scan that
    never appears in this script's own fixtures or is expected to appear in a ported module's
    normal code."""
    in_string = False
    in_char = False
    i = 0
    n = len(line)
    while i < n:
        c = line[i]
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
            i += 1
            continue
        if in_char:
            if c == "\\":
                i += 2
                continue
            if c == "'":
                in_char = False
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c == "'":
            # Could be a char literal start or a lifetime (`'a`). A char literal closes
            # within the next couple of characters; a lifetime does not before a non-ident
            # character. Treat it as a char literal only if a closing `'` appears within 4
            # characters, which covers 'a', '\n', '\'', '\\' and the few escapes this
            # tolerant scan needs to get right.
            closes = line.find("'", i + 1, i + 5)
            if closes != -1:
                in_char = True
                i += 1
                continue
            i += 1
            continue
        if c == "/" and i + 1 < n and line[i + 1] == "/":
            return line[:i], line[i:]
        i += 1
    return line, ""


def strip_block_comments(text: str) -> str:
    """Replace the interior of every `/* ... */` block comment in `text` with spaces, one of
    the two closed exempt positions `--help` states for the numeric-literal rule (the other,
    line comments, is already handled by `split_code_comment`). Tracks state across the whole
    file, not line by line, since a block comment spans lines; preserves every newline and the
    length of every other line exactly, so line numbers and in-line character offsets (used by
    the negative-sign lookback elsewhere) do not shift. A `/*` found while already inside a `//`
    line comment or a string/char literal does not start a block (a line comment itself ends at
    the next newline, which also closes that state)."""
    out = list(text)
    in_string = False
    in_char = False
    in_line_comment = False
    in_block = False
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c == "\n":
            in_line_comment = False
            i += 1
            continue
        if in_line_comment:
            i += 1
            continue
        if in_block:
            if c == "*" and i + 1 < n and text[i + 1] == "/":
                out[i] = " "
                out[i + 1] = " "
                in_block = False
                i += 2
                continue
            out[i] = " "
            i += 1
            continue
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
            i += 1
            continue
        if in_char:
            if c == "\\":
                i += 2
                continue
            if c == "'":
                in_char = False
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c == "'":
            closes = text.find("'", i + 1, i + 5)
            if closes != -1 and "\n" not in text[i + 1 : closes]:
                in_char = True
                i += 1
                continue
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            in_line_comment = True
            i += 2
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            out[i] = " "
            out[i + 1] = " "
            in_block = True
            i += 2
            continue
        i += 1
    return "".join(out)


@dataclass
class LineInfo:
    raw: str
    code: str
    comment: str
    is_pure_comment: bool
    exempt: bool  # exempt position for the numeric-literal rule: attribute or cfg(test) body


def classify_lines(text: str) -> list[LineInfo]:
    raw_lines = text.splitlines()
    # Block-comment interiors are blanked out before the code/comment split, so a numeric
    # literal or the word "unsafe" written inside a `/* ... */` is invisible to both checks --
    # the same way a string literal's contents already are (`mask_strings`, applied later).
    # The genuine `//` line comments that remain (including one on the same line right after a
    # block comment closes) are untouched, since only block-comment bytes are replaced.
    masked_lines = strip_block_comments(text).splitlines()
    infos: list[LineInfo] = []
    in_cfg_test = False
    cfg_test_depth = 0
    cfg_test_seen_open = False
    for raw, masked in zip(raw_lines, masked_lines):
        code, comment = split_code_comment(masked)
        stripped = raw.strip()
        # Deliberately computed from the unmasked `raw`, not `masked`: a line that merely
        # starts with `//` inside a `/* ... */` region (a comment commenting out a comment) is
        # a documented limit of this text-based scan, the same shape of limit as the raw-string
        # one `split_code_comment` already states, and is not expected in a ported module.
        is_pure_comment = stripped.startswith("//")
        exempt = False
        if in_cfg_test:
            # Braces are counted on `mask_strings(code)`, never on raw `code`: a `{` or a `}`
            # written inside a string or char literal is text, not a block delimiter, and must
            # not move the depth in either direction. Counting it either strands the exemption
            # on to end of file (a silent per-file opt-out from the numeric-constant rule,
            # which --help says does not exist) or drops it early inside a real test body.
            masked_code = mask_strings(code)
            semi = masked_code.find(";")
            first_open = masked_code.find("{")
            if not cfg_test_seen_open and semi != -1 and (first_open == -1 or semi < first_open):
                # The no-body case: the attribute's item ended at its own semicolon without
                # ever opening a block (`#[cfg(test)] use ...;`, `#[cfg(test)] mod tests;`), so
                # the exemption ends on this line instead of waiting for a brace that never
                # comes. This line is not exempt either: the closed exempt position is "inside
                # a #[cfg(test)] module", and a braceless item is not a module, so a literal
                # written on it still needs its marker (the fail-closed reading).
                in_cfg_test = False
            else:
                exempt = True
                opens = masked_code.count("{")
                closes = masked_code.count("}")
                if opens:
                    cfg_test_seen_open = True
                cfg_test_depth += opens - closes
                if cfg_test_seen_open and cfg_test_depth <= 0:
                    in_cfg_test = False
        elif CFG_TEST_RE.match(stripped):
            exempt = True
            in_cfg_test = True
            cfg_test_depth = 0
            cfg_test_seen_open = False
        elif stripped.startswith("#"):
            exempt = True
        infos.append(LineInfo(raw, code, comment, is_pure_comment, exempt))
    return infos


def contiguous_comment_block_above(lines: list[LineInfo], i: int) -> list[int]:
    """Indices (ascending) of the contiguous pure-comment lines immediately above line i, not
    including i itself."""
    idx = i - 1
    block: list[int] = []
    while idx >= 0 and lines[idx].is_pure_comment:
        block.append(idx)
        idx -= 1
    return list(reversed(block))


# --------------------------------------------------------------------------------------------
# Numeric literal normalisation and exemption
# --------------------------------------------------------------------------------------------


def normalize_literal(match: re.Match[str]) -> str:
    """Strip Rust digit separators and a type suffix, per the normalisation task
    21-port-status-markers states: `1_000` searches for `1000`, `0.4f32` searches for `0.4`."""
    return match.group("num").replace("_", "")


def literal_is_exempt(match: re.Match[str]) -> bool:
    """True for the closed exempt set: the integers 0, 1 and 2 -- structural indices, arities
    and strides, never a transcribed constant. The sign, if any, is a separate character before
    the match and never part of it (the regex carries no `-`), and does not change membership in
    a three-element set closed under negation in spirit (-0, -1, -2 are exempt for the same
    reason their unsigned forms are); a float is never exempt, which `normalize_literal` already
    ensures (its text would carry a `.` or an `e`)."""
    return normalize_literal(match) in EXEMPT_LITERAL_VALUES


def mask_strings(code: str) -> str:
    """Replace the contents of every string and char literal in `code` with 'x', preserving
    length and the position of everything outside them, so a digit written inside a string
    (an exempt position) never reaches the numeric-literal regex at all. Mirrors
    `split_code_comment`'s own string/char tracking, since both exist to keep this script from
    reading inside a Rust string as if it were code; does not understand raw strings, the same
    documented limit `split_code_comment` states."""
    out = list(code)
    in_string = False
    in_char = False
    i = 0
    n = len(code)
    while i < n:
        c = code[i]
        if in_string:
            if c == "\\":
                out[i] = "x"
                if i + 1 < n:
                    out[i + 1] = "x"
                i += 2
                continue
            if c == '"':
                in_string = False
                i += 1
                continue
            out[i] = "x"
            i += 1
            continue
        if in_char:
            if c == "\\":
                out[i] = "x"
                if i + 1 < n:
                    out[i + 1] = "x"
                i += 2
                continue
            if c == "'":
                in_char = False
                i += 1
                continue
            out[i] = "x"
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c == "'":
            closes = code.find("'", i + 1, i + 5)
            if closes != -1:
                in_char = True
                i += 1
                continue
            i += 1
            continue
        i += 1
    return "".join(out)


def find_literals(code: str) -> list[re.Match[str]]:
    """Numeric literals in `code`, a line's code part, with string and char literal contents
    masked out first so a digit written inside one of those exempt positions is invisible to
    the regex rather than merely ignored after the fact."""
    return list(NUMERIC_LITERAL_RE.finditer(mask_strings(code)))


# --------------------------------------------------------------------------------------------
# The marker whitelist
# --------------------------------------------------------------------------------------------


def check_marker_whitelist(path: str, lines: list[LineInfo], result: ScanResult) -> None:
    for i, info in enumerate(lines):
        for comment_text in ([info.comment] if info.comment else []) + (
            [info.raw.strip()] if info.is_pure_comment and not info.comment else []
        ):
            text = comment_text.lstrip("/").strip()
            classified = classify_comment_marker(text)
            if classified is None:
                continue
            status, prefix = classified
            if status == "recognized":
                result.marker_counts[prefix] += 1
            else:
                result.fail(
                    path,
                    i + 1,
                    "unrecognized-marker",
                    f"'// {prefix}:' is not one of the six recognised markers "
                    f"({', '.join(sorted(MARKER_WHITELIST))}); no near-miss spelling is "
                    "accepted and there is no per-file opt-out",
                )


# --------------------------------------------------------------------------------------------
# PORT STATUS trailer
# --------------------------------------------------------------------------------------------


def check_trailer(
    path: str,
    lines: list[LineInfo],
    manifest_by_path: dict[str, dict[str, str]],
    module_relpath: str,
    result: ScanResult,
) -> None:
    n = len(lines)
    last = n - 1
    while last >= 0 and lines[last].raw.strip() == "":
        last -= 1
    if last < 0:
        result.fail(path, 1, "missing-trailer", "file is empty; no PORT STATUS trailer")
        return

    header_idx = None
    for i in range(last, -1, -1):
        if lines[i].raw.strip() == TRAILER_HEADER:
            header_idx = i
            break
    if header_idx is None:
        result.fail(
            path,
            last + 1,
            "missing-trailer",
            "no line reading exactly '// PORT STATUS' found; every ported module must end "
            "with a PORT STATUS trailer",
        )
        return

    # Every line from the header to the true end of file must be a line comment with no gap.
    for i in range(header_idx, last + 1):
        if not lines[i].raw.strip().startswith("//"):
            result.fail(
                path,
                header_idx + 1,
                "trailer-not-last",
                f"line {i + 1} after the PORT STATUS header is not a line comment; the "
                "trailer must be the file's last non-blank content",
            )
            return

    sources: list[str] = []
    confidence: str | None = None
    tier: str | None = None
    oracle: str | None = None
    confidence_line: int | None = None
    tier_line: int | None = None
    oracle_line: int | None = None
    seen_non_source = False
    order_idx = 0
    for i in range(header_idx + 1, last + 1):
        m = TRAILER_KEY_RE.match(lines[i].raw.strip())
        if not m:
            result.fail(
                path,
                i + 1,
                "trailer-not-last",
                "trailer line is neither a recognised key (source/confidence/tier/oracle) "
                "nor part of the header; the trailer must be exactly the five keys, in order",
            )
            return
        key, value = m.group("key"), m.group("value").strip()
        if key == "source":
            if seen_non_source:
                result.fail(path, i + 1, "trailer-not-last", "'source:' out of order")
                return
            sources.append(value)
            continue
        seen_non_source = True
        # The trailer's keys, after any 'source:' lines, must appear in this exact order
        # (TRAILER_KEY_ORDER): a key out of sequence -- including a repeat of one already seen,
        # which always lands on the wrong next slot -- is a finding rather than silently
        # accepted, matching what --help and this rule's own failure message state.
        expected_key = TRAILER_KEY_ORDER[order_idx] if order_idx < len(TRAILER_KEY_ORDER) else None
        if key != expected_key:
            result.fail(
                path,
                i + 1,
                "trailer-not-last",
                f"'{key}:' is out of order; after 'source:' the trailer's keys must appear as "
                "exactly 'confidence:', 'tier:', 'oracle:' in that order",
            )
            return
        order_idx += 1
        if key == "confidence":
            confidence, confidence_line = value, i + 1
        elif key == "tier":
            tier, tier_line = value, i + 1
        elif key == "oracle":
            oracle, oracle_line = value, i + 1

    trailer_line = last + 1

    if not sources:
        result.fail(
            path, trailer_line, "no-source", "trailer has no 'source:' line; at least one is required"
        )
    if confidence is None or confidence not in CONFIDENCE_VALUES:
        result.fail(
            path,
            confidence_line or trailer_line,
            "bad-confidence",
            f"'confidence: {confidence}' is not one of {sorted(CONFIDENCE_VALUES)}",
        )
    if oracle is None or oracle not in ORACLE_VALUES:
        result.fail(
            path,
            oracle_line or trailer_line,
            "bad-oracle",
            f"'oracle: {oracle}' is not one of {sorted(ORACLE_VALUES)}",
        )
    if tier is None:
        result.fail(path, trailer_line, "bad-tier", "trailer has no 'tier:' line")

    manifest_rows: list[dict[str, str]] = []
    for source in sources:
        abs_path, manifest_key = resolve_vendored(source)
        if manifest_key is None:
            result.fail(
                path,
                trailer_line,
                "source-path-absent",
                f"'source: {source}' does not start with '{VENDOR_SRC_PREFIX}'",
            )
            continue
        if not abs_path.is_file():
            result.fail(
                path,
                trailer_line,
                "source-path-absent",
                f"'source: {source}' does not exist in the vendored tree at the pin",
            )
            continue
        row = manifest_by_path.get(manifest_key)
        if row is None:
            result.fail(
                path,
                trailer_line,
                "source-wrong-module",
                f"'source: {source}' has no row in port/manifest.tsv",
            )
            continue
        target_module = row.get("target module", "")
        if target_module != module_relpath:
            result.fail(
                path,
                trailer_line,
                "source-wrong-module",
                f"'source: {source}' has a manifest row naming '{target_module}', not this "
                f"module ('{module_relpath}')",
            )
            continue
        manifest_rows.append(row)

    if manifest_rows:
        tiers = {row.get("equality tier", "") for row in manifest_rows}
        if len(tiers) > 1:
            result.fail(
                path,
                trailer_line,
                "source-tier-disagreement",
                f"this module's 'source:' rows disagree about equality tier: {sorted(tiers)}",
            )
        elif tier is not None:
            (expected_tier,) = tiers
            if tier != expected_tier:
                result.fail(
                    path,
                    tier_line or trailer_line,
                    "tier-mismatch",
                    f"'tier: {tier}' does not match the manifest row's equality tier "
                    f"'{expected_tier}'",
                )


# --------------------------------------------------------------------------------------------
# // SAFETY: on every `unsafe`
# --------------------------------------------------------------------------------------------


def check_safety(path: str, lines: list[LineInfo], result: ScanResult) -> None:
    for i, info in enumerate(lines):
        if info.is_pure_comment:
            continue
        if not UNSAFE_WORD_RE.search(mask_strings(info.code)):
            continue
        covering = contiguous_comment_block_above(lines, i) + ([i] if info.comment else [])
        has_safety = False
        for j in covering:
            text = (lines[j].comment or lines[j].raw).lstrip("/").strip()
            if SAFETY_MARKER_RE.match(text):
                has_safety = True
                break
        if not has_safety:
            result.fail(
                path,
                i + 1,
                "missing-safety",
                "'unsafe' with no '// SAFETY:' comment on this line or the contiguous "
                "comment lines immediately above it",
            )


# --------------------------------------------------------------------------------------------
# // PORT SRC: beside every numeric constant, and the placeholder-constant check
# --------------------------------------------------------------------------------------------


def _vendored_line_text(abs_path: Path, line_no: int) -> str | None:
    try:
        text_lines = abs_path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    if line_no < 1 or line_no > len(text_lines):
        return None
    return text_lines[line_no - 1]


def _vendored_line_holds(normalized: str, vendored_text: str) -> bool:
    """True if `vendored_text` (a cited vendored line) actually writes the normalised literal
    `normalized`, not merely contains its digits as a substring of some other number -- e.g.
    "12" must not match inside "0.0125", the placeholder-constant case R16 exists to catch.
    Requires a non-digit, non-'.' boundary on both sides of the match."""
    return re.search(r"(?<![\d.])" + re.escape(normalized) + r"(?![\d.])", vendored_text) is not None


def check_numeric_constants(path: str, lines: list[LineInfo], result: ScanResult) -> None:
    for i, info in enumerate(lines):
        if info.is_pure_comment or info.exempt:
            continue
        literal_matches = [m for m in find_literals(info.code) if not literal_is_exempt(m)]
        if not literal_matches:
            continue

        covering_idx = contiguous_comment_block_above(lines, i) + ([i] if info.comment else [])
        markers: list[tuple[int, str, int]] = []  # (line_idx, path, line_no)
        for j in covering_idx:
            comment_text = lines[j].comment if j == i else lines[j].raw
            for m in PORT_SRC_RE.finditer(comment_text):
                markers.append((j, m.group("path"), int(m.group("line"))))

        if not markers:
            for lm in literal_matches:
                result.fail(
                    path,
                    i + 1,
                    "missing-port-src",
                    f"numeric literal '{lm.group(0)}' has no '// PORT SRC:' marker on this "
                    "line or the contiguous comment lines above it",
                )
            continue

        # Resolve each marker once; a marker whose path/line do not exist at the pin is its
        # own finding (not a content-match question).
        resolved: list[tuple[int, str, str | None]] = []  # (line_idx, text or None if missing)
        for j, marker_path, marker_line in markers:
            abs_path, _ = resolve_vendored(marker_path)
            text = _vendored_line_text(abs_path, marker_line)
            if text is None:
                result.fail(
                    path,
                    j + 1,
                    "source-path-absent",
                    f"'// PORT SRC: {marker_path}:{marker_line}' does not exist at the pin",
                )
            resolved.append((j, f"{marker_path}:{marker_line}", text))

        # Per-literal direction: every non-exempt literal needs at least one covering marker
        # whose vendored line contains its normalised text. A plain substring search would
        # match "0.0125" inside a cited line that actually writes some unrelated "12" the way it
        # would match a genuine transcription, so require a non-digit, non-dot boundary on both
        # sides -- the placeholder-constant case R16 exists to catch.
        for lm in literal_matches:
            normalized = normalize_literal(lm)
            if not any(
                text is not None and _vendored_line_holds(normalized, text)
                for _, _, text in resolved
            ):
                result.fail(
                    path,
                    i + 1,
                    "placeholder-constant",
                    f"numeric literal '{lm.group(0)}' (normalised '{normalized}') is not held "
                    "by any of this line's '// PORT SRC:' markers",
                )

        # Per-marker direction: every marker needs to match at least one literal on the line.
        for j, label, text in resolved:
            if text is None:
                continue
            if not any(_vendored_line_holds(normalize_literal(lm), text) for lm in literal_matches):
                result.fail(
                    path,
                    j + 1,
                    "unmatched-port-src",
                    f"'// PORT SRC: {label}' matches no literal on the line it covers",
                )


# --------------------------------------------------------------------------------------------
# task 23-perf-backlog: the perf-backlog row generator and the per-marker assertion.
#
# `port/reports/perf-backlog.md` is the only place a knowingly slower translation lives (R15);
# `port/reports/divergences.md`'s `fidelity-marker` rows (task 18-divergences-regeneration,
# first cell `== "fidelity-marker"`, never the '## Sources' summary table below it) are the other
# half this task's assertion covers. What a port task's branch passes is the per-marker
# assertion below, never a whole-file regeneration or diff -- `port/regenerate` (R15's
# generating pass) imports `build_perf_backlog_rows` and `render_perf_backlog` from this module
# (the way `port/cut-tasks` already imports `port/inventory`) so the generator and this
# assertion can never derive a row two different ways.
# --------------------------------------------------------------------------------------------


def marker_comment_text(lines: list[LineInfo], i: int) -> str | None:
    """The comment text at line `i`, exactly as `check_marker_whitelist` already considers it
    (a trailing comment after code, or -- only when there is no such trailing comment -- a pure
    comment line's own raw text), duplicated rather than shared so a future change to that
    check's own text extraction cannot silently change what this task's rule sees. Returns None
    for a line that is neither."""
    info = lines[i]
    if info.comment:
        return info.comment.lstrip("/").strip()
    if info.is_pure_comment:
        return info.raw.strip().lstrip("/").strip()
    return None


def find_prefixed_markers(lines: list[LineInfo], prefix: str) -> list[int]:
    """Indices of every line classified (`classify_comment_marker`) as a candidate or recognised
    marker whose prefix is exactly `prefix` (e.g. ``"PERF(port)"``) -- used for `// PERF(port):`
    only; `// FIDELITY(port):` presence is found by `fidelity_marker_indices` instead, so its
    count can never disagree with what `port/audit-order` itself finds (see that function)."""
    out = []
    for i in range(len(lines)):
        text = marker_comment_text(lines, i)
        if text is None:
            continue
        classified = classify_comment_marker(text)
        if classified is None:
            continue
        _, found_prefix = classified
        if found_prefix == prefix:
            out.append(i)
    return out


# Identical to port/audit-order's own FIDELITY_MARKER_RE: a raw per-line substring match, no
# code/comment/string masking. `// FIDELITY(port):` presence is deliberately found this same way
# (not through classify_comment_marker's masking-aware view, which `find_prefixed_markers` uses
# for `// PERF(port):`) so this task's count of what is "still in the tree" agrees with what
# audit-order would (re)generate into divergences.md for every file both scripts can read --
# scan_markers's own tolerance of an unreadable file (see its "except OSError" below) is the one
# documented exception, deliberately different from audit-order's own SystemExit there --
# well-formedness is still checked against classify_lines' structural view of that same line,
# independently, below.
FIDELITY_LINE_RE = re.compile(r"//\s*FIDELITY\(port\):")


def fidelity_marker_indices(text: str) -> list[int]:
    """0-based line indices of every `// FIDELITY(port):` marker in `text`, found the same way
    `port/audit-order`'s `fidelity_marker_rows` finds them."""
    return [i for i, line in enumerate(text.splitlines()) if FIDELITY_LINE_RE.search(line)]


def trailer_sources(lines: list[LineInfo]) -> list[str]:
    """The trailer's raw `source:` values, in order, read the same way `check_trailer` finds the
    header and walks forward -- but tolerant: a missing or malformed trailer (no header, or a
    non-'source:' key before any source line) returns `[]` rather than raising a finding of its
    own, since `check_trailer` already reports those, for every module it scans, as
    `missing-trailer` / `no-source` / `trailer-not-last`. This function only answers "what
    vendored path does this module's trailer claim", for a `// PERF(port):` row's source cell --
    it is read-only and never duplicates check_trailer's validation."""
    n = len(lines)
    last = n - 1
    while last >= 0 and lines[last].raw.strip() == "":
        last -= 1
    header_idx = None
    for i in range(last, -1, -1):
        if lines[i].raw.strip() == TRAILER_HEADER:
            header_idx = i
            break
    if header_idx is None:
        return []
    sources: list[str] = []
    for i in range(header_idx + 1, last + 1):
        m = TRAILER_KEY_RE.match(lines[i].raw.strip())
        if not m or m.group("key") != "source":
            break
        sources.append(m.group("value").strip())
    return sources


def extract_reason(lines: list[LineInfo], marker_idx: int) -> str:
    """The marker's reason text: everything after the first `:` in its own comment, plus every
    contiguous **bare** `//` comment line directly below that is not itself blank, the trailer
    header, or another candidate/recognised marker (so two markers, or a marker immediately
    followed by the `PORT STATUS` trailer, never get merged into one reason) -- joined with a
    single space. This is the shape task 23's own fixture (`port/tests/port-status/pass/.../
    circle.rs`'s two-line `// PERF(port):` comment) needs: the marker text itself names no
    vendored path (R14's other markers never required one either), so a reason may legitimately
    span more than one line.

    Absorption stops at a `///` or `//!` doc comment (or any line whose raw text does not start
    with a bare `//`): those are prose about the code, not the marker's own reason, and letting
    them into a backlog row both misrepresents the reason and makes an untouched marker's derived
    row go stale the moment a port task edits only the adjacent doc comment -- exactly the
    fan-out stall this task's "keyed on content not line number" design exists to prevent."""
    first = marker_comment_text(lines, marker_idx) or ""
    after_colon = first.split(":", 1)[1].strip() if ":" in first else ""
    parts = [after_colon] if after_colon else []
    j = marker_idx + 1
    while j < len(lines) and lines[j].is_pure_comment:
        raw_stripped = lines[j].raw.strip()
        if raw_stripped.startswith("///") or raw_stripped.startswith("//!"):
            break
        text = marker_comment_text(lines, j) or ""
        if not text or text == "PORT STATUS" or classify_comment_marker(text) is not None:
            break
        parts.append(text)
        j += 1
    return " ".join(parts)


def crates_rs_files(tree: Path) -> list[Path]:
    """Every `.rs` file under `tree/crates`, at the same breadth `port/audit-order`'s own
    `fidelity_marker_rows` uses (`rglob`, skipping any path with a `target` component) --
    deliberately broader than `scan_tree`'s ported-module selection, since a
    `// FIDELITY(port):` marker in `crates/*/tests/` or `crates/slic3r-ffi/fuzz/fuzz_targets/`
    must still produce a `divergences.md` row (task 18-divergences-regeneration), and this
    task's per-marker assertion must be able to find that same marker to validate that row."""
    crates_root = tree / "crates"
    if not crates_root.is_dir():
        return []
    out = []
    for rs_path in sorted(crates_root.rglob("*.rs")):
        if "target" in rs_path.relative_to(crates_root).parts:
            continue
        out.append(rs_path)
    return out


def escape_cell(text: str) -> str:
    """Escape a cell so free prose (which may carry `|`) can never break a Markdown row --
    identical in effect to `port/audit-order`'s own `escape_cell`, duplicated here rather than
    imported since importing that script would also run its own CLI machinery."""
    return text.replace("|", "\\|").replace("\n", " ")


def scan_markers(tree: Path) -> MarkerScanResult:
    """One pass over every `.rs` file under `tree/crates` (see `crates_rs_files`) for every
    `// PERF(port):` and `// FIDELITY(port):` marker, applying task 23-perf-backlog's own
    well-formedness rule to each: on its own comment line, carrying a non-empty reason, and --
    `// PERF(port):` only -- its enclosing module's trailer naming at least one vendored
    `source:` path (`// FIDELITY(port):` rows in `divergences.md` carry no source cell at all,
    task 18-divergences-regeneration, so that half of the rule does not apply to it; a
    `// FIDELITY(port):` marker legitimately lives in a file with no trailer at all, such as
    `crates/*/tests/t.rs`, which `crates_rs_files`'s breadth exists to reach)."""
    result = MarkerScanResult()
    for rs_path in crates_rs_files(tree):
        try:
            text = rs_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            # Unlike `port/audit-order`'s `fidelity_marker_rows`, which raises `SystemExit` for
            # exactly this case, a file this per-marker assertion cannot read is silently
            # skipped here: this function already runs on every port task's `--per-commit`, far
            # more often than the regeneration pass runs `audit-order`, so turning an unreadable
            # file into a hard stop for every concurrent port branch is a materially different
            # failure mode this task did not choose to add. This is a known, deliberate
            # divergence from audit-order's behaviour, not an oversight -- see the finding on
            # this in the pull request body.
            continue
        module_relpath = rs_path.relative_to(tree).as_posix()
        lines = classify_lines(text)

        perf_idxs = find_prefixed_markers(lines, PERF_PREFIX)
        if perf_idxs:
            sources = trailer_sources(lines)
            source_cell = "; ".join(sources)
            for idx in perf_idxs:
                if not lines[idx].is_pure_comment:
                    result.findings.append(Finding(
                        module_relpath, idx + 1, "perf-marker-not-on-own-line",
                        "'// PERF(port):' must be on its own comment line, not trailing after "
                        "code, to be well formed (R15)",
                    ))
                    continue
                if not sources:
                    result.findings.append(Finding(
                        module_relpath, idx + 1, "perf-marker-no-source",
                        "'// PERF(port):' needs its module to end with a 'PORT STATUS' trailer "
                        "naming at least one vendored 'source:' path, to be well formed (R15) -- "
                        "a file with no trailer (e.g. under crates/*/tests/ or fuzz_targets/) "
                        "can never satisfy this; move the marker into the ported module it "
                        "describes",
                    ))
                    continue
                reason = extract_reason(lines, idx)
                if not reason:
                    result.findings.append(Finding(
                        module_relpath, idx + 1, "perf-marker-empty-reason",
                        "'// PERF(port):' has no reason text after the colon, to be well "
                        "formed (R15)",
                    ))
                    continue
                result.perf_rows.append(PerfRow(module_relpath, source_cell, idx + 1, reason))

        fidelity_idxs = fidelity_marker_indices(text)
        if fidelity_idxs:
            result.fidelity_counts[module_relpath] = (
                result.fidelity_counts.get(module_relpath, 0) + len(fidelity_idxs)
            )
            for idx in fidelity_idxs:
                # `fidelity_marker_indices` is a raw per-line substring match (deliberately, so
                # its *count* can never disagree with audit-order's own) and can match a line
                # `classify_lines`' structural view does not consider a comment at all -- prose
                # inside a `/* ... */` block, or text inside a string literal. Well-formedness is
                # judged on that structural view instead, so such a line is neither on-its-own
                # comment nor a trailing comment after code: it is not a real marker position at
                # all, and is silently not a candidate for either finding (still counted above,
                # for parity with what audit-order would turn into a divergences.md row).
                info = lines[idx] if idx < len(lines) else None
                if info is None:
                    continue
                if info.is_pure_comment:
                    reason = extract_reason(lines, idx)
                    if not reason:
                        result.findings.append(Finding(
                            module_relpath, idx + 1, "fidelity-marker-empty-reason",
                            "'// FIDELITY(port):' has no reason text after the colon, to be "
                            "well formed (R18)",
                        ))
                    continue
                if info.comment:
                    result.findings.append(Finding(
                        module_relpath, idx + 1, "fidelity-marker-not-on-own-line",
                        "'// FIDELITY(port):' must be on its own comment line, not trailing "
                        "after code, to be well formed (R18)",
                    ))
    return result


def build_perf_backlog_rows(tree: Path) -> list[PerfRow]:
    """Every well-formed `// PERF(port):` marker's row, sorted deterministically so two
    regenerations of `port/reports/perf-backlog.md` are byte-identical. Imported by
    `port/regenerate`."""
    rows = scan_markers(tree).perf_rows
    return sorted(rows, key=lambda r: (r.module, r.source, r.line, r.reason))


PERF_BACKLOG_HEADER = ["module", "source", "line", "reason"]


def render_perf_backlog(rows: list[PerfRow]) -> str:
    """`port/reports/perf-backlog.md`'s full text for `rows` (already sorted by the caller --
    see `build_perf_backlog_rows`). Imported by `port/regenerate`."""
    lines = [
        "| " + " | ".join(PERF_BACKLOG_HEADER) + " |",
        "| " + " | ".join(["---"] * len(PERF_BACKLOG_HEADER)) + " |",
    ]
    for row in rows:
        cells = [row.module, row.source, str(row.line), row.reason]
        lines.append("| " + " | ".join(escape_cell(c) for c in cells) + " |")
    return "\n".join(lines) + "\n"


def _split_table_row(line: str) -> list[str]:
    """Split one Markdown table row into its cells, honouring `escape_cell`'s `\\|` escape (a
    naive `str.split("|")` would also break on an escaped pipe inside a cell's own text)."""
    inner = line.strip()
    if inner.startswith("|"):
        inner = inner[1:]
    if inner.endswith("|"):
        inner = inner[:-1]
    cells: list[str] = []
    current: list[str] = []
    i, n = 0, len(inner)
    while i < n:
        c = inner[i]
        if c == "\\" and i + 1 < n and inner[i + 1] == "|":
            current.append("|")
            i += 2
            continue
        if c == "|":
            cells.append("".join(current).strip())
            current = []
            i += 1
            continue
        current.append(c)
        i += 1
    cells.append("".join(current).strip())
    return cells


def parse_md_table(path: Path) -> list[list[str]]:
    """The first Markdown pipe-table in `path` (its header and `---` separator row excluded),
    each cell un-escaped the way `escape_cell` escaped it. A `divergences.md`-shaped file's
    second table (its '## Sources' summary) is never reached: a blank line ends the first table
    before it. Returns `[]` if `path` does not exist -- a report that has never been regenerated
    yet contributes nothing to compare against, the same 'absent source is not a failure' rule
    this codebase already applies to port/reports/oracle-parity.tsv and determinism.tsv."""
    if not path.is_file():
        return []
    table_lines: list[str] = []
    started = False
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("|"):
            table_lines.append(line)
            started = True
        elif started:
            break
    return [_split_table_row(line) for line in table_lines[2:]]


def read_committed_perf_rows(tree: Path) -> list[PerfRow]:
    """The committed `port/reports/perf-backlog.md`'s rows, as `PerfRow`s, for the per-marker
    assertion to compare against the live tree."""
    rows = []
    for cells in parse_md_table(tree / "port" / "reports" / "perf-backlog.md"):
        if len(cells) < 4:
            continue
        try:
            line = int(cells[2])
        except ValueError:
            line = 0
        rows.append(PerfRow(cells[0], cells[1], line, cells[3]))
    return rows


def read_committed_fidelity_places(tree: Path) -> list[tuple[str, int]]:
    """Every `(file, line)` the committed `port/reports/divergences.md` names in a row whose
    first cell is exactly `fidelity-marker` -- never a row from one of the other three sources
    (`order-audit`, `oracle-parity`, `determinism`), which carry no marker in the tree by design
    and must never be checked against one, and never the '## Sources' summary table, whose first
    cell is prefixed `source: ` for exactly this reason (port/audit-order's own comment names
    this task as the reason)."""
    out: list[tuple[str, int]] = []
    for cells in parse_md_table(tree / "port" / "reports" / "divergences.md"):
        if len(cells) < 2 or cells[0] != "fidelity-marker":
            continue
        place = cells[1]
        if ":" not in place:
            continue
        file_part, _, line_part = place.rpartition(":")
        try:
            line = int(line_part)
        except ValueError:
            line = 0
        out.append((file_part, line))
    return out


def check_perf_fidelity(tree: Path, result: ScanResult) -> None:
    """Task 23-perf-backlog's per-marker assertion, run unconditionally (not gated behind
    `--per-commit`: every check in this script already runs in both modes -- see `main`'s own
    `--per-commit` help text). Adds every malformed-marker finding `scan_markers` found, then
    fails:

    - a `port/reports/perf-backlog.md` row whose `(module, source, reason)` is named by more
      committed rows than there are live `// PERF(port):` markers sharing that same
      `(module, source, reason)` -- a multiset comparison (`collections.Counter`), not mere
      presence, so two markers that happen to share one reason can still have one of them
      deleted and be caught; deliberately *not* keyed on `line` either way, so a port task that
      inserts code above an existing marker does not go red over a report it is forbidden to
      touch (R15);
    - a file for which `port/reports/divergences.md` names more `fidelity-marker` rows than the
      file currently carries live `// FIDELITY(port):` markers -- keyed on the file, not on any
      one row's line, for the same reason; a file with at least as many live markers as rows
      passes even when a marker moved or a new one was added.

    Never regenerates a report and never diffs one as a whole file -- see the module docstring's
    "What this task must not do" (R15); this function only reads `tree`."""
    scan = scan_markers(tree)
    result.findings.extend(scan.findings)

    live_perf_key_counts: Counter[tuple[str, str, str]] = Counter(
        (r.module, r.source, r.reason) for r in scan.perf_rows
    )
    seen_perf_key_counts: Counter[tuple[str, str, str]] = Counter()
    for row in read_committed_perf_rows(tree):
        key = (row.module, row.source, row.reason)
        seen_perf_key_counts[key] += 1
        if seen_perf_key_counts[key] > live_perf_key_counts[key]:
            result.fail(
                row.module,
                row.line,
                "perf-report-row-stale",
                f"port/reports/perf-backlog.md names a '// PERF(port):' marker "
                f"(source={row.source!r}, reason={row.reason!r}) that is no longer in the tree, "
                "or whose text changed",
            )

    committed_fidelity = read_committed_fidelity_places(tree)
    needed: dict[str, int] = {}
    anchor: dict[str, int] = {}
    for file_part, line in committed_fidelity:
        needed[file_part] = needed.get(file_part, 0) + 1
        anchor.setdefault(file_part, line)
    for file_part, count in needed.items():
        live = scan.fidelity_counts.get(file_part, 0)
        if live < count:
            result.fail(
                file_part,
                anchor[file_part],
                "divergences-fidelity-row-stale",
                f"port/reports/divergences.md names {count} 'fidelity-marker' row(s) for "
                f"{file_part} but only {live} '// FIDELITY(port):' marker(s) remain in the tree",
            )


# --------------------------------------------------------------------------------------------
# One module's full check
# --------------------------------------------------------------------------------------------


def check_module(
    module_relpath: str,
    manifest_by_path: dict[str, dict[str, str]],
    result: ScanResult,
    text: str,
) -> None:
    result.modules_scanned += 1
    lines = classify_lines(text)
    check_trailer(module_relpath, lines, manifest_by_path, module_relpath, result)
    check_safety(module_relpath, lines, result)
    check_numeric_constants(module_relpath, lines, result)
    check_marker_whitelist(module_relpath, lines, result)


def scan_tree(tree: Path) -> ScanResult:
    result = ScanResult()
    manifest_path = tree / "port" / "manifest.tsv"
    manifest_rows = load_manifest(manifest_path)
    manifest_by_path = index_manifest(manifest_rows)
    target_modules = index_target_modules(manifest_rows)
    crates_root = tree / "crates"
    if crates_root.is_dir():
        for module_path in sorted(crates_root.glob("*/src/**/*.rs")):
            try:
                text = module_path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            module_relpath = module_path.relative_to(tree).as_posix()
            # A "ported module" (R14) is one named by a manifest row's "target module" column
            # -- spec.md's population, "every Rust module that ports a libslic3r file" -- union
            # a trailer-or-marker sniff, so a module that started a port before its manifest row
            # existed (or a fixture tree with no manifest of its own) is still caught. This
            # excludes an unrelated hand-written tool crate such as oracle-compare for a
            # principled reason (named by no manifest row, and confirmed to carry none of the
            # six markers) rather than by a text sniff alone, and -- unlike a marker-or-trailer
            # sniff on its own -- a real ported module cannot opt out of being scanned by having
            # its trailer and every marker deleted, since its manifest row still names it.
            is_ported_module = module_relpath in target_modules or (
                TRAILER_HEADER.removeprefix("// ") in text
                or any(f"{prefix}:" in text for prefix in MARKER_WHITELIST)
            )
            if not is_ported_module:
                continue
            check_module(module_relpath, manifest_by_path, result, text=text)
    check_perf_fidelity(tree, result)
    return result


def check_pin() -> str | None:
    """Return an error message if vendor/OrcaSlicer is not pinned at EXPECTED_PIN, else
    None. Always runs against the real repository's checkout, never `--tree`."""
    try:
        proc = subprocess.run(
            ["git", "-C", str(VENDOR_ROOT), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        return f"could not run git -C {VENDOR_ROOT} rev-parse HEAD: {exc}"
    if proc.returncode != 0:
        return f"git -C {VENDOR_ROOT} rev-parse HEAD failed: {proc.stderr.strip()}"
    head = proc.stdout.strip()
    if head != EXPECTED_PIN:
        return (
            f"vendor/OrcaSlicer is at {head!r}, not the pinned {EXPECTED_PIN!r}; R14's promise "
            "is that a source path exists at the pin"
        )
    return None


