# A candidate marker, exactly as task 21-port-status-markers states it: a line comment whose
# text begins with an all-capitals word (one or more, separated by a space or a hyphen),
# optionally followed by "(port)", then a colon. This is deliberately narrower than "starts with
# a capital letter" -- an ordinary prose comment such as "// Returns: the squared distance..."
# or "// A GFM table separator row:" has a lower-case tail and is not a candidate at all, so it
# is never examined by the whitelist and never a finding.
STRICT_CANDIDATE_MARKER_RE = re.compile(
    r"^(?P<prefix>[A-Z][A-Z0-9_]*(?:[ -][A-Z][A-Z0-9_]*)*)(?P<port>\(port\))?:"
)

# A near miss of one of the six markers that the strict, all-capitals regex above does not
# catch because its case differs (e.g. "Todo(port):") or its separator differs (e.g.
# "PORT-SRC:" -- though that one is already caught by the strict regex since a hyphen is an
# accepted separator between all-caps words). Matched case-insensitively against the same
# shape, then normalised (upper-cased, hyphen folded to space) and compared against the six
# marker spellings: a match here that the strict regex missed is a finding; a miss here is
# ordinary prose and never flagged, so this does not reintroduce the prose false positives the
# old broadened regex caused.
GENERIC_CANDIDATE_RE = re.compile(
    r"^(?P<prefix>[A-Za-z][A-Za-z0-9_]*(?:[ -][A-Za-z][A-Za-z0-9_]*)*)(?P<port>\(port\))?:",
    re.IGNORECASE,
)

MARKER_WHITELIST_UPPER = {name.upper() for name in MARKER_WHITELIST}

# task 23-perf-backlog: the two marker kinds a generated report is built from.
