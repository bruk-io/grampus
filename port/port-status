def check_document_sections(
    tree: Path, result: ScanResult
) -> list[tuple[str, int, int]]:
    """R29: fail, naming the exact missing heading text, unless `docs/PORTING.md` and
    `docs/WORKFLOW.md` (resolved under `tree`, so `--tree` and `--self-test` can exercise a
    fixture copy without touching the real documents) each carry every heading
    `DOCUMENT_SECTION_SPEC` lists, matched as a whole trimmed line -- reading headings, not
    prose quality.

    Returns `[(doc_relpath, required_count, present_count), ...]` so `main` can print, per R12
    and R13's own recorded proof ("exits 0 **and prints that** docs/PORTING.md holds the crate
    map, type map, …"), that the document was actually read and found to hold its sections --
    not just that the check happened to add no finding this run."""
    summary: list[tuple[str, int, int]] = []
    for doc_relpath, headings in DOCUMENT_SECTION_SPEC:
        doc_path = tree / doc_relpath
        if not doc_path.is_file():
            result.fail(
                doc_relpath,
                1,
                "missing-document-section",
                f"{doc_relpath} does not exist, so it carries none of its required headings",
            )
            summary.append((doc_relpath, len(headings), 0))
            continue
        present = {
            line.strip()
            for line in doc_path.read_text(encoding="utf-8", errors="replace").splitlines()
        }
        present_count = 0
        for heading in headings:
            if heading in present:
                present_count += 1
            else:
                result.fail(
                    doc_relpath,
                    1,
                    "missing-document-section",
                    f"{doc_relpath} is missing the required heading {heading!r}",
                )
        summary.append((doc_relpath, len(headings), present_count))
    return summary


