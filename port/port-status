@click.command(context_settings={"max_content_width": 100}, help=FULL_HELP)
@click.option(
    "--tree",
    type=click.Path(file_okay=False, path_type=Path),
    default=None,
    help="Directory to scan crates/*/src/**/*.rs and port/manifest.tsv under. Defaults to the "
    "repository root. vendor/OrcaSlicer/ is always resolved from the real repository root, "
    "never from --tree.",
)
@click.option(
    "--per-commit",
    is_flag=True,
    help="Run the subset of checks a port task's branch passes: every per-module and "
    "per-marker check above, the required-fuzz-target check and the two document-section "
    "checks. Passes while a row's derived status is 'not-started' or 'drafted'. Still prints "
    "the burn-down, the remaining-row count and the 'unknown' ownership count, but does not "
    "fail on them -- only the no-argument (default) mode, the completion gate, does.",
)
@click.option("--self-test", "self_test", is_flag=True, help="Run every fixture under port/tests/port-status/ and assert its expected result.")
@click.option(
    "--pr-body",
    "pr_body",
    type=click.Path(path_type=Path, dir_okay=False),
    default=None,
    help="Check a pull request body file for R28 (see --help's own --pr-body section). Takes "
    "no --tree: always reads the real repository's crates/, port/manifest.tsv and git history.",
)
@click.option(
    "--base",
    "base_ref",
    default="origin/main",
    show_default=True,
    help="The ref --pr-body diffs HEAD against to decide whether a module was added. Ignored "
    "without --pr-body.",
)
def main(
    tree: Path | None,
    per_commit: bool,
    self_test: bool,
    pr_body: Path | None,
    base_ref: str,
) -> None:
    if pr_body is not None:
        conflicting = [
            flag
            for flag, given in (("--tree", tree is not None), ("--per-commit", per_commit), ("--self-test", self_test))
            if given
        ]
        if conflicting:
            click.echo(
                "error: --pr-body takes no " + ", ".join(conflicting) + " -- it always reads "
                "the real repository's crates/, port/manifest.tsv and git history, never "
                "--tree, and runs no other mode in the same invocation",
                err=True,
            )
            sys.exit(1)
        sys.exit(run_pr_body_check(pr_body, base_ref))

    pin_error = check_pin()
    if pin_error:
        click.echo(f"error: {pin_error}", err=True)
        sys.exit(1)

    if self_test:
        sys.exit(run_selftest())

    tree_root = tree.resolve() if tree is not None else REPO_ROOT
    manifest_error = check_manifest_shape(tree_root)
    if manifest_error:
        click.echo(f"error: {manifest_error}", err=True)
        sys.exit(1)

    result, gate, doc_summary = full_check(tree_root)

    for finding in result.findings:
        click.echo(finding.render())

    mode = "per-commit" if per_commit else "default"
    counts = ", ".join(f"{name}={count}" for name, count in sorted(result.marker_counts.items()))
    click.echo(
        f"port-status ({mode}): {result.modules_scanned} module(s) scanned, "
        f"{len(result.findings)} finding(s); marker counts: {counts}"
    )
    for doc_relpath, required_count, present_count in doc_summary:
        if present_count == required_count:
            click.echo(
                f"port-status ({mode}): {doc_relpath} holds all {required_count} required "
                "sections"
            )
        else:
            click.echo(
                f"port-status ({mode}): {doc_relpath} holds {present_count} of "
                f"{required_count} required sections"
            )
    click.echo(
        f"port-status ({mode}): burn-down: todo!()={gate.todo_count}, "
        f"unimplemented!()={gate.unimplemented_count}, "
        f"modules gated out of the build={gate.gated_out_count}"
    )
    click.echo(f"port-status ({mode}): {format_remaining_line(gate)}")
    blank_count, total_ownership_rows = count_unclassified_ownership_rows(tree_root)
    click.echo(
        f"port-status ({mode}): {gate.unknown_ownership_count} unknown row(s) and "
        f"{blank_count} unclassified row(s) of {total_ownership_rows} in port/ownership.tsv"
    )
    click.echo(
        f"port-status ({mode}): a row's status above judges whether its proof is present, "
        "never its outcome -- cargo test --workspace is what actually runs a proof and reports "
        "whether it passes"
    )

    failed = compute_exit_failed(result, gate, per_commit)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
