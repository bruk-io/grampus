    """The count of `port/ownership.tsv` rows whose `class` column is literally `unknown` --
    printed, and never failed on, in both modes (R30, task.md). Task `16-ownership-spike`'s
    `VALID_CLASSES` treats an empty `class` cell as a distinct, deliberate state (not yet
    classified) from the explicit `unknown`, so this count can read 0 while every row is still
    unclassified; `count_unclassified_ownership_rows` prints that blank count alongside it so
    the never-failing metric is not mistaken for "nothing left to classify"."""
    path = tree / "port" / "ownership.tsv"
    if not path.is_file():
        return 0
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines:
        return 0
    header = lines[0].split("\t")
    try:
        idx = header.index("class")
    except ValueError:
        return 0
    count = 0
    for line in lines[1:]:
        if not line:
            continue
        cells = line.split("\t")
        if idx < len(cells) and cells[idx].strip() == "unknown":
            count += 1
    return count


def count_unclassified_ownership_rows(tree: Path) -> tuple[int, int]:
    """`(blank_count, total_count)` over `port/ownership.tsv`'s `class` column: the count of
    rows whose cell is empty (not yet classified at all, distinct from the explicit `unknown`
    `count_unknown_ownership_rows` counts) and the total row count. Printed alongside the
    `unknown` count so a reader is not left to conclude 208 raw-pointer fields are classified
    when none are; task `51-ownership-blank-class-gate` owns gating on this, not this task."""
    path = tree / "port" / "ownership.tsv"
    if not path.is_file():
        return 0, 0
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines:
        return 0, 0
    header = lines[0].split("\t")
    try:
        idx = header.index("class")
    except ValueError:
        return 0, 0
    blank = 0
    total = 0
    for line in lines[1:]:
        if not line:
            continue
        total += 1
        cells = line.split("\t")
        if idx >= len(cells) or cells[idx].strip() == "":
            blank += 1
    return blank, total


@dataclass
class GateResult:
    """The burn-down and gate counts (R16, R26, R30), computed once per run and printed in both
    modes; only the no-argument mode fails on them (task.md)."""

    todo_count: int = 0
    unimplemented_count: int = 0
    gated_out_count: int = 0
    remaining_count: int = 0
    unknown_ownership_count: int = 0

    @property
    def burn_down_total(self) -> int:
        return self.todo_count + self.unimplemented_count + self.gated_out_count

    def failed(self) -> bool:
        return bool(self.burn_down_total or self.remaining_count)


def carries_port_status_trailer(text: str) -> bool:
    """True if `text` has a line reading exactly `// PORT STATUS` -- the burn-down's own
    "gated out of the build" test (task.md: "a file under `crates/*/src/` that carries a `PORT
    STATUS` trailer and that no `mod` declaration reaches"), which names no particular row (a
    file gated out is counted whether or not it still matches a manifest row at all)."""
    return any(line.strip() == TRAILER_HEADER for line in text.splitlines())


def compute_gate(
    tree: Path, manifest_rows: list[dict[str, str]], mod_reachable: frozenset[Path]
) -> GateResult:
    gate = GateResult()
    crates_root = tree / "crates"
    if crates_root.is_dir():
        for rs_path in sorted(crates_root.glob("*/src/**/*.rs")):
            try:
                text = rs_path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            code_only = "\n".join(li.code for li in classify_lines(text))
            gate.todo_count += len(TODO_RE.findall(code_only))
            gate.unimplemented_count += len(UNIMPLEMENTED_RE.findall(code_only))
            if rs_path not in mod_reachable and carries_port_status_trailer(text):
                gate.gated_out_count += 1
    in_scope_rows = [r for r in manifest_rows if is_in_scope(r)]
    gate.remaining_count = sum(
        1 for r in in_scope_rows if derive_row_status(r, tree, mod_reachable) != "ported"
    )
    gate.unknown_ownership_count = count_unknown_ownership_rows(tree)
    return gate


def full_check(tree: Path) -> tuple[ScanResult, GateResult, list[tuple[str, int, int]]]:
    """This task's own seam: `scan_tree` (task 21's and task 23's per-module and per-marker
    checks, untouched) plus the required-fuzz-target check and the two document-section checks
    -- all four always active, in both modes (task.md's `--per-commit` subset) -- plus the gate
    counts, which only the no-argument mode fails on. Kept apart from `scan_tree` itself so
    `run_selftest`'s existing fixture loop (task 21, task 23) keeps exercising `scan_tree` alone,
    unchanged, over fixture trees that carry no `docs/` directory of their own.

    Returns `(result, gate, doc_summary)`; `doc_summary` is `check_document_sections`'s own
    return value, carried through so `main` can print, per R12/R13's own recorded proof, that
    each document was read and found to hold its sections -- not just that no finding came
    back this run."""
    result = scan_tree(tree)
    manifest_rows = load_manifest(tree / "port" / "manifest.tsv")
    mod_reachable = compute_mod_reachable_files(tree / "crates")
    check_fuzz_targets(tree, manifest_rows, mod_reachable, result)
    doc_summary = check_document_sections(tree, result)
    gate = compute_gate(tree, manifest_rows, mod_reachable)
    return result, gate, doc_summary


def format_remaining_line(gate: GateResult) -> str:
    """R26's exact remaining-rows wording (Done-when: "on a tree with no in-scope rows
    remaining ... prints `0 in-scope rows remaining`, and on a tree with rows remaining it
    prints that count in the same wording"). Factored out of `main` so the self-test can assert
    this literal string through the same function `main` prints with, not a re-typed copy of
    it."""
    return (
        "0 in-scope rows remaining"
        if gate.remaining_count == 0
        else f"{gate.remaining_count} in-scope rows remaining"
    )


def compute_exit_failed(result: ScanResult, gate: GateResult, per_commit: bool) -> bool:
    """The exact verdict `main` exits on: any finding fails either mode; the gate (the burn-down
    at zero and every in-scope row `ported`) fails only the bare (default) mode. Factored out of
    `main` so the self-test calls the very function that decides the exit code, rather than
    re-implementing its condition and only checking `result.findings`/`gate.failed()`
    separately."""
    return bool(result.findings) or (not per_commit and gate.failed())


def classify_comment_marker(text: str) -> tuple[str, str] | None:
    """Classify `text` (a comment's content with the leading `//` stripped and whitespace
    trimmed) as a port marker. Returns (status, prefix) where status is "recognized" (one of
    the six, counted) or "unrecognized" (a candidate or a near miss of one of the six, a
    finding); returns None for ordinary prose that is neither.

    The two passes are tried in order, never both, so a single comment is never reported twice:
    the strict all-capitals shape task.md states, then -- only when that shape does not match at
    all -- a case-insensitive near-miss test against the six exact spellings only."""
    strict_m = STRICT_CANDIDATE_MARKER_RE.match(text)
    if strict_m:
        prefix = strict_m.group("prefix") + ("(port)" if strict_m.group("port") else "")
        return ("recognized" if prefix in MARKER_WHITELIST else "unrecognized", prefix)
    generic_m = GENERIC_CANDIDATE_RE.match(text)
    if generic_m:
        prefix_raw = generic_m.group("prefix")
        port_raw = generic_m.group("port") or ""
        normalized = prefix_raw.upper().replace("-", " ") + ("(PORT)" if port_raw else "")
        if normalized in MARKER_WHITELIST_UPPER:
            return ("unrecognized", prefix_raw + port_raw)
    return None

# PORT SRC: <vendored path>:<line>
PORT_SRC_RE = re.compile(r"PORT SRC:\s*(?P<path>\S+):(?P<line>\d+)")

TRAILER_HEADER = "// PORT STATUS"
TRAILER_KEY_RE = re.compile(r"^//\s*(?P<key>source|confidence|tier|oracle):\s*(?P<value>.*)$")
# The order the trailer's non-'source:' keys must appear in, after any 'source:' lines.
TRAILER_KEY_ORDER = ("confidence", "tier", "oracle")

UNSAFE_WORD_RE = re.compile(r"\bunsafe\b")
SAFETY_MARKER_RE = re.compile(r"^SAFETY:")

CFG_TEST_RE = re.compile(r"^#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]\s*$")

# Integer literals, exact-value suffix excluded: hex/octal/binary, float (with a decimal point
# and an optional exponent), exponent-only (e.g. 1e-4), then plain decimal -- tried in that
# order so a trailing "e..." or "." is consumed by the more specific alternative first. Digit
# separators (`_`) and a type suffix are captured separately so normalisation (below) can strip
# them without a second pass over the string.
NUMERIC_LITERAL_RE = re.compile(
    r"(?<![\w.])"
    r"(?P<num>"
    r"0[xX][0-9a-fA-F_]+"
    r"|0[oO][0-7_]+"
    r"|0[bB][01_]+"
    r"|\d[\d_]*\.(?:\d[\d_]*)?(?:[eE][+-]?\d[\d_]*)?"
    r"|\d[\d_]*[eE][+-]?\d[\d_]*"
    r"|\d[\d_]*"
    r")"
    r"(?P<suffix>u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)?"
    r"(?![\w.])"
)

EXEMPT_LITERAL_VALUES = {"0", "1", "2"}


