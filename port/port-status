def _check_manifest_shape_guard() -> list[str]:
    """`check_manifest_shape`, checked directly against the two broken shapes a reviewer found
    (22-port-status-gates): a tree with no `port/manifest.tsv` at all, and one whose header is
    missing a column the derivation reads -- the guard that stops R26's completion gate from
    failing open (reading a missing or mis-headed manifest's zero in-scope rows as the port
    being complete), and the two shapes it must NOT flag: a real, well-formed manifest, and a
    header-only one (zero rows), which `doc-sections-complete`'s own committed fixture already
    relies on passing clean."""
    failures: list[str] = []
    with tempfile.TemporaryDirectory() as tmp:
        error = check_manifest_shape(Path(tmp))
        if error is None or "does not exist" not in error:
            failures.append(
                f"missing-manifest: expected an error naming the file as missing, got {error!r}"
            )

    with tempfile.TemporaryDirectory() as tmp:
        tmp_path = Path(tmp)
        (tmp_path / "port").mkdir()
        (tmp_path / "port" / "manifest.tsv").write_text(
            "path\ttarget crate\ttarget module\tscope\tequality tier\tproof path\tfuzz target\n",
            encoding="utf-8",
        )
        error = check_manifest_shape(tmp_path)
        if error is None or "missing column" not in error:
            failures.append(
                "renamed-header-column: expected an error naming the missing column, got "
                f"{error!r}"
            )

    ok_error = check_manifest_shape(FIXTURES_ROOT / "status-and-gate")
    if ok_error is not None:
        failures.append(
            f"status-and-gate fixture: expected check_manifest_shape to return None, got "
            f"{ok_error!r}"
        )

    ok_error = check_manifest_shape(FIXTURES_ROOT / "doc-sections-complete")
    if ok_error is not None:
        failures.append(
            "doc-sections-complete fixture (header-only, zero in-scope rows by design): "
            f"expected check_manifest_shape to return None, got {ok_error!r}"
        )

    return failures


def _check_status_derivation() -> list[str]:
    """`derive_row_status`, checked directly against every row of the
    `status-and-gate` fixture (22-port-status-gates): a direct, runnable proof of the status
    rule itself, field by field, rather than only through the gate's pass/fail exit code."""
    tree = FIXTURES_ROOT / "status-and-gate"
    rows = load_manifest(tree / "port" / "manifest.tsv")
    mod_reachable = compute_mod_reachable_files(tree / "crates")
    expected = {
        "crates/slic3r-status/src/drafted_mod.rs": "drafted",
        "crates/slic3r-status/src/not_started_mod.rs": "not-started",
        "crates/slic3r-status/src/no_proof_mod.rs": "drafted",
        "crates/slic3r-status/src/ported_mod.rs": "ported",
        "crates/slic3r-status/src/ported_with_fuzz.rs": "ported",
        "crates/slic3r-status/src/outscope_mod.rs": "not-started",
        # A `mod` declaration reaches this one too (lib.rs), but it still holds a live
        # `todo!()`: must derive "not-started", not "drafted" (the strict reading of task.md's
        # bullet, matching port/inventory -- see derive_row_status's own docstring).
        "crates/slic3r-status/src/mod_reached_todo_mod.rs": "not-started",
    }
    # Guards against this check silently passing over an empty or renamed fixture (the same
    # shape of guard `_check_perf_row_shape` already uses for its own fixture): a loop that
    # never runs its body is indistinguishable from one that ran and found no disagreement.
    if len(rows) != len(expected):
        return [
            f"status-and-gate fixture: expected exactly {len(expected)} manifest row(s), "
            f"got {len(rows)}: {[r.get('target module') for r in rows]!r}"
        ]
    seen = {row["target module"] for row in rows}
    if seen != set(expected):
        return [
            f"status-and-gate fixture: expected rows for {sorted(expected)!r}, got "
            f"{sorted(seen)!r}"
        ]
    failures = []
    for row in rows:
        target = row["target module"]
        want = expected[target]
        got = derive_row_status(row, tree, mod_reachable)
        if got != want:
            failures.append(f"{target}: expected status {want!r}, got {got!r}")
    out_of_scope = [r for r in rows if r["target module"].endswith("outscope_mod.rs")]
    if out_of_scope and is_in_scope(out_of_scope[0]):
        failures.append("outscope_mod.rs's row is 'out:' but is_in_scope reported True")
    return failures


