def _check_candidate_marker_regex() -> list[str]:
    """The nine accept/reject cases the marker whitelist is built to get right, checked
    directly against the regex and the whitelist set rather than only through a fixture file.
    Returns a list of failure descriptions (empty if all nine behave as required)."""
    cases = [
        ("TODO(port):", True),
        ("PERF(port):", True),
        ("PORT NOTE:", True),
        ("SAFETY:", True),
        ("PORT SRC:", True),
        ("FIDELITY(port):", True),
        ("TODO:", False),
        ("Todo(port):", False),
        ("PORT-SRC:", False),
    ]
    failures = []
    for text, expect_accept in cases:
        classified = classify_comment_marker(text)
        accepted = classified is not None and classified[0] == "recognized"
        if accepted != expect_accept:
            failures.append(f"'// {text}' expected accept={expect_accept}, got accept={accepted}")
    return failures


def _check_perf_row_shape() -> list[str]:
    """`build_perf_backlog_rows` over the `pass` fixture, checked field by field against what
    `port/tests/port-status/pass/.../circle.rs`'s own `// PERF(port):` marker and `PORT STATUS`
    trailer actually hold -- a direct, runnable proof of the row shape Done-when 2 states (module,
    vendored source path, marker line, reason), not merely the absence of findings."""
    rows = build_perf_backlog_rows(FIXTURES_ROOT / "pass")
    if len(rows) != 1:
        return [f"expected exactly 1 PERF(port) row from the 'pass' fixture, got {rows!r}"]
    row = rows[0]
    expected = PerfRow(
        module="crates/slic3r-circle/src/circle.rs",
        source="src/libslic3r/Geometry/Circle.cpp; src/libslic3r/Geometry/Circle.hpp",
        line=37,
        reason=(
            "the oracle walks this list twice; a single pass would do, left as-is to stay "
            "byte-for-byte with Circle.cpp's own traversal order."
        ),
    )
    failures = []
    for field_name in ("module", "source", "line", "reason"):
        got, want = getattr(row, field_name), getattr(expected, field_name)
        if got != want:
            failures.append(f"row.{field_name}: expected {want!r}, got {got!r}")
    rendered = render_perf_backlog(rows)
    if "| module | source | line | reason |" not in rendered:
        failures.append(f"render_perf_backlog did not emit the expected header; got: {rendered!r}")
    return failures


def _check_perf_reason_excludes_doc_comment() -> list[str]:
