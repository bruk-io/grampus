# A `mod name;` declaration (file-per-module or mod.rs per directory), read the same way
# port/inventory's own `compute_mod_reachable_files` reads it (plan step 11's rule): both
# scripts compute mod-reachability the same way from the same tree, so the module-to-manifest
# direction (port/inventory) and the manifest-to-module direction (this script, R26) can never
# silently disagree about what "a mod declaration reaches it" means. Applied here to
# `classify_lines`' own code-only view (``li.code`` joined), not a separate comment stripper --
# one comment policy for both "does a mod line reach it" and "does todo!()/unimplemented!()
# remain", stated once, here.
MOD_DECL_RE = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+([A-Za-z_]\w*)\s*;", re.MULTILINE)
TODO_RE = re.compile(r"\btodo!\s*\(")
UNIMPLEMENTED_RE = re.compile(r"\bunimplemented!\s*\(")
TODO_OR_UNIMPLEMENTED_RE = re.compile(r"\btodo!\s*\(|\bunimplemented!\s*\(")

# The proof-presence convention this task fixes (task.md: "The proof-presence convention,
# fixed here"): a `#[test]` attribute on its own line, the test function it attaches to, and a
# `// PROOF: <proof path cell, verbatim>` line "beside" it -- in the contiguous `//` comment
# block directly above the `#[test]` attribute, on the attribute or fn-signature line itself
# (a trailing comment), or on the line directly inside the function's opening brace. Judgement
# call: "beside" is read generously (a small bounded window) rather than "the line
# immediately above `#[test]`" alone, because the six existing marker conventions in this file
# (`// SAFETY:`, `// PORT SRC:`) are already read from a *contiguous comment block* above their
# code, not just the one adjacent line -- see the pull request body for why this one window is
# chosen and not a narrower one.
TEST_ATTR_RE = re.compile(r"^\s*#\s*\[\s*test\s*\]\s*$")
PROOF_FN_DECL_RE = re.compile(r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+([A-Za-z_]\w*)")
PROOF_LINE_RE = re.compile(r"^\s*//\s*PROOF:\s*(?P<path>.*?)\s*$")

# The manifest's scope cell (task.md: "in scope or out with a reason") is "in", or "in: <reason>"
# -- never a bare prefix match against anything else, since the only other value this column
# takes is "out" / "out: <reason>" (port/inventory's own `compute_scope`).
def is_in_scope(row: dict[str, str]) -> bool:
    cell = row.get("in scope or out with a reason", "").strip()
    return cell.split(":", 1)[0].strip() == "in"


def has_port_status_trailer_naming(text: str, relpath: str) -> bool:
    """True if `text` carries a line containing the literal "PORT STATUS" with `relpath`
    (a manifest row's own vendored `path` cell, e.g. "Geometry/Circle.cpp") within a few lines
    of it -- the same loose, textual presence test `port/inventory`'s own
    `has_port_status_trailer` uses for the same purpose (the module-to-manifest direction), so
    the "drafted" half of status derivation reads a module's trailer exactly the way
    `port/inventory` already does. This is deliberately looser than `check_trailer`'s full
    grammar validation elsewhere in this file: a malformed trailer that still names the row is
    still "honestly a draft" (task.md), and `check_trailer`'s own finding is what tells a porter
    the trailer needs fixing, not status derivation."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if TRAILER_HEADER.removeprefix("// ") in line and relpath in "\n".join(
            lines[i : i + 8]
        ):
            return True
    return False


def compute_mod_reachable_files(crates_root: Path) -> frozenset[Path]:
    """Every `.rs` file under `crates_root` reachable from some crate's `src/lib.rs` by a chain
    of `mod name;` declarations (file-per-module, or `mod.rs` per directory) -- the same
    traversal `port/inventory`'s `compute_mod_reachable_files` runs, reimplemented here rather
    than imported (importing that script would also run its own CLI machinery, the same reason
    `escape_cell` is duplicated above). Comment policy: `mod` declarations are read from
    `classify_lines`' code-only view, the same view `derive_row_status` reads `todo!()` /
    `unimplemented!()` from, so a comment that merely mentions either cannot fool this script
    two different ways."""
    reachable: set[Path] = set()
    if not crates_root.is_dir():
        return frozenset()
    for crate_dir in sorted(p for p in crates_root.iterdir() if p.is_dir()):
        lib_rs = crate_dir / "src" / "lib.rs"
        if not lib_rs.is_file():
            continue
        stack = [lib_rs]
        seen = {lib_rs}
        while stack:
            f = stack.pop()
            reachable.add(f)
            try:
                text = f.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            resolve_dir = f.parent if f.name in ("lib.rs", "mod.rs") else f.parent / f.stem
            code_only = "\n".join(li.code for li in classify_lines(text))
            for name in MOD_DECL_RE.findall(code_only):
                for candidate in (resolve_dir / f"{name}.rs", resolve_dir / name / "mod.rs"):
                    if candidate.is_file() and candidate not in seen:
                        seen.add(candidate)
                        stack.append(candidate)
    return frozenset(reachable)


def extract_cfg_test_text(text: str) -> str:
    """The raw text of every `#[cfg(test)]` module body in `text`, found by the same brace
    counting `classify_lines` already does for the numeric-literal rule's own cfg(test)
    exemption (masking string/char literals first, so a brace written inside a string cannot
    move the depth) -- reimplemented here as a standalone extractor because `classify_lines`
    reports exemption per line, not the body's own text, and the proof convention needs the
    latter."""
    lines = text.splitlines()
    masked_lines = strip_block_comments(text).splitlines()
    out_lines: list[str] = []
    in_block = False
    depth = 0
    seen_open = False
    for raw, masked in zip(lines, masked_lines):
        stripped = raw.strip()
        if not in_block and CFG_TEST_RE.match(stripped):
            in_block = True
            depth = 0
            seen_open = False
            continue
        if in_block:
            code, _comment = split_code_comment(masked)
            masked_code = mask_strings(code)
            opens = masked_code.count("{")
            closes = masked_code.count("}")
            if opens:
                seen_open = True
            depth += opens - closes
            out_lines.append(raw)
            if seen_open and depth <= 0:
                in_block = False
    return "\n".join(out_lines)


def find_proof_match(text: str, module_snake: str, proof_path_cell: str) -> bool:
    """True if `text` carries a `#[test]`-attributed function whose name contains
    `module_snake` and which carries, beside it (see `PROOF_LINE_RE`'s own comment for the
    window), the literal line `// PROOF: <proof_path_cell>`."""
    if not proof_path_cell:
        return False
    wanted = proof_path_cell.strip()
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if not TEST_ATTR_RE.match(line):
            continue
        j = i + 1
        while j < len(lines) and (not lines[j].strip() or lines[j].strip().startswith("#[")):
            j += 1
        if j >= len(lines):
            continue
        m = PROOF_FN_DECL_RE.match(lines[j])
        if not m or module_snake not in m.group(1):
            continue
        window_start = i
        k = i - 1
        while k >= 0 and lines[k].strip().startswith("//"):
            window_start = k
            k -= 1
        window_end = min(j + 1, len(lines) - 1)
        for li in range(window_start, window_end + 1):
            pm = PROOF_LINE_RE.match(lines[li])
            if pm and pm.group("path") == wanted:
                return True
    return False


def proof_present(row: dict[str, str], target_path: Path, tree: Path) -> bool:
    """True if the row's declared `proof path` cell has a matching `// PROOF:` marker beside a
    test naming the module's snake_case name (its file stem), in a file under the row's target
    crate's `crates/<crate>/tests/`, or in a `#[cfg(test)]` module inside the module file
    itself (task.md's "proof-presence convention, fixed here"). An empty `proof path` cell can
    never be satisfied -- there is nothing for a `// PROOF:` marker to name verbatim.

    Matched against *this row's own* `proof path` cell, verbatim, as task.md states it -- never
    against a sibling row's. A `.cpp`/`.hpp` pair is two manifest rows sharing one target
    module, and where their `proof path` cells disagree (a measured ~56 of the committed
    manifest's 232 distinct in-scope target modules), the module needs a distinct `// PROOF:
    <n>` marker for each cell before every one of its rows derives `ported` -- one row's marker
    does not satisfy its sibling row's own cell. Noted here, not worked around, because task.md
    ties the marker to "the row's proof path cell", not to the module; a porter of such a module
    should expect to write more than one `// PROOF:` marker."""
    proof_path_cell = row.get("proof path", "").strip()
    if not proof_path_cell:
        return False
    crate = row.get("target crate", "").strip()
    module_snake = target_path.stem
    if crate:
        tests_dir = tree / "crates" / crate / "tests"
        if tests_dir.is_dir():
            for f in sorted(tests_dir.rglob("*.rs")):
                try:
                    text = f.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                if find_proof_match(text, module_snake, proof_path_cell):
                    return True
    try:
        module_text = target_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    cfg_test_text = extract_cfg_test_text(module_text)
    if cfg_test_text and find_proof_match(cfg_test_text, module_snake, proof_path_cell):
        return True
    return False


def derive_row_status(row: dict[str, str], tree: Path, mod_reachable: frozenset[Path]) -> str:
    """Derive one `port/manifest.tsv` row's status from the Rust tree alone (task.md's status
    rule), never reading the row's own `status` cell:

    - `ported` -- a `mod` declaration reaches the target file, it holds no `todo!()` and no
      `unimplemented!()`, and its proof is present (`proof_present`).
    - `drafted` -- a `mod` declaration reaches the target file but it is not `ported` because its
      proof is not yet present (Done-when's own tested case -- "a module with a `mod` line, no
      `todo!()` and no `unimplemented!()` but no `// PROOF:` marker ... derives as `drafted` and
      not as `ported`"); or no `mod` declaration reaches it, but it carries a `PORT STATUS`
      trailer naming this row's own vendored `path` (a Phase A draft, task.md's "honestly a
      draft"). Strictly task.md's bullet ("no `mod` declaration reaches it"), matching
      `port/inventory`'s own rule exactly: a `mod`-reached file that still holds a live
      `todo!()`/`unimplemented!()` is `not-started` below, not grouped in here.
    - `not-started` -- anything else, including no `target module` cell, no file there at all,
      or a `mod`-reached file that still holds a live `todo!()`/`unimplemented!()`.

    This computation is the authority R26's gate uses (task.md), which is not the same as
    `port/inventory`'s own status cell agreeing with it: `port/inventory` evaluates only the
    text-visible half of this same rule -- the target file present with a trailer naming the
    row, the `mod` line, and the absence of `todo!()`/`unimplemented!()` -- and hands the proof
    half to this script. So a module can read `ported` in `port/manifest.tsv`'s own `status`
    cell while this script derives `drafted` for it (the proof is not yet present); that cell is
    informational, and this derivation, not the cell, is what the gate and every check above
    read.
    """
    target_module_cell = row.get("target module", "").strip()
    if not target_module_cell:
        return "not-started"
    target_path = tree / target_module_cell
    if not target_path.is_file():
        return "not-started"
    text = target_path.read_text(encoding="utf-8", errors="replace")
    code_only = "\n".join(li.code for li in classify_lines(text))
    has_todo_or_unimpl = bool(TODO_OR_UNIMPLEMENTED_RE.search(code_only))
    reached = target_path in mod_reachable
    if reached:
        if has_todo_or_unimpl:
            return "not-started"
        if proof_present(row, target_path, tree):
            return "ported"
        return "drafted"
    source_cell = row.get("path", "").strip()
    if source_cell and has_port_status_trailer_naming(text, source_cell):
        return "drafted"
    return "not-started"


def required_fuzz_target_relpath(row: dict[str, str]) -> str:
    """`crates/slic3r-ffi/fuzz/fuzz_targets/<crate>_<module>.rs` -- the one exact path the
    required-fuzz-target check accepts (task.md: "that exact path, so a file naming the module
    at any other path does not satisfy the check")."""
    crate = row.get("target crate", "").strip()
    module_cell = row.get("target module", "").strip()
    stem = Path(module_cell).stem if module_cell else ""
    return f"crates/slic3r-ffi/fuzz/fuzz_targets/{crate}_{stem}.rs"


def check_fuzz_targets(
    tree: Path,
    manifest_rows: list[dict[str, str]],
    mod_reachable: frozenset[Path],
    result: ScanResult,
) -> None:
    """R19's second half: a row whose `fuzz target` is `required` and whose derived status is
    `ported` fails unless `required_fuzz_target_relpath` exists. Fires only at `ported` -- a
    `not-started` or `drafted` row is never failed by it, because a Phase A draft has no proof
    and no target yet (task.md).

    A `.cpp`/`.hpp` pair shares one target module across two manifest rows, so both rows derive
    the same `required_fuzz_target_relpath`; reported once per distinct path, not once per row,
    so a module missing its fuzz target is not double-counted."""
    reported: set[str] = set()
    for row in manifest_rows:
        if row.get("fuzz target", "").strip() != "required":
            continue
        if derive_row_status(row, tree, mod_reachable) != "ported":
            continue
        target_relpath = required_fuzz_target_relpath(row)
        if target_relpath in reported:
            continue
        if not (tree / target_relpath).is_file():
            reported.add(target_relpath)
            result.fail(
                row.get("target module", "") or row.get("path", ""),
                1,
                "missing-fuzz-target",
                f"this row's 'fuzz target' is 'required' and its derived status is 'ported', "
                f"but {target_relpath} does not exist",
            )


