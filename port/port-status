REPO_ROOT = Path(__file__).resolve().parent.parent
VENDOR_ROOT = REPO_ROOT / "vendor" / "OrcaSlicer"
EXPECTED_PIN = "f92a7c065c5718b8ef1baac1cd704df2911238f4"
VENDOR_SRC_PREFIX = "src/libslic3r/"

FIXTURES_ROOT = REPO_ROOT / "port" / "tests" / "port-status"

# The closed marker whitelist (R14), spelled exactly as the six markers appear in a comment,
# i.e. with the literal "(port)" suffix where the marker takes one.
MARKER_WHITELIST = {
    "TODO(port)",
    "PERF(port)",
    "PORT NOTE",
    "SAFETY",
    "PORT SRC",
    "FIDELITY(port)",
}

CONFIDENCE_VALUES = {"high", "medium", "low"}
ORACLE_VALUES = {"release", "built"}

# A candidate marker, exactly as task 21-port-status-markers states it: a line comment whose
# text begins with an all-capitals word (one or more, separated by a space or a hyphen),
# optionally followed by "(port)", then a colon. This is deliberately narrower than "starts with
# a capital letter" -- an ordinary prose comment such as "// Returns: the squared distance..."
# or "// A GFM table separator row:" has a lower-case tail and is not a candidate at all, so it
# is never examined by the whitelist and never a finding.
STRICT_CANDIDATE_MARKER_RE = re.compile(
    r"^(?P<prefix>[A-Z][A-Z0-9_]*(?:[ -][A-Z][A-Z0-9_]*)*)(?P<port>\(port\))?:"
)

# A near miss of one of the six markers that the strict, all-capitals regex above does not
# catch because its case differs (e.g. "Todo(port):") or its separator differs (e.g.
# "PORT-SRC:" -- though that one is already caught by the strict regex since a hyphen is an
# accepted separator between all-caps words). Matched case-insensitively against the same
# shape, then normalised (upper-cased, hyphen folded to space) and compared against the six
# marker spellings: a match here that the strict regex missed is a finding; a miss here is
# ordinary prose and never flagged, so this does not reintroduce the prose false positives the
# old broadened regex caused.
GENERIC_CANDIDATE_RE = re.compile(
    r"^(?P<prefix>[A-Za-z][A-Za-z0-9_]*(?:[ -][A-Za-z][A-Za-z0-9_]*)*)(?P<port>\(port\))?:",
    re.IGNORECASE,
)

MARKER_WHITELIST_UPPER = {name.upper() for name in MARKER_WHITELIST}

# task 23-perf-backlog: the two marker kinds a generated report is built from.
PERF_PREFIX = "PERF(port)"
FIDELITY_PREFIX = "FIDELITY(port)"


def classify_comment_marker(text: str) -> tuple[str, str] | None:
    """Classify `text` (a comment's content with the leading `//` stripped and whitespace
    trimmed) as a port marker. Returns (status, prefix) where status is "recognized" (one of
    the six, counted) or "unrecognized" (a candidate or a near miss of one of the six, a
    finding); returns None for ordinary prose that is neither.

    The two passes are tried in order, never both, so a single comment is never reported twice:
    the strict all-capitals shape task.md states, then -- only when that shape does not match at
    all -- a case-insensitive near-miss test against the six exact spellings only."""
    strict_m = STRICT_CANDIDATE_MARKER_RE.match(text)
    if strict_m:
        prefix = strict_m.group("prefix") + ("(port)" if strict_m.group("port") else "")
        return ("recognized" if prefix in MARKER_WHITELIST else "unrecognized", prefix)
    generic_m = GENERIC_CANDIDATE_RE.match(text)
    if generic_m:
        prefix_raw = generic_m.group("prefix")
        port_raw = generic_m.group("port") or ""
        normalized = prefix_raw.upper().replace("-", " ") + ("(PORT)" if port_raw else "")
        if normalized in MARKER_WHITELIST_UPPER:
            return ("unrecognized", prefix_raw + port_raw)
    return None

# PORT SRC: <vendored path>:<line>
PORT_SRC_RE = re.compile(r"PORT SRC:\s*(?P<path>\S+):(?P<line>\d+)")

TRAILER_HEADER = "// PORT STATUS"
TRAILER_KEY_RE = re.compile(r"^//\s*(?P<key>source|confidence|tier|oracle):\s*(?P<value>.*)$")
# The order the trailer's non-'source:' keys must appear in, after any 'source:' lines.
TRAILER_KEY_ORDER = ("confidence", "tier", "oracle")

UNSAFE_WORD_RE = re.compile(r"\bunsafe\b")
SAFETY_MARKER_RE = re.compile(r"^SAFETY:")

CFG_TEST_RE = re.compile(r"^#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]\s*$")

# Integer literals, exact-value suffix excluded: hex/octal/binary, float (with a decimal point
# and an optional exponent), exponent-only (e.g. 1e-4), then plain decimal -- tried in that
# order so a trailing "e..." or "." is consumed by the more specific alternative first. Digit
# separators (`_`) and a type suffix are captured separately so normalisation (below) can strip
# them without a second pass over the string.
NUMERIC_LITERAL_RE = re.compile(
    r"(?<![\w.])"
    r"(?P<num>"
    r"0[xX][0-9a-fA-F_]+"
    r"|0[oO][0-7_]+"
    r"|0[bB][01_]+"
    r"|\d[\d_]*\.(?:\d[\d_]*)?(?:[eE][+-]?\d[\d_]*)?"
    r"|\d[\d_]*[eE][+-]?\d[\d_]*"
    r"|\d[\d_]*"
    r")"
    r"(?P<suffix>u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)?"
    r"(?![\w.])"
)

EXEMPT_LITERAL_VALUES = {"0", "1", "2"}


