def _check_candidate_marker_regex() -> list[str]:
    """The nine accept/reject cases the marker whitelist is built to get right, checked
    directly against the regex and the whitelist set rather than only through a fixture file.
    Returns a list of failure descriptions (empty if all nine behave as required)."""
    cases = [
        ("TODO(port):", True),
        ("PERF(port):", True),
        ("PORT NOTE:", True),
        ("SAFETY:", True),
        ("PORT SRC:", True),
        ("FIDELITY(port):", True),
        ("TODO:", False),
        ("Todo(port):", False),
        ("PORT-SRC:", False),
    ]
    failures = []
    for text, expect_accept in cases:
        classified = classify_comment_marker(text)
        accepted = classified is not None and classified[0] == "recognized"
        if accepted != expect_accept:
            failures.append(f"'// {text}' expected accept={expect_accept}, got accept={accepted}")
    return failures


def _check_perf_row_shape() -> list[str]:
    """`build_perf_backlog_rows` over the `pass` fixture, checked field by field against what
    `port/tests/port-status/pass/.../circle.rs`'s own `// PERF(port):` marker and `PORT STATUS`
    trailer actually hold -- a direct, runnable proof of the row shape Done-when 2 states (module,
    vendored source path, marker line, reason), not merely the absence of findings."""
    rows = build_perf_backlog_rows(FIXTURES_ROOT / "pass")
    if len(rows) != 1:
        return [f"expected exactly 1 PERF(port) row from the 'pass' fixture, got {rows!r}"]
    row = rows[0]
    expected = PerfRow(
        module="crates/slic3r-circle/src/circle.rs",
        source="src/libslic3r/Geometry/Circle.cpp; src/libslic3r/Geometry/Circle.hpp",
        line=37,
        reason=(
            "the oracle walks this list twice; a single pass would do, left as-is to stay "
            "byte-for-byte with Circle.cpp's own traversal order."
        ),
    )
    failures = []
    for field_name in ("module", "source", "line", "reason"):
        got, want = getattr(row, field_name), getattr(expected, field_name)
        if got != want:
            failures.append(f"row.{field_name}: expected {want!r}, got {got!r}")
    rendered = render_perf_backlog(rows)
    if "| module | source | line | reason |" not in rendered:
        failures.append(f"render_perf_backlog did not emit the expected header; got: {rendered!r}")
    return failures


def _check_perf_reason_excludes_doc_comment() -> list[str]:
    """`extract_reason` must stop absorbing lines at a `///` doc comment, not fold it into a
    `// PERF(port):` marker's reason -- a direct, runnable proof (not merely the absence of
    findings) that `port/tests/port-status/perf-reason-excludes-doc-comment`'s fixture row
    carries only the marker's own bare-`//` text."""
    rows = build_perf_backlog_rows(FIXTURES_ROOT / "perf-reason-excludes-doc-comment")
    if len(rows) != 1:
        return [
            "expected exactly 1 PERF(port) row from the "
            f"'perf-reason-excludes-doc-comment' fixture, got {rows!r}"
        ]
    reason = rows[0].reason
    expected = "clones the whole vector; kept to mirror the oracle."
    if reason != expected:
        return [f"expected reason {expected!r} (doc comment excluded), got {reason!r}"]
    return []


def run_selftest() -> int:
    regex_failures = _check_candidate_marker_regex()
    for failure in regex_failures:
        click.echo(f"self-test: marker regex check FAILED: {failure}")

    perf_row_failures = _check_perf_row_shape()
    for failure in perf_row_failures:
        click.echo(f"self-test: perf-backlog row shape check FAILED: {failure}")

    doc_comment_failures = _check_perf_reason_excludes_doc_comment()
    for failure in doc_comment_failures:
        click.echo(f"self-test: perf-backlog reason/doc-comment check FAILED: {failure}")

    ok = not regex_failures and not perf_row_failures and not doc_comment_failures
    for name, expect_pass, must_contain in SELFTEST_FIXTURES:
        fixture_dir = FIXTURES_ROOT / name
        if not fixture_dir.is_dir():
            click.echo(f"self-test: {name}: FAILED (fixture directory missing: {fixture_dir})")
            ok = False
            continue
        result = scan_tree(fixture_dir)
        passed = not result.findings
        status = "pass" if passed else f"{len(result.findings)} finding(s)"
        if passed == expect_pass:
            matched_finding = next(
                (f for f in result.findings if must_contain is None or must_contain in f.rule),
                None,
            )
            matched = must_contain is None or matched_finding is not None
            if matched:
                detail = f", matched: {matched_finding.render()}" if matched_finding else ""
                click.echo(
                    f"self-test: {name}: OK (expected exit {'0' if expect_pass else '!=0'}, "
                    f"got {status}{detail})"
                )
            else:
                ok = False
                click.echo(
                    f"self-test: {name}: FAILED (expected a finding matching rule "
                    f"'{must_contain}', got: {[f.render() for f in result.findings]})"
                )
        else:
            ok = False
            click.echo(
                f"self-test: {name}: FAILED (expected "
                f"{'pass' if expect_pass else 'a failure'}, got {status}: "
                f"{[f.render() for f in result.findings]})"
            )
    return 0 if ok else 1


