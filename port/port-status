FULL_HELP = (
    "Check every ported module's PORT STATUS trailer and port markers (R14, R15, R16).\n\n"
    + TRAILER_HELP
    + "\n"
    + NUMERIC_RULE_HELP
    + "\n"
    + MARKER_WHITELIST_HELP
)


@click.command(context_settings={"max_content_width": 100}, help=FULL_HELP)
@click.option(
    "--tree",
    type=click.Path(file_okay=False, path_type=Path),
    default=None,
    help="Directory to scan crates/*/src/**/*.rs and port/manifest.tsv under. Defaults to the "
    "repository root. vendor/OrcaSlicer/ is always resolved from the real repository root, "
    "never from --tree.",
)
@click.option(
    "--per-commit",
    is_flag=True,
    help="Run the subset of checks a port task's branch passes. At this task, every check "
    "here is one of those, so this flag does not yet change behaviour; 22-port-status-gates "
    "adds the burn-down, the in-scope gate and the document-section checks that fail only "
    "without this flag.",
)
@click.option("--self-test", "self_test", is_flag=True, help="Run every fixture under port/tests/port-status/ and assert its expected result.")
def main(tree: Path | None, per_commit: bool, self_test: bool) -> None:
    pin_error = check_pin()
    if pin_error:
        click.echo(f"error: {pin_error}", err=True)
        sys.exit(1)

    if self_test:
        sys.exit(run_selftest())

    tree_root = tree.resolve() if tree is not None else REPO_ROOT
    result = scan_tree(tree_root)

    for finding in result.findings:
        click.echo(finding.render())

    mode = "per-commit" if per_commit else "default"
    counts = ", ".join(f"{name}={count}" for name, count in sorted(result.marker_counts.items()))
    click.echo(
        f"port-status ({mode}): {result.modules_scanned} module(s) scanned, "
        f"{len(result.findings)} finding(s); marker counts: {counts}"
    )
    sys.exit(1 if result.findings else 0)


if __name__ == "__main__":
    main()
