# --------------------------------------------------------------------------------------------
# Manifest: the in-scope file set, read at run time, never written into this script.
# --------------------------------------------------------------------------------------------


def in_scope_paths(manifest_path: Path) -> list[str]:
    """Return the in-scope rows' paths, relative to LIBSLIC3R_ROOT, sorted.

    A row is in scope when its "in scope or out with a reason" column is exactly "in" or starts
    with "in:" (an in-scope row with a note); every other value starts with "out:".
    """
    with manifest_path.open(newline="", encoding="utf-8") as fh:
        rows = list(csv.DictReader(fh, delimiter="\t"))
    scope_col = "in scope or out with a reason"
    paths = [r["path"] for r in rows if r[scope_col] == "in" or r[scope_col].startswith("in:")]
    paths.sort()
    return paths


# --------------------------------------------------------------------------------------------
# Source masking: blank out comments and string/char literals, preserving length and newlines,
# so regexes over "code" text never match inside a comment or a literal. Masking preserves every
# newline so line numbers computed from the masked text are the same as the original's.
# --------------------------------------------------------------------------------------------


def mask_source(text: str) -> str:
    """Replace comment and string/char literal bodies with spaces, keeping length and newlines."""
    out = list(text)
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            j = i
            while j < n and text[j] != "\n":
                out[j] = " "
                j += 1
            i = j
        elif c == "/" and i + 1 < n and text[i + 1] == "*":
            j = i
            out[j] = " "
            out[j + 1] = " "
            j += 2
            while j + 1 < n and not (text[j] == "*" and text[j + 1] == "/"):
                if text[j] != "\n":
                    out[j] = " "
                j += 1
            if j + 1 < n:
                out[j] = " "
                out[j + 1] = " "
                j += 2
            i = j
        elif c in ('"', "'"):
            quote = c
            # Raw string literal R"delim(...)delim" -- detect the R immediately before the quote.
            is_raw = i > 0 and text[i - 1] == "R" and quote == '"'
            if is_raw:
                paren = text.find("(", i)
                if paren == -1:
                    out[i] = " "
                    i += 1
                    continue
                delim = text[i + 1 : paren]
                closer = ")" + delim + '"'
                end = text.find(closer, paren)
                end = n if end == -1 else end + len(closer)
                for k in range(i, end):
                    if text[k] != "\n":
                        out[k] = " "
                i = end
                continue
            j = i + 1
            out[i] = " "
            while j < n and text[j] != quote:
                if text[j] == "\\" and j + 1 < n:
                    if text[j] != "\n":
                        out[j] = " "
                    if text[j + 1] != "\n":
                        out[j + 1] = " "
                    j += 2
                    continue
                if text[j] != "\n":
                    out[j] = " "
                j += 1
            if j < n:
                out[j] = " "
                j += 1
            i = j
        else:
            i += 1
    return "".join(out)


def line_index(text: str) -> list[int]:
    """Return the offset just after every newline in `text`, for a bisect-based line lookup."""
    offsets = [0]
    for m in re.finditer("\n", text):
        offsets.append(m.end())
    return offsets


def line_of(offsets: list[int], idx: int) -> int:
    """Return the 1-based line number of offset `idx`, using `offsets` from `line_index`."""
    return bisect.bisect_right(offsets, idx)


# --------------------------------------------------------------------------------------------
# Bracket helpers: a single depth counter across (), <>, [], {} is enough to split a comma list
# at top level, and a matched-pair finder for one bracket kind is enough to parse template
# argument lists and call argument lists. Both are heuristics over masked text, not a parser.
# --------------------------------------------------------------------------------------------

_OPEN = {"(": ")", "<": ">", "[": "]", "{": "}"}
_CLOSE = {v: k for k, v in _OPEN.items()}


def find_matching(text: str, open_idx: int) -> int | None:
    """Return the index of the bracket matching text[open_idx], or None if unbalanced."""
    open_ch = text[open_idx]
    close_ch = _OPEN[open_ch]
    depth = 0
    i = open_idx
    n = len(text)
    while i < n:
        c = text[i]
        if c == open_ch:
            depth += 1
        elif c == close_ch:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return None


def split_top_level(text: str, sep: str = ",") -> list[str]:
    """Split `text` on `sep`, ignoring any `sep` nested inside (), <>, [] or {}."""
    parts: list[str] = []
    depth = 0
    start = 0
    for i, c in enumerate(text):
        if c in _OPEN:
            depth += 1
        elif c in _CLOSE:
            depth -= 1
        elif c == sep and depth == 0:
            parts.append(text[start:i])
            start = i + 1
    parts.append(text[start:])
    return parts


# --------------------------------------------------------------------------------------------
# Scope scanner: one pass of brace matching over a masked file, classifying each `{...}` block
# as a class/struct body, a function body (with its name, and its owning class if it is an
# out-of-class member definition `Class::method(...)`), or an anonymous/transparent block
# (if/for/while/switch/lambda/namespace bodies, which do not themselves gate declaring scope).
# --------------------------------------------------------------------------------------------


@dataclass
class FunctionScope:
    name: str  # bare function/operator name, e.g. "operator<", "sort_by_z"
    owner: str | None  # the class name for a member function, else None
    file: str  # path relative to LIBSLIC3R_ROOT
    sig_start: int  # start of the signature (return type through the parameter list)
    start: int  # start of the body (just after the opening `{`)
    end: int
    start_line: int


@dataclass
class ClassScope:
    name: str
    file: str
    start: int
    end: int


_CLASS_HEADER_RE = re.compile(r"\b(?:class|struct)\s+(\w+)(?:\s+final)?\s*(?::[^{]*)?$")
# A function header: `... name ( params ) [const] [noexcept(...)] [override|final] [: init...]`.
# We find the LAST top-level `(...)` in the header and read the identifier right before it: an
# operator name (`operator<`, `operator()`, ...), optionally qualified by its owning class, or a
# plain name, likewise optionally qualified.
_OPERATOR_TAIL_RE = re.compile(r"(?:([A-Za-z_]\w*)\s*::\s*)?operator\s*(<=|>=|<|>|\(\)|\[\])\s*$")
_PLAIN_NAME_TAIL_RE = re.compile(r"(?:([A-Za-z_]\w*)\s*::\s*)?([A-Za-z_~]\w*)\s*$")
# A control-flow header's condition can itself end in a call (`if (!x.empty())`, `for (auto&
# v : foo())`), and picking the LAST top-level `(...)` (below) would then read the call's own
# name as a function name. Reject any header whose own leading keyword (after an optional
# leading `else`) is a control-flow keyword, before ever looking at its parens.
_CONTROL_HEAD_RE = re.compile(r"^(?:else\s+)?(if|for|while|switch|catch)\b")


_OPERATOR_SYMBOL_RE = re.compile(r"operator\s*(<<|>>|<=|>=|<|>)")


def _mask_operator_symbols(text: str) -> str:
    """Blank the `<`/`>` characters of an `operator<`/`<=`/`>`/`>=`/`<<`/`>>` token's own
    symbol, keeping length and every other character's position, so a bracket-depth scan over
    the header (see `_top_level_open_positions`) never mistakes the operator's own symbol for
    template/bracket punctuation -- an unmatched `<` from `operator<` would otherwise corrupt
    the depth count for the rest of the header and hide the real parameter list entirely."""
    out = list(text)
    for m in _OPERATOR_SYMBOL_RE.finditer(text):
        for i in range(m.start(1), m.end(1)):
            out[i] = " "
    return "".join(out)


def _top_level_open_positions(text: str, target_open: str) -> list[int]:
    """Return every position of `target_open` that sits at depth 0 across *all* bracket kinds
    (`()`, `[]`, `{}` and `<>` together), not just its own kind.

    A plain same-kind depth count (as `find_matching` uses, correctly, once given the right
    starting position) is not enough to *find* a header's own parameter-list paren: a return
    type or parameter type can itself carry a template argument list containing its own parens
    (`std::function<bool(int, int)>`), and those are nested *inside* a `<...>` the naive count
    never sees, so a same-kind-only scan reads the template's inner `(` as another top-level
    paren and, being later in the text, is picked over the real one. Treating `<`/`>` as
    brackets too (alongside `()[]{}` ) correctly nests that inner `(` one level deeper.
    """
    stack: list[str] = []
    positions: list[int] = []
    for i, c in enumerate(text):
        if c in _OPEN:
            if not stack and c == target_open:
                positions.append(i)
            stack.append(c)
        elif c in _CLOSE:
            if stack and stack[-1] == _CLOSE[c]:
                stack.pop()
            # A mismatched closer (e.g. a `>` that was really "greater than", not a template
            # close) is ignored rather than corrupting the rest of the scan.
    return positions


def classify_header(header: str) -> tuple[str, str | None, str | None]:
    """Classify the text immediately before a `{`.

    Returns (kind, name, owner) where kind is "class", "function" or "other". `name` is the
    class name or the function/operator name; `owner` is the owning class of a member function
    defined out of class (`Class::method`), else None.
    """
    h = header.strip()
    if not h:
        return "other", None, None
    m = _CLASS_HEADER_RE.search(h)
    if m:
        return "class", m.group(1), None
    if _CONTROL_HEAD_RE.match(h):
        return "other", None, None
    # Function: the header must end with `)` possibly followed by const/noexcept/override/final
    # and/or an initializer list `: a(...), b(...)`. Strip a trailing initializer list first (it
    # can itself contain parens, so strip from the first top-level `:` after the parameter list).
    stripped = h
    paren_positions = _top_level_open_positions(_mask_operator_symbols(stripped), "(")
    last_open = None
    for i in paren_positions:
        end = find_matching(stripped, i)
        if end is not None:
            last_open, last_close = i, end
    if last_open is None:
        return "other", None, None
    before = stripped[:last_open]
    after = stripped[last_close + 1 :]
    # `after` must look like specifiers/initializer-list only, no stray `{`/`;` (masking already
    # removed strings/comments, so this is a reasonably safe check).
    if "{" in after or ";" in after:
        return "other", None, None
    om = _OPERATOR_TAIL_RE.search(before)
    if om:
        owner, op = om.group(1), om.group(2)
        return "function", "operator" + op, owner
    pm = _PLAIN_NAME_TAIL_RE.search(before)
    if not pm:
        return "other", None, None
    owner, fname = pm.group(1), pm.group(2)
    # Reject common control-flow / keyword false positives that can precede a `(...)`.
    if fname in {"if", "for", "while", "switch", "catch", "return", "sizeof", "static_assert"}:
        return "other", None, None
    return "function", fname, owner


def scan_file(path: str, masked: str) -> tuple[list[FunctionScope], list[ClassScope]]:
    """Brace-match `masked`, returning every function scope and every class/struct scope."""
    functions: list[FunctionScope] = []
    classes: list[ClassScope] = []
    offsets = line_index(masked)
    # (kind, name, owner, sig_start, body_start)
    stack: list[tuple[str, str | None, str | None, int, int]] = []
    last_stmt_end = 0
    i = 0
    n = len(masked)
    while i < n:
        c = masked[i]
        if c == "{":
            header = masked[last_stmt_end:i]
            kind, name, owner = classify_header(header)
            if kind == "function" and owner is None:
                # An inline member function's header carries no `Class::` qualifier (that form
                # is only for a definition out of class), so its owner is the nearest enclosing
                # class/struct scope already on the stack, if any.
                for s_kind, s_name, *_ in reversed(stack):
                    if s_kind == "class":
                        owner = s_name
                        break
            stack.append((kind, name, owner, last_stmt_end, i + 1))
            last_stmt_end = i + 1
        elif c == "}":
            if stack:
                kind, name, owner, sig_start, start = stack.pop()
                end = i
                if kind == "function" and name is not None:
                    functions.append(
                        FunctionScope(
                            name=name, owner=owner, file=path, sig_start=sig_start, start=start, end=end, start_line=line_of(offsets, start)
                        )
                    )
                elif kind == "class" and name is not None:
                    classes.append(ClassScope(name=name, file=path, start=start, end=end))
            last_stmt_end = i + 1
        elif c == ";":
            last_stmt_end = i + 1
        i += 1
    return functions, classes


def enclosing_scope(pos: int, functions: list[FunctionScope], classes: list[ClassScope]) -> tuple[str, str, str]:
    """Return (kind, name, owner_or_empty) of the innermost scope containing `pos`.

    kind is "function", "class" or "file"; a bare "file" scope means pos is not inside any
    recognised function or class body (e.g. a file-scope static/global declaration).
    """
    best: tuple[str, str, str, int] | None = None  # (kind, name, owner, size)
    for f in functions:
        # sig_start, not start: a parameter declared by reference in the signature is "a
        # function it is passed to by reference" (the task's own words for the container rule),
        # so it must resolve to this function, not fall through to file scope.
        if f.sig_start <= pos < f.end:
            size = f.end - f.sig_start
            if best is None or size < best[3]:
                best = ("function", f.name, f.owner or "", size)
    for cl in classes:
        if cl.start <= pos < cl.end:
            size = cl.end - cl.start
            if best is None or size < best[3]:
                best = ("class", cl.name, "", size)
    if best is None:
        return "file", "<file scope>", ""
    return best[0], best[1], best[2]


# --------------------------------------------------------------------------------------------
# Container audit.
# --------------------------------------------------------------------------------------------

CONTAINER_TYPE_RE = re.compile(
    r"(std::unordered_(?:map|set|multimap|multiset)"
    r"|boost::unordered_[a-z_]+"
    r"|ankerl::unordered_dense::(?:map|set)"
    r"|tbb::concurrent_unordered_(?:map|set))\b"
)

MAP_KINDS = {
    "std::unordered_map",
    "std::unordered_multimap",
    "ankerl::unordered_dense::map",
    "tbb::concurrent_unordered_map",
    "boost::unordered_map",
    "boost::unordered_multimap",
}
SET_KINDS = {
    "std::unordered_set",
    "std::unordered_multiset",
    "ankerl::unordered_dense::set",
    "tbb::concurrent_unordered_set",
    "boost::unordered_set",
    "boost::unordered_multiset",
}

_DECLARATOR_NAME_RE = re.compile(r"([A-Za-z_]\w*)\s*(?:\[[^\]]*\]\s*)*$")

LOOKUP_METHODS = r"find|count|contains|at|insert|emplace(?:_hint)?|erase|size|empty|clear"
ALGORITHM_NAMES = (
    r"std::sort|std::stable_sort|std::partial_sort|std::nth_element|std::accumulate|"
    r"std::for_each|std::transform|std::copy|std::count_if|std::find_if|std::all_of|"
    r"std::any_of|std::none_of|std::max_element|std::min_element|std::reduce|"
    r"std::transform_reduce|tbb::parallel_for|tbb::parallel_for_each|tbb::parallel_reduce|"
    r"boost::accumulate"
)


@dataclass
class ContainerDecl:
    file: str
    line: int
    pos: int
    type_name: str
    var_name: str | None  # None when the declarator could not be parsed (reported undecided)


def find_container_decls(
    path: str, masked: str, offsets: list[int], funcs: list[FunctionScope], classes: list[ClassScope]
) -> list[ContainerDecl]:
    """Find every unordered-container variable declaration in `masked`.

    A container type's own match can sit in a variable declaration (`Type v;`, `Type v{...};`,
    `Type v = {...};`, `Type v(args);`, a reference parameter `Type& p` with or without a
    `= {}` default), in a function's return type or a parameter type (whether the function goes
    on to a body or is a bare prototype), or inside a `using`/`typedef` alias (skipped above).
    Only the first case names a container instance to audit; the rest produce no row.
    """
    decls: list[ContainerDecl] = []
    n = len(masked)
    for m in CONTAINER_TYPE_RE.finditer(masked):
        type_name = m.group(1)
        # Skip a type alias (`using X = std::unordered_map<...>;` / `typedef ... X;`): it names
        # no container instance, so there is nothing to classify. Look back to the nearest
        # preceding statement boundary for a `using`/`typedef` keyword on the same statement.
        stmt_start = max(masked.rfind(";", 0, m.start()), masked.rfind("{", 0, m.start()), masked.rfind("}", 0, m.start())) + 1
        if re.search(r"\b(?:using|typedef)\b", masked[stmt_start : m.start()]):
            continue
        after_type = m.end()
        # Only a declaration if the type name is directly followed by a template arg list.
        j = after_type
        while j < n and masked[j] in " \t":
            j += 1
        if j >= n or masked[j] != "<":
            continue
        close = find_matching(masked, j)
        if close is None:
            continue

        def undecided() -> None:
            decls.append(
                ContainerDecl(file=path, line=line_of(offsets, m.start()), pos=m.start(), type_name=type_name, var_name=None)
            )

        # Scan forward from just after the type's own closing `>` to the first top-level `(`,
        # `=`, `{`, `;` or `,`, or an unmatched closing bracket (`)`/`]`/`}`) that exits a
        # structure this scan never opened -- a parameter declared last in an enclosing
        # parameter list ends exactly this way, at the function's own closing `)`, with no `;`
        # or `,` of its own. That one boundary tells a bare declaration (`;`/`,`/a closing
        # bracket) or a brace-/equals-initialised variable (`{`/`=`) apart from a parenthesised
        # form (`(`, ambiguous between a direct-init variable `Type v(args);` and a function
        # signature) -- without a parameter list's or a constructor call's own parens ever being
        # mistaken for the declarator boundary (the previous version bumped a depth counter at
        # every one of those and never actually stopped there, which is how a `{` deep inside a
        # parameter's default argument reached the old blanket "`{` in declarator" check and
        # dropped every genuine brace-init variable along with it).
        k = close + 1
        depth = 0
        stop_char: str | None = None
        stop_pos = k
        while k < n:
            c = masked[k]
            if depth == 0 and c in "(={;,":
                stop_char, stop_pos = c, k
                break
            if c in "([{":
                depth += 1
            elif c in ")]}":
                if depth == 0:
                    stop_char, stop_pos = c, k
                    break
                depth -= 1
            k += 1
        if stop_char is None:
            # Ran off the end of the file: an unusual declarator form. Conservatively undecided.
            undecided()
            continue

        if stop_char != "(":
            # A bare, brace- or equals-initialised variable declaration (`;`/`,`/`{`/`=`). Cut
            # the declarator here, before any initialiser expression, so the trailing-identifier
            # match below reads the declared name and never a name inside the initialiser.
            name_source = masked[close + 1 : stop_pos]
        else:
            # `(`: a parameter list or a direct-init call -- ambiguous with a function's own
            # signature on the page alone. Resolve it from where this declaration sits.
            rparen = find_matching(masked, stop_pos)
            if rparen is None:
                undecided()
                continue
            # What follows the parameter list: specifiers and/or an initialiser list, then the
            # first top-level `{` (a body) or `;` (a prototype, or a direct-init statement).
            q = rparen + 1
            depth2 = 0
            after_stop: str | None = None
            while q < n:
                c = masked[q]
                if depth2 == 0 and c in "{;":
                    after_stop = c
                    break
                if c in "([{":
                    depth2 += 1
                elif c in ")]}":
                    if depth2 == 0:
                        break
                    depth2 -= 1
                q += 1
            in_function_body = any(f.start <= m.start() < f.end for f in funcs)
            in_class_only = (not in_function_body) and any(cl.start <= m.start() < cl.end for cl in classes)
            if in_function_body:
                # Nested named functions don't exist in C++: inside a function body this is a
                # local variable, direct-initialised with constructor arguments.
                name_source = masked[close + 1 : stop_pos]
            elif in_class_only:
                # In a class body, and not inside any method body, `Type member(args);` is
                # always a member function declaration -- a class has no syntax for
                # direct-initialising a data member with parens (the same "most vexing parse"
                # rule the language itself resolves this with). Whether it is a bare prototype
                # or defined inline, there is no container instance here to audit.
                continue
            elif after_stop == "{":
                # File/namespace scope, unambiguous: a body follows, so this is a function
                # definition's return type or parameter type, not a variable.
                continue
            elif after_stop == ";":
                # File/namespace scope, genuinely ambiguous between a forward-declared function
                # returning this container type and a direct-init variable definition.
                # Conservative: treat it as a variable rather than risk dropping a real
                # container, the same direction as every other undecided branch.
                name_source = masked[close + 1 : stop_pos]
            else:
                undecided()
                continue

        nm = _DECLARATOR_NAME_RE.search(name_source)
        if not nm or nm.group(1) in {"typedef", "using", "static", "const", "constexpr"}:
            # The declarator parse failed to find a plausible variable name (an unusual
            # declarator form this heuristic doesn't cover). Conservatively undecided rather
            # than silently dropped: `var_name=None` skips straight to that verdict below.
            undecided()
            continue
        var_name = nm.group(1)
        decls.append(ContainerDecl(file=path, line=line_of(offsets, m.start()), pos=m.start(), type_name=type_name, var_name=var_name))
    return decls


def classify_container_usage(var_name: str, search_text: str) -> tuple[str, str, int | None]:
    """Classify every occurrence of `var_name` in `search_text`.

    Returns (verdict, reason, line_offset_of_evidence) where verdict is "iterated",
    "looked_up" or "undecided", `reason` is a short fixed phrase (no raw source text, so a `|`
    in source code can never break the Markdown table), and `line_offset_of_evidence` is the
    character offset of the usage that decided it (for the "iteration path:line" cell), or None
    when there is none (the looked-up and the no-usage-found undecided cases).
    """
    name_re = re.escape(var_name)
    occ_re = re.compile(r"\b" + name_re + r"\b")
    range_for_re = re.compile(r"for\s*\([^;)]*:\s*" + name_re + r"\s*\)")
    begin_end_re = re.compile(
        r"(?:" + name_re + r"\s*\.\s*(?:begin|end|cbegin|cend)\s*\(|(?:std::)?(?:begin|end|cbegin|cend)\s*\(\s*" + name_re + r"\s*\))"
    )
    algo_re = re.compile(r"(?:" + ALGORITHM_NAMES + r")\s*\([^;]*\b" + name_re + r"\b")
    lookup_re = re.compile(name_re + r"\s*(?:\.\s*(?:" + LOOKUP_METHODS + r")\s*\(|\[)")
    # A `.end()`/`.cend()` immediately on one side of `==`/`!=` is the `find(k) != m.end()`
    # lookup idiom (the task's own rule lists `find` as lookup evidence), not an iteration --
    # even though the same call is also named as begin()/end() iteration evidence. Recognise
    # that idiom so the reason and evidence cells never claim an iteration at a lookup line.
    eq_before_re = re.compile(r"(==|!=)\s*$")

    saw_any = False
    saw_unknown = False
    saw_idiom_only = False
    idiom_pos: int | None = None
    first_iter_pos: int | None = None
    first_iter_reason: str | None = None
    for occ in occ_re.finditer(search_text):
        saw_any = True
        pos = occ.start()
        window_start = max(0, pos - 120)
        window_end = min(len(search_text), pos + 120)
        window = search_text[window_start:window_end]
        # The evidence position is the *matched pattern's own* position (offset by
        # window_start), not `pos` (the occurrence that triggered the window search) -- those
        # differ whenever the real begin()/end()/range-for/algorithm call sits near, but is not
        # at, this occurrence (e.g. an earlier `.find(...)` on the same variable, with the
        # variable's real iterating use a few lines later in the same window).
        m = range_for_re.search(window)
        if m:
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = window_start + m.start(), "range-for over the container"
            continue
        m = begin_end_re.search(window)
        if m:
            abs_pos = window_start + m.start()
            if eq_before_re.search(search_text[max(0, abs_pos - 4) : abs_pos]):
                saw_idiom_only = True
                if idiom_pos is None:
                    idiom_pos = abs_pos
                continue
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = abs_pos, "begin()/end() (or cbegin()/cend()) called on the container"
            continue
        m = algo_re.search(window)
        if m:
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = window_start + m.start(), "handed to an algorithm or a reduction"
            continue
        if lookup_re.match(search_text, pos):
            continue
        saw_unknown = True

    if first_iter_pos is not None:
        return "iterated", first_iter_reason or "iterated", first_iter_pos
    if saw_idiom_only and not saw_unknown:
        return (
            "undecided",
            "classification undecided: the only begin()/end() use found is a find()/end() "
            "lookup comparison (== or != against end()/cend()), which the begin()/end() "
            "iteration rule does not clearly cover",
            idiom_pos,
        )
    if saw_any and not saw_unknown:
        return "looked_up", "every use is find/count/contains/at/insert/emplace/erase/size/empty/clear", None
    return "undecided", "classification undecided: no recognised iterating or lookup-only use found", None


