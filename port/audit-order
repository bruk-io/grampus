COMPARATOR_OPERATORS = {"operator<", "operator<=", "operator>"}

TIE_SHAPE_RE = re.compile(r"return\s+std::tie\([^;]*\)\s*<\s*std::tie\([^;]*\)\s*;?\s*$")
SINGLE_FIELD_RE = re.compile(r"^return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")
IF_CHAIN_STEP = r"if\s*\(\s*[\w.\->()]+\s*!=\s*[\w.\->()]+\s*\)\s*return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;\s*"
IF_CHAIN_RE = re.compile(r"^(?:" + IF_CHAIN_STEP + r")+return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")
TERNARY_STEP = r"[\w.\->()]+\s*!=\s*[\w.\->()]+\s*\?\s*[\w.\->()]+\s*<\s*[\w.\->()]+\s*:\s*"
TERNARY_CHAIN_RE = re.compile(r"^return\s+(?:" + TERNARY_STEP + r")+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")

NON_STRICT_RE = re.compile(r"return\b[^;{}]*?(<=|>=)[^;{}]*?;")
TOLERANCE_RE = re.compile(r"\bEPSILON\b|\b(?:std::)?(?:fabs|abs)\s*\(")
DISJUNCTION_RE = re.compile(r"return\b[^;{}]*<[^;{}]*\|\|[^;{}]*<[^;{}]*;")

# The comparator surface also includes operator>, so a single `return X > Y;` (the common
# max-heap-style idiom, e.g. a priority_queue's Compare functor, or `this->field > other.field`)
# must be recognised as a clean total order too, not left undecided just because every other
# clean-shape pattern looks for `<`. A bare `>` -- the real comparator, not the `->` of a
# ubiquitous `this->field`/`obj->field` access, and not a `>=` -- is one not immediately preceded
# by `-` and not immediately followed by `=`.
_BARE_GT_RE = re.compile(r"(?<!-)>(?!=)")


def is_single_gt_compare(expr: str) -> bool:
    """True when `expr` (a `return` statement's expression, `;` already stripped) is a single,
    unparenthesized `A > B` and nothing else -- no `&&`/`||` (which would mean more than one
    comparison is involved), no negation (`!(*this > val)` is a `<=` wearing a `>` costume, not
    a clean `>` compare), and exactly one bare `>` in the whole expression."""
    if "&&" in expr or "||" in expr or "!" in expr:
        return False
    return len(_BARE_GT_RE.findall(expr)) == 1

_FIELD_EXPR = r"[\w.\->()\[\]]+"
_SINGLE_LT_RE = re.compile(r"^" + _FIELD_EXPR + r"\s*<\s*" + _FIELD_EXPR + r"$")
_GUARD_HEAD_RE = re.compile(r"^(" + _FIELD_EXPR + r")\s*<\s*(" + _FIELD_EXPR + r")\s*\|\|\s*\(")
_GUARD_INNER_RE = re.compile(r"^(" + _FIELD_EXPR + r")\s*==\s*(" + _FIELD_EXPR + r")\s*&&\s*(.*)$", re.DOTALL)


def strip_outer_parens(expr: str) -> str:
    """Strip parentheses that wrap `expr` as a whole, repeatedly.

    Only a `(` at index 0 whose *matching* `)` is the last character wraps the whole expression,
    so `(a < b || (a == b && c < d))` is unwrapped while `(a < b) || (c < d)` -- whose leading
    `(` closes in the middle -- is left exactly as it was. The lexicographic chains in this tree
    wrap their tail (`l.x() < r.x() || (l.x() == r.x() && (l.y() < r.y() || (...)))`), so the
    recursive call below is handed a wholly-parenthesised string and has to unwrap it before any
    pattern can match.
    """
    expr = expr.strip()
    while expr.startswith("("):
        close = find_matching(expr, 0)
        if close is None or close != len(expr) - 1:
            break
        expr = expr[1:-1].strip()
    return expr


def strip_paired_parens(left: str, right: str) -> tuple[str, str]:
    """Undo a parenthesised *comparison*, whose `(`/`)` land in two different captured fields.

    `_FIELD_EXPR` admits `(` and `)` so that `l.x()`, `pos(1)` and `a.getX()` count as fields,
    which means a parenthesised comparison -- `(density < other.density) || ...`, or the guard
    `((weight == other.weight) && ...)` -- is captured as the unbalanced pair `('(density',
    'other.density)')`. Neither half is individually balanced, so a per-field strip is a no-op;
    the parens have to come off as a pair. Only done when the result leaves *both* halves
    balanced, so `f(x` / `g(y)` is left alone.
    """
    if left.startswith("(") and right.endswith(")"):
        cand_l, cand_r = left[1:].strip(), right[:-1].strip()
        if cand_l.count("(") == cand_l.count(")") and cand_r.count("(") == cand_r.count(")"):
            return cand_l, cand_r
    return left, right


def is_lexicographic_or_chain(expr: str) -> bool:
    """True when `expr` is `F < F`, or the short-circuited chain `F < F || (F == F && ...)`.

    This is the common pre-``std::tie`` lexicographic-compare idiom (e.g.
    ``a.x < b.x || (a.x == b.x && a.y < b.y)``): textually it contains a `<` ... `||` ... `<`,
    the same shape ``DISJUNCTION_RE`` looks for, but the second comparison is only reached when
    the first pair compares equal, so it is a proper nested lexicographic chain over the fields
    in order, not two independently-orderable fields. ``classify_comparator_shape`` checks this
    *before* ``DISJUNCTION_RE`` so this idiom is recognised as a clean total order instead of a
    false-positive "disjunction". The guard's `==` must compare the *same* two fields the head's
    `<` compared (in either order) -- otherwise this is a real disjunction wearing an unrelated
    guard, and must fall through to ``DISJUNCTION_RE`` instead of being waved through as clean.
    Recursion (via `find_matching`, so a mismatched guard can never recurse past the string it
    was given) accepts a chain of any depth.

    Parentheses are stripped in the two places the idiom actually puts them, because
    `_FIELD_EXPR` admits `(`/`)` (for `l.x()`, `pos(1)`) and so swallows them into the captured
    fields: `strip_outer_parens` unwraps a wholly-parenthesised expression (which is what the
    recursive call is handed, since these chains parenthesise their tail), and
    `strip_paired_parens` undoes a parenthesised *comparison* in the head (`(density <
    other.density) || ...`, `Fill/FillHoneycomb.hpp:42`) or in the guard (`((weight ==
    other.weight) && ...)`, `Geometry.cpp:96`). Without them the guard-field equality below
    compares `{'(density', 'other.density)'}` against `{'density', 'other.density'}`, fails, and
    a genuine chain is reported as a "disjunction" -- a false claim about the vendored source.
    """
    expr = strip_outer_parens(expr)
    if _SINGLE_LT_RE.match(expr):
        return True
    head = _GUARD_HEAD_RE.match(expr)
    if not head:
        return False
    head_a, head_b = strip_paired_parens(head.group(1).strip(), head.group(2).strip())
    open_paren = head.end() - 1  # the "(" the pattern itself ends on, not any "(" in a.getX()
    close_paren = find_matching(expr, open_paren)
    if close_paren is None or close_paren != len(expr) - 1:
        return False
    inner = expr[open_paren + 1 : close_paren].strip()
    m = _GUARD_INNER_RE.match(inner)
    if not m:
        return False
    guard_a, guard_b = strip_paired_parens(m.group(1).strip(), m.group(2).strip())
    if {guard_a, guard_b} != {head_a, head_b}:
        return False
    return is_lexicographic_or_chain(m.group(3))

ORDER_ALGO_MIN_ARGS = {
    "std::sort": 2,
    "std::stable_sort": 2,
    "std::partial_sort": 3,
    "std::nth_element": 3,
    "std::lower_bound": 3,
    "std::upper_bound": 3,
    "std::binary_search": 3,
    "std::max_element": 2,
    "std::min_element": 2,
}
ORDER_ALGO_RE = re.compile(r"\b(" + "|".join(re.escape(k) for k in ORDER_ALGO_MIN_ARGS) + r")\s*\(")

ORDERED_CONTAINER_TEMPLATE_RE = re.compile(r"\b(std::map|std::multimap|std::set|std::multiset|std::priority_queue)\b")
# Fixed positions of the Compare argument for each ordered-container template.
COMPARE_ARG_INDEX = {
    "std::map": 2,
    "std::multimap": 2,
    "std::set": 1,
    "std::multiset": 1,
    "std::priority_queue": 2,
}
DEFAULT_COMPARE_RE = re.compile(r"^\s*std::(?:less|greater)\b")


def classify_comparator_shape(body: str, operator_name: str | None = None) -> tuple[str | None, str]:
    """Classify a comparator body.

    Returns (shape, reason). shape is one of "disjunction", "non_strict", "tolerance" (a
    not-a-total-order shape, in that priority order), None (recognised as a clean total order,
    so not reported), or "undecided" (reported, conservatively, as not a total order).

    `operator_name`, when this body is an `operator<=`/`operator>=` *definition*, settles the
    shape immediately: the operator's own name already establishes a non-strict relation (e.g.
    ``operator<=`` returning ``!(*this > val)`` is a `<=` by definition, however its body reads),
    so no clean-shape recogniser below is ever allowed to wave it through as a strict total
    order. TOLERANCE_RE and NON_STRICT_RE also run before the clean-shape recognisers, because
    neither can ever match a genuinely clean shape (those only ever use a bare `<`/`>`, never
    `<=`/`>=`/`EPSILON`/`fabs`/`abs`) -- so checking them first only catches bodies a clean
    recogniser would otherwise have swallowed by accident (e.g. ``fabs(a - b) < EPSILON``, whose
    single `<` also matches the single-field clean shape). DISJUNCTION_RE, by contrast, can and
    does match a genuine short-circuited lexicographic OR chain (`A < B || (A == B && C < D)`)
    as plain text, so it must stay *after* `is_lexicographic_or_chain`, which is the only check
    that tells the two apart.
    """
    normalized = re.sub(r"\s+", " ", body).strip()
    if operator_name in ("operator<=", "operator>="):
        return "non_strict", f"the comparator is {operator_name}: equal elements compare true by definition"
    if NON_STRICT_RE.search(normalized):
        return "non_strict", "the top-level return uses <= or >=: equal elements compare true"
    if TOLERANCE_RE.search(normalized):
        return "tolerance", "the comparison goes through a tolerance or EPSILON: the relation is non-transitive"
    ret_m = re.match(r"^return\s+(.*)$", normalized)
    if ret_m:
        expr = ret_m.group(1).rstrip()
        if expr.endswith(";"):
            expr = expr[:-1].rstrip()
        if is_lexicographic_or_chain(expr):
            return None, "recognised total-order shape (short-circuited lexicographic OR chain)"
        if is_single_gt_compare(expr):
            return None, "recognised total-order shape (single > comparison)"
    if DISJUNCTION_RE.search(normalized):
        return "disjunction", "a disjunction of < over different fields: two distinct elements can each compare less than the other"
    if (
        TIE_SHAPE_RE.search(normalized)
        or SINGLE_FIELD_RE.match(normalized)
        or IF_CHAIN_RE.match(normalized)
        or TERNARY_CHAIN_RE.match(normalized)
    ):
        return None, "recognised total-order shape"
    return "undecided", "classification undecided: the body matches none of the recognised total-order or non-total-order shapes"


