FIDELITY_MARKER_RE = re.compile(r"//\s*FIDELITY\(port\):")


def fidelity_marker_rows(crates_root: Path) -> list[list[str]]:
    """Every `// FIDELITY(port):` marker under `crates_root` (source 2).

    `crates_root` not existing contributes zero rows, not an error -- true today (no module has
    landed; `crates/` is created by 08-comparator-workspace, which this task does not depend
    on) and true of a fixture tree that simply has no `crates/` of its own. Paths are reported
    relative to `crates_root`'s parent, so pointing this at the real repository root
    (`crates_root = REPO_ROOT / "crates"`) reports `crates/...` paths exactly as committed,
    and pointing it at a self-contained fixture directory reports paths relative to that
    fixture, the same convention `port/port-status --tree` uses.
    """
    rows: list[list[str]] = []
    if not crates_root.is_dir():
        return rows
    tree_root = crates_root.parent
    for rs_path in sorted(crates_root.glob("*/src/**/*.rs")):
        try:
            text = rs_path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        relpath = rs_path.relative_to(tree_root).as_posix()
        for lineno, line in enumerate(text.splitlines(), start=1):
            if FIDELITY_MARKER_RE.search(line):
                place = f"{relpath}:{lineno}"
                rows.append(["fidelity-marker", place, STATIC_SITE_LEVEL, NA, NA, NA])
    return rows


def order_audit_rows(container_table: list[list[str]], comparator_table: list[list[str]]) -> list[list[str]]:
    """Source 1: every row of the two just-generated tables whose last cell (`diverges`) is
    `yes`, read from the tables `run()` returns -- never from the committed `.md` files, so a
    stale committed report can never be read back into its own regeneration."""
    rows: list[list[str]] = []
    for table in (container_table, comparator_table):
        for row in table:
            if row[-1] == "yes":
                rows.append(["order-audit", row[0], STATIC_SITE_LEVEL, NA, NA, NA])
    return rows


def read_tsv_source(
    path: Path, required_columns: list[str], predicate, row_builder
) -> tuple[list[list[str]], bool]:
    """Read one of sources 3/4's `.tsv` files by column name.

    Returns (rows, present). `path` not existing is `([], False)`, not an error (the rule an
    absent source is never a failure). `path` existing with a header missing any of
    `required_columns` exits non-zero naming the column(s) -- the other rule, that a present
    but unreadable source is a failure rather than silently zero rows. Row order follows the
    file; the caller sorts the combined table.
    """
    if not path.is_file():
        return [], False
    with path.open(newline="", encoding="utf-8") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        fieldnames = list(reader.fieldnames or [])
        missing = [c for c in required_columns if c not in fieldnames]
        if missing:
            raise SystemExit(
                f"audit-order: {path} is missing column(s) {missing!r}; its header is "
                f"{fieldnames!r} but {required_columns!r} are required"
            )
        rows = [row_builder(r) for r in reader if predicate(r)]
    return rows, True


ORACLE_PARITY_REQUIRED = ["configuration", "fixture", "artifact", "level reached", "normative oracle"]
# Levels that count as "reaching L1": L0 (strictly more bytes-identical) and L1 itself.
ORACLE_PARITY_REACHES_L1 = {"L0", "L1"}


def _oracle_parity_predicate(row: dict[str, str]) -> bool:
    return row["level reached"].strip() not in ORACLE_PARITY_REACHES_L1


def _oracle_parity_row(row: dict[str, str]) -> list[str]:
    place = f"configuration: {row['configuration'].strip()}, fixture: {row['fixture'].strip()}, artifact: {row['artifact'].strip()}"
    return ["oracle-parity", place, row["level reached"].strip(), NA, NA, NA]


DETERMINISM_REQUIRED = ["configuration", "fixture", "artifact", "gate"]


def _determinism_predicate(row: dict[str, str]) -> bool:
    return row["gate"].strip() == "none"


def _determinism_row(row: dict[str, str]) -> list[str]:
    configuration, fixture, artifact = row["configuration"].strip(), row["fixture"].strip(), row["artifact"].strip()
    place = f"configuration: {configuration}, fixture: {fixture}, artifact: {artifact}"
    return ["determinism", place, "none", configuration, fixture, artifact]


@dataclass
class DivergencesResult:
    rows: list[list[str]]
    # (source name, present, row count), in SOURCE_ORDER.
    summary: list[tuple[str, bool, int]]


def build_divergences(
    container_table: list[list[str]],
    comparator_table: list[list[str]],
    crates_root: Path,
    oracle_parity_path: Path,
    determinism_path: Path,
) -> DivergencesResult:
    order_rows = order_audit_rows(container_table, comparator_table)
    fidelity_rows = fidelity_marker_rows(crates_root)
    oracle_rows, oracle_present = read_tsv_source(
        oracle_parity_path, ORACLE_PARITY_REQUIRED, _oracle_parity_predicate, _oracle_parity_row
    )
    determinism_rows, determinism_present = read_tsv_source(
        determinism_path, DETERMINISM_REQUIRED, _determinism_predicate, _determinism_row
    )

    by_source = {
        "order-audit": order_rows,
        "fidelity-marker": fidelity_rows,
        "oracle-parity": oracle_rows,
        "determinism": determinism_rows,
    }
    presence = {
        "order-audit": True,  # this run's own in-memory tables: always present.
        "fidelity-marker": crates_root.is_dir(),
        "oracle-parity": oracle_present,
        "determinism": determinism_present,
    }

    all_rows = [row for name in SOURCE_ORDER for row in by_source[name]]
    all_rows.sort(key=lambda r: (SOURCE_ORDER.index(r[0]), r[1], r[2], r[3], r[4], r[5]))
    summary = [(name, presence[name], len(by_source[name])) for name in SOURCE_ORDER]
    return DivergencesResult(rows=all_rows, summary=summary)


def write_divergences(path: Path, result: DivergencesResult) -> None:
    lines = [
        "| " + " | ".join(DIVERGENCES_HEADER) + " |",
        "| " + " | ".join(["---"] * len(DIVERGENCES_HEADER)) + " |",
    ]
    for row in result.rows:
        lines.append("| " + " | ".join(row) + " |")
    lines.append("")
    lines.append("## Sources")
    lines.append("")
    lines.append(
        "Every row above comes from exactly one of these four sources; a source that was "
        "absent when this file was regenerated contributed zero rows, not a failure."
    )
    lines.append("")
    lines.append("| source | present | rows contributed |")
    lines.append("| --- | --- | --- |")
    for name, present, count in result.summary:
        lines.append(f"| {name} | {'yes' if present else 'no'} | {count} |")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------------------------
# Markdown table writer.
# --------------------------------------------------------------------------------------------


def write_table(path: Path, header: list[str], rows: list[list[str]]) -> None:
    lines = ["| " + " | ".join(header) + " |", "| " + " | ".join(["---"] * len(header)) + " |"]
    for row in rows:
        lines.append("| " + " | ".join(row) + " |")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def escape_cell(text: str) -> str:
    """Escape a cell so raw source text (which may carry `|`) can never break a Markdown row."""
    return text.replace("|", "\\|").replace("\n", " ")


# --------------------------------------------------------------------------------------------
# Main pass.
# --------------------------------------------------------------------------------------------


def run(manifest_path: Path) -> tuple[list[list[str]], list[list[str]]]:
    paths = in_scope_paths(manifest_path)

    file_masked: dict[str, str] = {}
    file_offsets: dict[str, list[int]] = {}
    all_functions: list[FunctionScope] = []
    all_classes: list[ClassScope] = []
    functions_by_owner: dict[str, list[FunctionScope]] = {}
    functions_by_name: list[FunctionScope] = []

    for rel in paths:
        abspath = LIBSLIC3R_ROOT / rel
        text = abspath.read_text(encoding="utf-8", errors="replace")
        masked = mask_source(text)
        file_masked[rel] = masked
        file_offsets[rel] = line_index(masked)
        funcs, classes = scan_file(rel, masked)
        all_functions.extend(funcs)
        all_classes.extend(classes)
        for f in funcs:
            if f.owner:
                functions_by_owner.setdefault(f.owner, []).append(f)
            else:
                functions_by_name.append(f)

    functions_by_file: dict[str, list[FunctionScope]] = {}
    classes_by_file: dict[str, list[ClassScope]] = {}
    for f in all_functions:
        functions_by_file.setdefault(f.file, []).append(f)
    for c in all_classes:
        classes_by_file.setdefault(c.file, []).append(c)

    # -------------------------------------------------------------------------------------
    # Containers.
    # -------------------------------------------------------------------------------------
    container_rows: list[tuple[str, int, list[str]]] = []
    seen_container_keys: set[tuple[str, int, str]] = set()
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        funcs = functions_by_file.get(rel, [])
        classes = classes_by_file.get(rel, [])
        for decl in find_container_decls(rel, masked, offsets, funcs, classes):
            pos = decl.pos
            key = (rel, decl.line, decl.var_name)
            if key in seen_container_keys:
                continue

            if decl.var_name is None:
                # The declarator could not be parsed to a variable name at all (see
                # find_container_decls); there is no name to search usages for, so this is
                # conservatively undecided with no scope or iteration site to report.
                seen_container_keys.add(key)
                choice = container_port_choice(decl.type_name, "undecided")
                div, div_reason = diverges(choice)
                reason_cell = "classification undecided: the declarator could not be parsed to find a variable name; " + div_reason
                container_rows.append(
                    (
                        rel,
                        decl.line,
                        [
                            repo_path_line(rel, decl.line),
                            decl.type_name,
                            "<unparsed declarator>",
                            "n/a",
                            escape_cell(reason_cell),
                            choice,
                            div,
                        ],
                    )
                )
                continue

            scope_kind, scope_name, owner = enclosing_scope(pos, funcs, classes)
            # `segments`: every (file, base_offset, masked_text) span this declaration's uses
            # could appear in -- just the declaring function's own body for a local variable,
            # but every method of the class (inline or defined in another in-scope file via
            # `Class::method`) for a data member, since "the scope that declares it" extends to
            # the whole class for a member (see the task's container rule).
            if scope_kind == "function":
                fn_slice = funcs_start_end(funcs, pos)
                segments = [(rel, fn_slice.start, masked[fn_slice])]
                declaring_scope = scope_name if not owner else f"{owner}::{scope_name}"
            elif scope_kind == "class":
                segments = [(rel, c.start, masked[c.start : c.end]) for c in classes if c.name == scope_name and c.file == rel]
                segments.extend((mf.file, mf.start, file_masked[mf.file][mf.start : mf.end]) for mf in functions_by_owner.get(scope_name, []))
                declaring_scope = scope_name
            else:
                segments = [(rel, 0, masked)]
                declaring_scope = "<file scope>"

            combined_parts: list[str] = []
            boundaries: list[tuple[int, str, int]] = []  # (combined_start, file, base_offset)
            cursor = 0
            for seg_file, seg_base, seg_text in segments:
                boundaries.append((cursor, seg_file, seg_base))
                combined_parts.append(seg_text)
                cursor += len(seg_text) + 1  # +1 for the "\n" join separator below
            search_text = "\n".join(combined_parts)

            verdict, reason, evidence_pos = classify_container_usage(decl.var_name, search_text)
            if verdict == "looked_up" and scope_kind == "function":
                # The task's rule also counts a container iterated "in a function it is passed
                # to by reference" -- a local that looks only-looked-up in its own declaring
                # function can still be handed by reference to another call this script does
                # not resolve a call graph to check. Named branch, kept explicit for the same
                # reason `diverges` below documents its own never-taken branch: by construction
                # this one is not reachable either. `lookup_re` only ever matches the variable
                # immediately followed by `.<method>(` or `[`, so the one textual shape that
                # would mean "passed as a bare argument" -- the name directly preceded by `(` or
                # `,` and followed by `,` or `)` -- can never also satisfy `lookup_re`; any such
                # occurrence already fails every recognised pattern and is already caught as an
                # "unknown" occurrence by `classify_container_usage` itself, which already
                # returns "undecided" rather than "looked_up" for it. Kept as its own branch
                # anyway (rather than relying on that as an implicit side effect) so a reviewer
                # can point at the rule by name; if `lookup_re` ever grows a method whose own
                # call syntax also matches this shape, this branch is what keeps the row
                # conservative instead of silently reintroducing exactly the gap it closes.
                bare_arg_re = re.compile(r"[(,]\s*&?\s*" + re.escape(decl.var_name) + r"\s*[,)]")
                if bare_arg_re.search(search_text):
                    verdict = "undecided"
                    reason = (
                        "classification undecided: the container is passed as an argument to a "
                        "call in its declaring scope; this script does not resolve the callee "
                        "to check whether it is iterated there"
                    )
                    evidence_pos = None
            if verdict == "looked_up":
                continue  # only iterated (incl. undecided) containers are rows in this report.
            seen_container_keys.add(key)

            if evidence_pos is not None:
                starts = [b[0] for b in boundaries]
                seg_idx = bisect.bisect_right(starts, evidence_pos) - 1
                seg_start, seg_file, seg_base = boundaries[seg_idx]
                iter_line = line_of(file_offsets[seg_file], seg_base + (evidence_pos - seg_start))
                iter_path_line = repo_path_line(seg_file, iter_line)
            else:
                iter_path_line = "n/a"

            choice = container_port_choice(decl.type_name, verdict)
            div, div_reason = diverges(choice)
            reason_cell = reason + "; " + div_reason
            container_rows.append(
                (
                    rel,
                    decl.line,
                    [
                        repo_path_line(rel, decl.line),
                        decl.type_name,
                        declaring_scope,
                        iter_path_line,
                        escape_cell(reason_cell),
                        choice,
                        div,
                    ],
                )
            )

    container_rows.sort(key=lambda r: (r[0], r[1], r[2]))
    container_table = [row for _, _, row in container_rows]

    # -------------------------------------------------------------------------------------
    # Comparators.
    # -------------------------------------------------------------------------------------
    comparator_rows: list[tuple[str, int, list[str]]] = []
    seen_comparator_keys: set[tuple[str, int, str, str, int]] = set()

    def emit_comparator(
        comp_file: str, comp_line: int, reach: str, use_file: str, use_line: int, shape: str, reason: str
    ) -> None:
        """Record one comparator row. `comp_*` is the comparator's own site (cell 1); `use_*` is
        the site named in cell 2's "how it reaches an ordering" (the same site as `comp_*` for a
        definition or an inline lambda, but the call site or container declaration for a
        comparator resolved from elsewhere)."""
        key = (comp_file, comp_line, reach, use_file, use_line)
        if key in seen_comparator_keys:
            return
        seen_comparator_keys.add(key)
        choice = comparator_port_choice(shape)
        div, div_reason = diverges(choice)
        comparator_rows.append(
            (
                comp_file,
                comp_line,
                [
                    repo_path_line(comp_file, comp_line),
                    reach,
                    repo_path_line(use_file, use_line),
                    shape,
                    escape_cell(reason + "; " + div_reason),
                    choice,
                    div,
                ],
            )
        )

    # Reach A: operator< / operator<= / operator> definitions. The comparator's own site and the
    # "use" are the same place: the definition is what a standard algorithm invokes directly.
    for f in all_functions:
        if f.name not in COMPARATOR_OPERATORS:
            continue
        body = file_masked[f.file][f.start : f.end]
        shape, reason = classify_comparator_shape(body, operator_name=f.name)
        if shape is None:
            continue
        emit_comparator(f.file, f.start_line, "definition", f.file, f.start_line, shape, reason)

    # Reach B: the Compare template argument of an ordered container.
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        for m in ORDERED_CONTAINER_TEMPLATE_RE.finditer(masked):
            kind = m.group(1)
            j = m.end()
            while j < len(masked) and masked[j] in " \t":
                j += 1
            if j >= len(masked) or masked[j] != "<":
                continue
            close = find_matching(masked, j)
            if close is None:
                continue
            args = split_top_level(masked[j + 1 : close])
            idx = COMPARE_ARG_INDEX[kind]
            if len(args) <= idx:
                continue
            cmp_arg = args[idx].strip()
            if not cmp_arg or DEFAULT_COMPARE_RE.match(cmp_arg):
                continue
            line = line_of(offsets, m.start())
            cmp_name = cmp_arg.split("<")[0].strip().rsplit("::", 1)[-1]
            candidates = functions_by_owner.get(cmp_name, [])
            op_funcs = [f for f in candidates if f.name == "operator()" or f.name in COMPARATOR_OPERATORS]
            if not op_funcs:
                emit_comparator(
                    rel,
                    line,
                    "container Compare argument",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator type {cmp_name!r}'s body is not found among the in-scope files",
                )
                continue
            for f in op_funcs:
                body = file_masked[f.file][f.start : f.end]
                shape, reason = classify_comparator_shape(body, operator_name=f.name)
                if shape is None:
                    continue
                emit_comparator(f.file, f.start_line, "container Compare argument", rel, line, shape, reason)

    # Reach C: the comparator passed at an ordering-algorithm call site.
    LAMBDA_HEAD_RE = re.compile(r"^\[[^\]]*\]\s*\([^)]*\)\s*(?:->\s*[\w:<>, ]+\s*)?\{")
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        for m in ORDER_ALGO_RE.finditer(masked):
            algo = m.group(1)
            open_paren = m.end() - 1
            close_paren = find_matching(masked, open_paren)
            if close_paren is None:
                continue
            args = split_top_level(masked[open_paren + 1 : close_paren])
            if len(args) <= ORDER_ALGO_MIN_ARGS[algo]:
                continue  # no comparator argument supplied; uses the default std::less.
            last_arg_raw = args[-1]
            cmp_arg = last_arg_raw.strip()
            line = line_of(offsets, m.start())
            lam = LAMBDA_HEAD_RE.match(cmp_arg)
            if lam:
                # Offsets below are into `masked` and must use the *unstripped* arg text's own
                # length (from split_top_level) to stay aligned; `cmp_arg` is only for matching.
                last_arg_start = open_paren + 1 + sum(len(a) + 1 for a in args[:-1])
                brace_rel = last_arg_raw.find("{")
                abs_open = last_arg_start + brace_rel
                abs_close = find_matching(masked, abs_open)
                lambda_line = line_of(offsets, abs_open)
                # Interior only (no braces), matching the convention FunctionScope bodies use,
                # since classify_comparator_shape's patterns are anchored to a bare `return ...`.
                body = masked[abs_open + 1 : abs_close] if abs_close is not None else cmp_arg
                shape, reason = classify_comparator_shape(body)
                if shape is None:
                    continue
                # The lambda is defined at the call site, so comparator site == use site.
                emit_comparator(rel, lambda_line, "call-site comparator", rel, line, shape, reason)
                continue
            fname = cmp_arg.rsplit("::", 1)[-1].strip()
            if not re.fullmatch(r"[A-Za-z_]\w*", fname):
                # Not a lambda and not a plain identifier (a bind expression, a functor instance,
                # a qualified template name, ...): this parse cannot resolve the comparator, so
                # report it conservatively as not a total order rather than drop it.
                emit_comparator(
                    rel,
                    line,
                    "call-site comparator",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator expression {cmp_arg!r} passed to {algo} is not a lambda or a plain name this parse resolves",
                )
                continue
            named = [f for f in functions_by_name if f.name == fname]
            if not named:
                emit_comparator(
                    rel,
                    line,
                    "call-site comparator",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator {fname!r} passed to {algo} is not found among the in-scope files",
                )
                continue
            for f in named:
                body = file_masked[f.file][f.start : f.end]
                shape, reason = classify_comparator_shape(body, operator_name=f.name)
                if shape is None:
                    continue
                emit_comparator(f.file, f.start_line, "call-site comparator", rel, line, shape, reason)

    comparator_rows.sort(key=lambda r: (r[0], r[1], r[2]))
    comparator_table = [row for _, _, row in comparator_rows]

    return container_table, comparator_table


def funcs_start_end(funcs: list[FunctionScope], pos: int) -> slice:
    """Return the (signature-through-body) slice of the innermost function containing `pos`.

    Starting at `sig_start` (not `start`, the body) means a parameter declaration is included in
    the search text along with the body, consistent with `enclosing_scope` using the same span.
    """
    best: FunctionScope | None = None
    for f in funcs:
        if f.sig_start <= pos < f.end:
            if best is None or (f.end - f.sig_start) < (best.end - best.sig_start):
                best = f
    if best is None:
        return slice(0, 0)
    return slice(best.sig_start, best.end)


def regenerate_all(out_dir: Path | None) -> tuple[Path, Path, Path, DivergencesResult]:
    """Run the full pass (parts 1 and 2) and write all three reports under `out_dir`, or the
    committed `port/reports/` tree when `out_dir` is None. Returns the three report paths and
    the divergences result, so a caller (`main`, `run_check`) can print or diff without
    re-running the pass."""
    container_table, comparator_table = run(MANIFEST_PATH)

    if out_dir is None:
        containers_path, comparators_path, divergences_path = CONTAINERS_REPORT, COMPARATORS_REPORT, DIVERGENCES_REPORT
    else:
        containers_path = out_dir / "order-containers.md"
        comparators_path = out_dir / "order-comparators.md"
        divergences_path = out_dir / "divergences.md"

    write_table(
        containers_path,
        ["declaration", "container type", "declaring scope", "iteration", "reason", "port's choice", "diverges"],
        container_table,
    )
    write_table(
        comparators_path,
        ["comparator", "reach", "use", "shape", "reason", "port's choice", "diverges"],
        comparator_table,
    )
    result = build_divergences(container_table, comparator_table, CRATES_ROOT, ORACLE_PARITY_TSV, DETERMINISM_TSV)
    write_divergences(divergences_path, result)
    click.echo(f"{containers_path if out_dir else containers_path.relative_to(REPO_ROOT)}: {len(container_table)} rows")
    click.echo(f"{comparators_path if out_dir else comparators_path.relative_to(REPO_ROOT)}: {len(comparator_table)} rows")
    counts = ", ".join(f"{name}={count}" for name, _present, count in result.summary)
    click.echo(
        f"{divergences_path if out_dir else divergences_path.relative_to(REPO_ROOT)}: "
        f"{len(result.rows)} rows ({counts})"
    )
    return containers_path, comparators_path, divergences_path, result


def run_check() -> None:
    """`just audit-check`: regenerate all three reports into a scratch directory (git-ignored)
    and fail, with a diff, when a committed one differs byte for byte. The regeneration's own
    chatter is captured to a log file rather than printed, so a clean tree's check prints
    nothing at all (part 1's two reports and divergences.md are already byte-stable by
    construction: no timestamp, no machine-specific path, deterministic sort)."""
    SCRATCH_ROOT.mkdir(parents=True, exist_ok=True)
    log_path = SCRATCH_ROOT / "audit-check.log"
    with log_path.open("w", encoding="utf-8") as log_file, contextlib.redirect_stdout(log_file):
        fresh_containers, fresh_comparators, fresh_divergences, _result = regenerate_all(SCRATCH_ROOT)

    diffs: list[str] = []
    for committed, fresh in (
        (CONTAINERS_REPORT, fresh_containers),
        (COMPARATORS_REPORT, fresh_comparators),
        (DIVERGENCES_REPORT, fresh_divergences),
    ):
        committed_text = committed.read_text(encoding="utf-8") if committed.is_file() else None
        fresh_text = fresh.read_text(encoding="utf-8")
        if committed_text != fresh_text:
            diffs.append(f"{committed.relative_to(REPO_ROOT)} has drifted from its regeneration")

    if diffs:
        print(f"audit-check: drift found (the regeneration's own output is at {log_path}):")
        for line in diffs:
            print(f"  {line}")
        raise SystemExit(1)


