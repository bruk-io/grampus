#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "click>=8.1.0",
# ]
# ///

"""Regenerate port/reports/order-containers.md and port/reports/order-comparators.md (R18).

``port/audit-order`` walks the in-scope rows of ``port/manifest.tsv`` (read at run time; no
file list is written into this script or into a document) and writes two static-analysis
reports:

- ``port/reports/order-containers.md`` -- every unordered container
  (``std::unordered_map/set/multimap/multiset``, ``boost::unordered_*``,
  ``ankerl::unordered_dense::map/set``, ``tbb::concurrent_unordered_map/set``) that is
  **iterated** rather than only looked up.
- ``port/reports/order-comparators.md`` -- every comparator (an ``operator<``/``<=``/``>``
  definition, a ``std::map``/``set``/``multimap``/``multiset``/``priority_queue``'s ``Compare``
  argument, or a comparator passed at an ordering-algorithm call site) that is **not a total
  order**.

Both reports are fully derived: every cell is computed from the vendored tree on every run, none
is hand-edited, and running this script twice leaves both files byte-identical. Part 2 of this
step (18-divergences-regeneration) adds ``port/reports/divergences.md``, ``port/regenerate`` and
``just audit-check``; this script writes only the two reports above.

This is a heuristic static analyser, not a C++ parser. It masks out comments and string/char
literals, then recovers enough structure with brace matching (which header opened a given ``{``:
a class/struct body, a function body, or neither) to answer two questions per site: for a
container, is every one of its uses a lookup (``find``/``count``/``contains``/``at``/``[]``/
``insert``/``emplace``/``erase``-by-key/``size``/``empty``/``clear``), or does it get iterated
(range-``for``, ``begin``/``end``/``cbegin``/``cend``, or handed to an algorithm or a reduction)?
For a comparator, does its body match one of the three non-total-order shapes (a disjunction of
``<`` over different fields, a top-level ``<=``/``>=``, or a floating-point tolerance/``EPSILON``
compare), or one of the recognised total-order shapes (``std::tie(...) < std::tie(...)``, a
single-field compare, a nested lexicographic if-chain, or a nested ternary chain)?

**Every one of those four questions is answered conservatively.** Where the script cannot decide
whether a container is only looked up, it reports the row as iterated. Where it cannot decide
whether a comparator is a total order, it reports the row as not one. In both cases the reason
cell says the classification is undecided. The port's-choice mapping (``port_choice``) and the
diverges rule (``diverges``) are likewise written as explicit, named branches below, not as
literals folded into a row dict, because the point of writing them in code is that a reviewer can
point at the branch that produced a given cell.

This script never attempts to establish whether a given site's order actually reaches compared
output -- that is a dynamic question a static audit cannot answer -- so ``diverges`` defaults to
``yes`` with a reason noting the reaches-output question is undecided, for every row this script
emits. The only branch that can answer ``no`` is a port's choice that provably carries no order at
all (a looked-up-only container, which is why that branch is never reached here: such containers
are not iterated, so no row is emitted for them). See ``diverges`` below for the one other named
exception the task describes (an already-strict relation under a non-strict textual shape), which
this static script has no way to detect and therefore never emits.
"""

from __future__ import annotations

import bisect
import csv
import re
import sys
from dataclasses import dataclass
from pathlib import Path

import click

REPO_ROOT = Path(__file__).resolve().parent.parent
LIBSLIC3R_ROOT = REPO_ROOT / "vendor" / "OrcaSlicer" / "src" / "libslic3r"
LIBSLIC3R_PREFIX = "vendor/OrcaSlicer/src/libslic3r/"
MANIFEST_PATH = REPO_ROOT / "port" / "manifest.tsv"
CONTAINERS_REPORT = REPO_ROOT / "port" / "reports" / "order-containers.md"
COMPARATORS_REPORT = REPO_ROOT / "port" / "reports" / "order-comparators.md"


# --------------------------------------------------------------------------------------------
# Manifest: the in-scope file set, read at run time, never written into this script.
# --------------------------------------------------------------------------------------------


def in_scope_paths(manifest_path: Path) -> list[str]:
    """Return the in-scope rows' paths, relative to LIBSLIC3R_ROOT, sorted.

    A row is in scope when its "in scope or out with a reason" column is exactly "in" or starts
    with "in:" (an in-scope row with a note); every other value starts with "out:".
    """
    with manifest_path.open(newline="") as fh:
        rows = list(csv.DictReader(fh, delimiter="\t"))
    scope_col = "in scope or out with a reason"
    paths = [r["path"] for r in rows if r[scope_col] == "in" or r[scope_col].startswith("in:")]
    paths.sort()
    return paths


# --------------------------------------------------------------------------------------------
# Source masking: blank out comments and string/char literals, preserving length and newlines,
# so regexes over "code" text never match inside a comment or a literal. Masking preserves every
# newline so line numbers computed from the masked text are the same as the original's.
# --------------------------------------------------------------------------------------------


def mask_source(text: str) -> str:
    """Replace comment and string/char literal bodies with spaces, keeping length and newlines."""
    out = list(text)
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            j = i
            while j < n and text[j] != "\n":
                out[j] = " "
                j += 1
            i = j
        elif c == "/" and i + 1 < n and text[i + 1] == "*":
            j = i
            out[j] = " "
            out[j + 1] = " "
            j += 2
            while j + 1 < n and not (text[j] == "*" and text[j + 1] == "/"):
                if text[j] != "\n":
                    out[j] = " "
                j += 1
            if j + 1 < n:
                out[j] = " "
                out[j + 1] = " "
                j += 2
            i = j
        elif c in ('"', "'"):
            quote = c
            # Raw string literal R"delim(...)delim" -- detect the R immediately before the quote.
            is_raw = i > 0 and text[i - 1] == "R" and quote == '"'
            if is_raw:
                paren = text.find("(", i)
                if paren == -1:
                    out[i] = " "
                    i += 1
                    continue
                delim = text[i + 1 : paren]
                closer = ")" + delim + '"'
                end = text.find(closer, paren)
                end = n if end == -1 else end + len(closer)
                for k in range(i, end):
                    if text[k] != "\n":
                        out[k] = " "
                i = end
                continue
            j = i + 1
            out[i] = " "
            while j < n and text[j] != quote:
                if text[j] == "\\" and j + 1 < n:
                    if text[j] != "\n":
                        out[j] = " "
                    if text[j + 1] != "\n":
                        out[j + 1] = " "
                    j += 2
                    continue
                if text[j] != "\n":
                    out[j] = " "
                j += 1
            if j < n:
                out[j] = " "
                j += 1
            i = j
        else:
            i += 1
    return "".join(out)


def line_index(text: str) -> list[int]:
    """Return the offset just after every newline in `text`, for a bisect-based line lookup."""
    offsets = [0]
    for m in re.finditer("\n", text):
        offsets.append(m.end())
    return offsets


def line_of(offsets: list[int], idx: int) -> int:
    """Return the 1-based line number of offset `idx`, using `offsets` from `line_index`."""
    return bisect.bisect_right(offsets, idx)


# --------------------------------------------------------------------------------------------
# Bracket helpers: a single depth counter across (), <>, [], {} is enough to split a comma list
# at top level, and a matched-pair finder for one bracket kind is enough to parse template
# argument lists and call argument lists. Both are heuristics over masked text, not a parser.
# --------------------------------------------------------------------------------------------

_OPEN = {"(": ")", "<": ">", "[": "]", "{": "}"}
_CLOSE = {v: k for k, v in _OPEN.items()}


def find_matching(text: str, open_idx: int) -> int | None:
    """Return the index of the bracket matching text[open_idx], or None if unbalanced."""
    open_ch = text[open_idx]
    close_ch = _OPEN[open_ch]
    depth = 0
    i = open_idx
    n = len(text)
    while i < n:
        c = text[i]
        if c == open_ch:
            depth += 1
        elif c == close_ch:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return None


def split_top_level(text: str, sep: str = ",") -> list[str]:
    """Split `text` on `sep`, ignoring any `sep` nested inside (), <>, [] or {}."""
    parts: list[str] = []
    depth = 0
    start = 0
    for i, c in enumerate(text):
        if c in _OPEN:
            depth += 1
        elif c in _CLOSE:
            depth -= 1
        elif c == sep and depth == 0:
            parts.append(text[start:i])
            start = i + 1
    parts.append(text[start:])
    return parts


# --------------------------------------------------------------------------------------------
# Scope scanner: one pass of brace matching over a masked file, classifying each `{...}` block
# as a class/struct body, a function body (with its name, and its owning class if it is an
# out-of-class member definition `Class::method(...)`), or an anonymous/transparent block
# (if/for/while/switch/lambda/namespace bodies, which do not themselves gate declaring scope).
# --------------------------------------------------------------------------------------------


@dataclass
class FunctionScope:
    name: str  # bare function/operator name, e.g. "operator<", "sort_by_z"
    owner: str | None  # the class name for a member function, else None
    file: str  # path relative to LIBSLIC3R_ROOT
    sig_start: int  # start of the signature (return type through the parameter list)
    start: int  # start of the body (just after the opening `{`)
    end: int
    start_line: int


@dataclass
class ClassScope:
    name: str
    file: str
    start: int
    end: int


_CLASS_HEADER_RE = re.compile(r"\b(?:class|struct)\s+(\w+)(?:\s+final)?\s*(?::[^{]*)?$")
# A function header: `... name ( params ) [const] [noexcept(...)] [override|final] [: init...]`.
# We find the LAST top-level `(...)` in the header and read the identifier right before it: an
# operator name (`operator<`, `operator()`, ...), optionally qualified by its owning class, or a
# plain name, likewise optionally qualified.
_OPERATOR_TAIL_RE = re.compile(r"(?:([A-Za-z_]\w*)\s*::\s*)?operator\s*(<=|>=|<|>|\(\)|\[\])\s*$")
_PLAIN_NAME_TAIL_RE = re.compile(r"(?:([A-Za-z_]\w*)\s*::\s*)?([A-Za-z_~]\w*)\s*$")


def classify_header(header: str) -> tuple[str, str | None, str | None]:
    """Classify the text immediately before a `{`.

    Returns (kind, name, owner) where kind is "class", "function" or "other". `name` is the
    class name or the function/operator name; `owner` is the owning class of a member function
    defined out of class (`Class::method`), else None.
    """
    h = header.strip()
    if not h:
        return "other", None, None
    m = _CLASS_HEADER_RE.search(h)
    if m:
        return "class", m.group(1), None
    # Function: the header must end with `)` possibly followed by const/noexcept/override/final
    # and/or an initializer list `: a(...), b(...)`. Strip a trailing initializer list first (it
    # can itself contain parens, so strip from the first top-level `:` after the parameter list).
    stripped = h
    paren_positions = [i for i, c in enumerate(stripped) if c == "("]
    last_open = None
    for i in paren_positions:
        end = find_matching(stripped, i)
        if end is not None:
            last_open, last_close = i, end
    if last_open is None:
        return "other", None, None
    before = stripped[:last_open]
    after = stripped[last_close + 1 :]
    # `after` must look like specifiers/initializer-list only, no stray `{`/`;` (masking already
    # removed strings/comments, so this is a reasonably safe check).
    if "{" in after or ";" in after:
        return "other", None, None
    om = _OPERATOR_TAIL_RE.search(before)
    if om:
        owner, op = om.group(1), om.group(2)
        return "function", "operator" + op, owner
    pm = _PLAIN_NAME_TAIL_RE.search(before)
    if not pm:
        return "other", None, None
    owner, fname = pm.group(1), pm.group(2)
    # Reject common control-flow / keyword false positives that can precede a `(...)`.
    if fname in {"if", "for", "while", "switch", "catch", "return", "sizeof", "static_assert"}:
        return "other", None, None
    return "function", fname, owner


def scan_file(path: str, masked: str) -> tuple[list[FunctionScope], list[ClassScope]]:
    """Brace-match `masked`, returning every function scope and every class/struct scope."""
    functions: list[FunctionScope] = []
    classes: list[ClassScope] = []
    offsets = line_index(masked)
    # (kind, name, owner, sig_start, body_start)
    stack: list[tuple[str, str | None, str | None, int, int]] = []
    last_stmt_end = 0
    i = 0
    n = len(masked)
    while i < n:
        c = masked[i]
        if c == "{":
            header = masked[last_stmt_end:i]
            kind, name, owner = classify_header(header)
            if kind == "function" and owner is None:
                # An inline member function's header carries no `Class::` qualifier (that form
                # is only for a definition out of class), so its owner is the nearest enclosing
                # class/struct scope already on the stack, if any.
                for s_kind, s_name, *_ in reversed(stack):
                    if s_kind == "class":
                        owner = s_name
                        break
            stack.append((kind, name, owner, last_stmt_end, i + 1))
            last_stmt_end = i + 1
        elif c == "}":
            if stack:
                kind, name, owner, sig_start, start = stack.pop()
                end = i
                if kind == "function" and name is not None:
                    functions.append(
                        FunctionScope(
                            name=name, owner=owner, file=path, sig_start=sig_start, start=start, end=end, start_line=line_of(offsets, start)
                        )
                    )
                elif kind == "class" and name is not None:
                    classes.append(ClassScope(name=name, file=path, start=start, end=end))
            last_stmt_end = i + 1
        elif c == ";":
            last_stmt_end = i + 1
        i += 1
    return functions, classes


def enclosing_scope(pos: int, functions: list[FunctionScope], classes: list[ClassScope]) -> tuple[str, str, str]:
    """Return (kind, name, owner_or_empty) of the innermost scope containing `pos`.

    kind is "function", "class" or "file"; a bare "file" scope means pos is not inside any
    recognised function or class body (e.g. a file-scope static/global declaration).
    """
    best: tuple[str, str, str, int] | None = None  # (kind, name, owner, size)
    for f in functions:
        # sig_start, not start: a parameter declared by reference in the signature is "a
        # function it is passed to by reference" (the task's own words for the container rule),
        # so it must resolve to this function, not fall through to file scope.
        if f.sig_start <= pos < f.end:
            size = f.end - f.sig_start
            if best is None or size < best[3]:
                best = ("function", f.name, f.owner or "", size)
    for cl in classes:
        if cl.start <= pos < cl.end:
            size = cl.end - cl.start
            if best is None or size < best[3]:
                best = ("class", cl.name, "", size)
    if best is None:
        return "file", "<file scope>", ""
    return best[0], best[1], best[2]


# --------------------------------------------------------------------------------------------
# Container audit.
# --------------------------------------------------------------------------------------------

CONTAINER_TYPE_RE = re.compile(
    r"(std::unordered_(?:map|set|multimap|multiset)"
    r"|boost::unordered_[a-z_]+"
    r"|ankerl::unordered_dense::(?:map|set)"
    r"|tbb::concurrent_unordered_(?:map|set))\b"
)

MAP_KINDS = {"std::unordered_map", "std::unordered_multimap", "ankerl::unordered_dense::map", "tbb::concurrent_unordered_map"}
SET_KINDS = {"std::unordered_set", "std::unordered_multiset", "ankerl::unordered_dense::set", "tbb::concurrent_unordered_set"}

_DECLARATOR_NAME_RE = re.compile(r"([A-Za-z_]\w*)\s*(?:\[[^\]]*\]\s*)*$")

LOOKUP_METHODS = r"find|count|contains|at|insert|emplace(?:_hint)?|erase|size|empty|clear"
ALGORITHM_NAMES = (
    r"std::sort|std::stable_sort|std::partial_sort|std::nth_element|std::accumulate|"
    r"std::for_each|std::transform|std::copy|std::count_if|std::find_if|std::all_of|"
    r"std::any_of|std::none_of|std::max_element|std::min_element|std::reduce|"
    r"std::transform_reduce|tbb::parallel_for|tbb::parallel_for_each|tbb::parallel_reduce|"
    r"boost::accumulate"
)


@dataclass
class ContainerDecl:
    file: str
    line: int
    pos: int
    type_name: str
    var_name: str | None  # None when the declarator could not be parsed (reported undecided)


def find_container_decls(path: str, masked: str, offsets: list[int]) -> list[ContainerDecl]:
    """Find every unordered-container variable declaration in `masked`."""
    decls: list[ContainerDecl] = []
    for m in CONTAINER_TYPE_RE.finditer(masked):
        type_name = m.group(1)
        # Skip a type alias (`using X = std::unordered_map<...>;` / `typedef ... X;`): it names
        # no container instance, so there is nothing to classify. Look back to the nearest
        # preceding statement boundary for a `using`/`typedef` keyword on the same statement.
        stmt_start = max(masked.rfind(";", 0, m.start()), masked.rfind("{", 0, m.start()), masked.rfind("}", 0, m.start())) + 1
        if re.search(r"\b(?:using|typedef)\b", masked[stmt_start : m.start()]):
            continue
        after_type = m.end()
        # Only a declaration if the type name is directly followed by a template arg list.
        j = after_type
        while j < len(masked) and masked[j] in " \t":
            j += 1
        if j >= len(masked) or masked[j] != "<":
            continue
        close = find_matching(masked, j)
        if close is None:
            continue
        # Declarator: from just after `>` to the next top-level `;`, `,`, `(` or `{`.
        k = close + 1
        depth = 0
        decl_end = None
        while k < len(masked):
            c = masked[k]
            if c in "([{":
                depth += 1
            elif c in ")]}":
                if depth == 0:
                    break
                depth -= 1
            elif c in ";," and depth == 0:
                decl_end = k
                break
            k += 1
        if decl_end is None:
            decl_end = k
        declarator = masked[close + 1 : decl_end]
        # A function *definition* whose return type or parameter is this container type has a
        # `{` body in `declarator` (its own brace-balance already consumed by the depth counter
        # above); that is not a variable declaration, so skip it entirely -- there is nothing to
        # audit at a site that is not a declaration.
        if "{" in declarator:
            continue
        # The declarator may be a bare name (`Type v;`) or a direct-init constructor call
        # (`Type v(first, last);`); either way the variable name is the identifier right before
        # the first `(`, if any, else the trailing identifier of the whole declarator.
        name_source = declarator.split("(", 1)[0]
        nm = _DECLARATOR_NAME_RE.search(name_source)
        if not nm or nm.group(1) in {"typedef", "using", "static", "const", "constexpr"}:
            # The declarator parse failed to find a plausible variable name (an unusual
            # declarator form this heuristic doesn't cover). Conservatively undecided rather
            # than silently dropped: `var_name=None` skips straight to that verdict below.
            decls.append(ContainerDecl(file=path, line=line_of(offsets, m.start()), pos=m.start(), type_name=type_name, var_name=None))
            continue
        var_name = nm.group(1)
        decls.append(ContainerDecl(file=path, line=line_of(offsets, m.start()), pos=m.start(), type_name=type_name, var_name=var_name))
    return decls


def classify_container_usage(var_name: str, search_text: str) -> tuple[str, str, int | None]:
    """Classify every occurrence of `var_name` in `search_text`.

    Returns (verdict, reason, line_offset_of_evidence) where verdict is "iterated",
    "looked_up" or "undecided", `reason` is a short fixed phrase (no raw source text, so a `|`
    in source code can never break the Markdown table), and `line_offset_of_evidence` is the
    character offset of the usage that decided it (for the "iteration path:line" cell), or None
    when there is none (the looked-up and the no-usage-found undecided cases).
    """
    name_re = re.escape(var_name)
    occ_re = re.compile(r"\b" + name_re + r"\b")
    range_for_re = re.compile(r"for\s*\([^;)]*:\s*" + name_re + r"\s*\)")
    begin_end_re = re.compile(
        r"(?:" + name_re + r"\s*\.\s*(?:begin|end|cbegin|cend)\s*\(|(?:std::)?(?:begin|end|cbegin|cend)\s*\(\s*" + name_re + r"\s*\))"
    )
    algo_re = re.compile(r"(?:" + ALGORITHM_NAMES + r")\s*\([^;]*\b" + name_re + r"\b")
    lookup_re = re.compile(name_re + r"\s*(?:\.\s*(?:" + LOOKUP_METHODS + r")\s*\(|\[)")

    saw_any = False
    saw_unknown = False
    first_iter_pos: int | None = None
    first_iter_reason: str | None = None
    for occ in occ_re.finditer(search_text):
        saw_any = True
        pos = occ.start()
        window_start = max(0, pos - 120)
        window_end = min(len(search_text), pos + 120)
        window = search_text[window_start:window_end]
        if range_for_re.search(window):
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = pos, "range-for over the container"
            continue
        if begin_end_re.search(window):
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = pos, "begin()/end() (or cbegin()/cend()) called on the container"
            continue
        if algo_re.search(window):
            if first_iter_pos is None:
                first_iter_pos, first_iter_reason = pos, "handed to an algorithm or a reduction"
            continue
        if lookup_re.match(search_text, pos) or lookup_re.search(search_text[max(0, pos - 2) : pos + 40]):
            continue
        saw_unknown = True

    if first_iter_pos is not None:
        return "iterated", first_iter_reason or "iterated", first_iter_pos
    if saw_any and not saw_unknown:
        return "looked_up", "every use is find/count/contains/at/insert/emplace/erase/size/empty/clear", None
    return "undecided", "classification undecided: no recognised iterating or lookup-only use found", None


# --------------------------------------------------------------------------------------------
# Comparator audit.
# --------------------------------------------------------------------------------------------

COMPARATOR_OPERATORS = {"operator<", "operator<=", "operator>"}

TIE_SHAPE_RE = re.compile(r"return\s+std::tie\([^;]*\)\s*<\s*std::tie\([^;]*\)\s*;?\s*$")
SINGLE_FIELD_RE = re.compile(r"^return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")
IF_CHAIN_STEP = r"if\s*\(\s*[\w.\->()]+\s*!=\s*[\w.\->()]+\s*\)\s*return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;\s*"
IF_CHAIN_RE = re.compile(r"^(?:" + IF_CHAIN_STEP + r")+return\s+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")
TERNARY_STEP = r"[\w.\->()]+\s*!=\s*[\w.\->()]+\s*\?\s*[\w.\->()]+\s*<\s*[\w.\->()]+\s*:\s*"
TERNARY_CHAIN_RE = re.compile(r"^return\s+(?:" + TERNARY_STEP + r")+[\w.\->()]+\s*<\s*[\w.\->()]+\s*;?\s*$")

NON_STRICT_RE = re.compile(r"return\b[^;{}]*?(<=|>=)[^;{}]*?;")
TOLERANCE_RE = re.compile(r"\bEPSILON\b|\b(?:std::)?(?:fabs|abs)\s*\(")
DISJUNCTION_RE = re.compile(r"return\b[^;{}]*<[^;{}]*\|\|[^;{}]*<[^;{}]*;")

# The comparator surface also includes operator>, so a single `return X > Y;` (the common
# max-heap-style idiom, e.g. a priority_queue's Compare functor, or `this->field > other.field`)
# must be recognised as a clean total order too, not left undecided just because every other
# clean-shape pattern looks for `<`. A bare `>` -- the real comparator, not the `->` of a
# ubiquitous `this->field`/`obj->field` access, and not a `>=` -- is one not immediately preceded
# by `-` and not immediately followed by `=`.
_BARE_GT_RE = re.compile(r"(?<!-)>(?!=)")


def is_single_gt_compare(expr: str) -> bool:
    """True when `expr` (a `return` statement's expression, `;` already stripped) is a single,
    unparenthesized `A > B` and nothing else -- no `&&`/`||` (which would mean more than one
    comparison is involved) and exactly one bare `>` in the whole expression."""
    if "&&" in expr or "||" in expr:
        return False
    return len(_BARE_GT_RE.findall(expr)) == 1

_FIELD_EXPR = r"[\w.\->()\[\]]+"
_SINGLE_LT_RE = re.compile(r"^" + _FIELD_EXPR + r"\s*<\s*" + _FIELD_EXPR + r"$")
_GUARD_HEAD_RE = re.compile(r"^" + _FIELD_EXPR + r"\s*<\s*" + _FIELD_EXPR + r"\s*\|\|\s*\(")
_GUARD_INNER_RE = re.compile(r"^(" + _FIELD_EXPR + r")\s*==\s*(" + _FIELD_EXPR + r")\s*&&\s*(.*)$", re.DOTALL)


def is_lexicographic_or_chain(expr: str) -> bool:
    """True when `expr` is `F < F`, or the short-circuited chain `F < F || (F == F && ...)`.

    This is the common pre-``std::tie`` lexicographic-compare idiom (e.g.
    ``a.x < b.x || (a.x == b.x && a.y < b.y)``): textually it contains a `<` ... `||` ... `<`,
    the same shape ``DISJUNCTION_RE`` looks for, but the second comparison is only reached when
    the first pair compares equal, so it is a proper nested lexicographic chain over the fields
    in order, not two independently-orderable fields. ``classify_comparator_shape`` checks this
    *before* ``DISJUNCTION_RE`` so this idiom is recognised as a clean total order instead of a
    false-positive "disjunction". Recursion (via `find_matching`, so a mismatched guard can never
    recurse past the string it was given) accepts a chain of any depth.
    """
    expr = expr.strip()
    if _SINGLE_LT_RE.match(expr):
        return True
    head = _GUARD_HEAD_RE.match(expr)
    if not head:
        return False
    open_paren = head.end() - 1  # the "(" the pattern itself ends on, not any "(" in a.getX()
    close_paren = find_matching(expr, open_paren)
    if close_paren is None or close_paren != len(expr) - 1:
        return False
    inner = expr[open_paren + 1 : close_paren].strip()
    m = _GUARD_INNER_RE.match(inner)
    if not m:
        return False
    return is_lexicographic_or_chain(m.group(3))

ORDER_ALGO_MIN_ARGS = {
    "std::sort": 2,
    "std::stable_sort": 2,
    "std::partial_sort": 3,
    "std::nth_element": 3,
    "std::lower_bound": 3,
    "std::upper_bound": 3,
    "std::binary_search": 3,
    "std::max_element": 2,
    "std::min_element": 2,
}
ORDER_ALGO_RE = re.compile(r"\b(" + "|".join(re.escape(k) for k in ORDER_ALGO_MIN_ARGS) + r")\s*\(")

ORDERED_CONTAINER_TEMPLATE_RE = re.compile(r"\b(std::map|std::multimap|std::set|std::multiset|std::priority_queue)\b")
# Fixed positions of the Compare argument for each ordered-container template.
COMPARE_ARG_INDEX = {
    "std::map": 2,
    "std::multimap": 2,
    "std::set": 1,
    "std::multiset": 1,
    "std::priority_queue": 2,
}
DEFAULT_COMPARE_RE = re.compile(r"^\s*std::(?:less|greater)\b")


def classify_comparator_shape(body: str) -> tuple[str | None, str]:
    """Classify a comparator body.

    Returns (shape, reason). shape is one of "disjunction", "non_strict", "tolerance" (a
    not-a-total-order shape, in that priority order), None (recognised as a clean total order,
    so not reported), or "undecided" (reported, conservatively, as not a total order).
    """
    normalized = re.sub(r"\s+", " ", body).strip()
    ret_m = re.match(r"^return\s+(.*)$", normalized)
    if ret_m:
        expr = ret_m.group(1).rstrip()
        if expr.endswith(";"):
            expr = expr[:-1].rstrip()
        if is_lexicographic_or_chain(expr):
            return None, "recognised total-order shape (short-circuited lexicographic OR chain)"
        if is_single_gt_compare(expr):
            return None, "recognised total-order shape (single > comparison)"
    if DISJUNCTION_RE.search(normalized):
        return "disjunction", "a disjunction of < over different fields: two distinct elements can each compare less than the other"
    if NON_STRICT_RE.search(normalized):
        return "non_strict", "the top-level return uses <= or >=: equal elements compare true"
    if TOLERANCE_RE.search(normalized):
        return "tolerance", "the comparison goes through a tolerance or EPSILON: the relation is non-transitive"
    if (
        TIE_SHAPE_RE.search(normalized)
        or SINGLE_FIELD_RE.match(normalized)
        or IF_CHAIN_RE.match(normalized)
        or TERNARY_CHAIN_RE.match(normalized)
    ):
        return None, "recognised total-order shape"
    return "undecided", "classification undecided: the body matches none of the recognised total-order or non-total-order shapes"


def repo_path_line(path: str, line: int) -> str:
    return f"{LIBSLIC3R_PREFIX}{path}:{line}"


# --------------------------------------------------------------------------------------------
# Port's choice and the diverges rule: explicit, named branches (see module docstring).
# --------------------------------------------------------------------------------------------


def container_port_choice(type_name: str, verdict: str) -> str:
    """The fixed mapping from a container's classification to the port's choice."""
    if verdict == "looked_up":
        return "same container kind, no ordering guarantee"
    # verdict is "iterated" or "undecided" (reported conservatively as iterated).
    if type_name in MAP_KINDS:
        return "insertion-ordered map"
    if type_name in SET_KINDS:
        return "insertion-ordered set"
    raise AssertionError(f"unrecognised container type {type_name!r}")


def comparator_port_choice(shape: str) -> str:
    """The fixed mapping from a comparator's matched shape to the port's choice."""
    if shape == "disjunction":
        return "nested lexicographic chain over the same fields in the same order"
    if shape == "non_strict":
        return "the strict form of the same relation"
    if shape == "tolerance":
        return "the same comparison with the tolerance removed; the row's tier decides equality"
    if shape == "undecided":
        return "total-order comparator"
    raise AssertionError(f"unrecognised comparator shape {shape!r}")


def diverges(port_choice: str) -> tuple[str, str]:
    """Whether `port_choice` differs from the oracle's relation or iteration order.

    `yes` for every mapping except two named exceptions: a looked-up-only container (the port
    keeps the same container kind with no ordering guarantee, because its order never reaches
    output -- this branch is never reached by a row this script emits, since a looked-up-only
    container is never written to the report), and a non-strict-shaped comparator whose relation
    is already, in fact, strict despite the textual shape -- which a static script has no way to
    establish, so that branch is documented here but never taken: no code path below returns
    "no" for it.

    This script never attempts to decide whether a given site's order reaches compared output
    (a dynamic question a static audit cannot answer), so every row it emits carries that
    undecided note in its reason.
    """
    if port_choice == "same container kind, no ordering guarantee":
        return "no", "the container is only looked up; its order never reaches output"
    return "yes", "reaches-output undecided: this script does not establish whether this site's order reaches compared output"


# --------------------------------------------------------------------------------------------
# Markdown table writer.
# --------------------------------------------------------------------------------------------


def write_table(path: Path, header: list[str], rows: list[list[str]]) -> None:
    lines = ["| " + " | ".join(header) + " |", "| " + " | ".join(["---"] * len(header)) + " |"]
    for row in rows:
        lines.append("| " + " | ".join(row) + " |")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")


def escape_cell(text: str) -> str:
    """Escape a cell so raw source text (which may carry `|`) can never break a Markdown row."""
    return text.replace("|", "\\|").replace("\n", " ")


# --------------------------------------------------------------------------------------------
# Main pass.
# --------------------------------------------------------------------------------------------


def run(manifest_path: Path) -> tuple[list[list[str]], list[list[str]]]:
    paths = in_scope_paths(manifest_path)

    file_text: dict[str, str] = {}
    file_masked: dict[str, str] = {}
    file_offsets: dict[str, list[int]] = {}
    all_functions: list[FunctionScope] = []
    all_classes: list[ClassScope] = []
    functions_by_owner: dict[str, list[FunctionScope]] = {}
    functions_by_name: list[FunctionScope] = []

    for rel in paths:
        abspath = LIBSLIC3R_ROOT / rel
        text = abspath.read_text(encoding="utf-8", errors="replace")
        masked = mask_source(text)
        file_text[rel] = text
        file_masked[rel] = masked
        file_offsets[rel] = line_index(masked)
        funcs, classes = scan_file(rel, masked)
        all_functions.extend(funcs)
        all_classes.extend(classes)
        for f in funcs:
            if f.owner:
                functions_by_owner.setdefault(f.owner, []).append(f)
            else:
                functions_by_name.append(f)

    functions_by_file: dict[str, list[FunctionScope]] = {}
    classes_by_file: dict[str, list[ClassScope]] = {}
    for f in all_functions:
        functions_by_file.setdefault(f.file, []).append(f)
    for c in all_classes:
        classes_by_file.setdefault(c.file, []).append(c)

    # -------------------------------------------------------------------------------------
    # Containers.
    # -------------------------------------------------------------------------------------
    container_rows: list[tuple[str, int, list[str]]] = []
    seen_container_keys: set[tuple[str, int, str]] = set()
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        funcs = functions_by_file.get(rel, [])
        classes = classes_by_file.get(rel, [])
        for decl in find_container_decls(rel, masked, offsets):
            pos = decl.pos
            key = (rel, decl.line, decl.var_name)
            if key in seen_container_keys:
                continue

            if decl.var_name is None:
                # The declarator could not be parsed to a variable name at all (see
                # find_container_decls); there is no name to search usages for, so this is
                # conservatively undecided with no scope or iteration site to report.
                seen_container_keys.add(key)
                choice = container_port_choice(decl.type_name, "undecided")
                div, div_reason = diverges(choice)
                reason_cell = "classification undecided: the declarator could not be parsed to find a variable name; " + div_reason
                container_rows.append(
                    (
                        rel,
                        decl.line,
                        [
                            repo_path_line(rel, decl.line),
                            decl.type_name,
                            "<unparsed declarator>",
                            "n/a",
                            escape_cell(reason_cell),
                            choice,
                            div,
                        ],
                    )
                )
                continue

            scope_kind, scope_name, owner = enclosing_scope(pos, funcs, classes)
            # `segments`: every (file, base_offset, masked_text) span this declaration's uses
            # could appear in -- just the declaring function's own body for a local variable,
            # but every method of the class (inline or defined in another in-scope file via
            # `Class::method`) for a data member, since "the scope that declares it" extends to
            # the whole class for a member (see the task's container rule).
            if scope_kind == "function":
                fn_slice = funcs_start_end(funcs, pos)
                segments = [(rel, fn_slice.start, masked[fn_slice])]
                declaring_scope = scope_name if not owner else f"{owner}::{scope_name}"
            elif scope_kind == "class":
                segments = [(rel, c.start, masked[c.start : c.end]) for c in classes if c.name == scope_name and c.file == rel]
                segments.extend((mf.file, mf.start, file_masked[mf.file][mf.start : mf.end]) for mf in functions_by_owner.get(scope_name, []))
                declaring_scope = scope_name
            else:
                segments = [(rel, 0, masked)]
                declaring_scope = "<file scope>"

            combined_parts: list[str] = []
            boundaries: list[tuple[int, str, int]] = []  # (combined_start, file, base_offset)
            cursor = 0
            for seg_file, seg_base, seg_text in segments:
                boundaries.append((cursor, seg_file, seg_base))
                combined_parts.append(seg_text)
                cursor += len(seg_text) + 1  # +1 for the "\n" join separator below
            search_text = "\n".join(combined_parts)

            verdict, reason, evidence_pos = classify_container_usage(decl.var_name, search_text)
            if verdict == "looked_up":
                continue  # only iterated (incl. undecided) containers are rows in this report.
            seen_container_keys.add(key)

            if evidence_pos is not None:
                starts = [b[0] for b in boundaries]
                seg_idx = bisect.bisect_right(starts, evidence_pos) - 1
                seg_start, seg_file, seg_base = boundaries[seg_idx]
                iter_line = line_of(file_offsets[seg_file], seg_base + (evidence_pos - seg_start))
                iter_path_line = repo_path_line(seg_file, iter_line)
            else:
                iter_path_line = "n/a"

            choice = container_port_choice(decl.type_name, verdict)
            div, div_reason = diverges(choice)
            reason_cell = reason + "; " + div_reason
            container_rows.append(
                (
                    rel,
                    decl.line,
                    [
                        repo_path_line(rel, decl.line),
                        decl.type_name,
                        declaring_scope,
                        iter_path_line,
                        escape_cell(reason_cell),
                        choice,
                        div,
                    ],
                )
            )

    container_rows.sort(key=lambda r: (r[0], r[1], r[2]))
    container_table = [row for _, _, row in container_rows]

    # -------------------------------------------------------------------------------------
    # Comparators.
    # -------------------------------------------------------------------------------------
    comparator_rows: list[tuple[str, int, list[str]]] = []
    seen_comparator_keys: set[tuple[str, int, str, str, int]] = set()

    def emit_comparator(
        comp_file: str, comp_line: int, reach: str, use_file: str, use_line: int, shape: str, reason: str
    ) -> None:
        """Record one comparator row. `comp_*` is the comparator's own site (cell 1); `use_*` is
        the site named in cell 2's "how it reaches an ordering" (the same site as `comp_*` for a
        definition or an inline lambda, but the call site or container declaration for a
        comparator resolved from elsewhere)."""
        key = (comp_file, comp_line, reach, use_file, use_line)
        if key in seen_comparator_keys:
            return
        seen_comparator_keys.add(key)
        choice = comparator_port_choice(shape)
        div, div_reason = diverges(choice)
        comparator_rows.append(
            (
                comp_file,
                comp_line,
                [
                    repo_path_line(comp_file, comp_line),
                    reach,
                    repo_path_line(use_file, use_line),
                    shape,
                    escape_cell(reason + "; " + div_reason),
                    choice,
                    div,
                ],
            )
        )

    # Reach A: operator< / operator<= / operator> definitions. The comparator's own site and the
    # "use" are the same place: the definition is what a standard algorithm invokes directly.
    for f in all_functions:
        if f.name not in COMPARATOR_OPERATORS:
            continue
        body = file_masked[f.file][f.start : f.end]
        shape, reason = classify_comparator_shape(body)
        if shape is None:
            continue
        emit_comparator(f.file, f.start_line, "definition", f.file, f.start_line, shape, reason)

    # Reach B: the Compare template argument of an ordered container.
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        for m in ORDERED_CONTAINER_TEMPLATE_RE.finditer(masked):
            kind = m.group(1)
            j = m.end()
            while j < len(masked) and masked[j] in " \t":
                j += 1
            if j >= len(masked) or masked[j] != "<":
                continue
            close = find_matching(masked, j)
            if close is None:
                continue
            args = split_top_level(masked[j + 1 : close])
            idx = COMPARE_ARG_INDEX[kind]
            if len(args) <= idx:
                continue
            cmp_arg = args[idx].strip()
            if not cmp_arg or DEFAULT_COMPARE_RE.match(cmp_arg):
                continue
            line = line_of(offsets, m.start())
            cmp_name = cmp_arg.split("<")[0].strip().rsplit("::", 1)[-1]
            candidates = functions_by_owner.get(cmp_name, [])
            op_funcs = [f for f in candidates if f.name == "operator()" or f.name in COMPARATOR_OPERATORS]
            if not op_funcs:
                emit_comparator(
                    rel,
                    line,
                    "container Compare argument",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator type {cmp_name!r}'s body is not found among the in-scope files",
                )
                continue
            for f in op_funcs:
                body = file_masked[f.file][f.start : f.end]
                shape, reason = classify_comparator_shape(body)
                if shape is None:
                    continue
                emit_comparator(f.file, f.start_line, "container Compare argument", rel, line, shape, reason)

    # Reach C: the comparator passed at an ordering-algorithm call site.
    LAMBDA_HEAD_RE = re.compile(r"^\[[^\]]*\]\s*\([^)]*\)\s*(?:->\s*[\w:<>, ]+\s*)?\{")
    for rel in paths:
        masked = file_masked[rel]
        offsets = file_offsets[rel]
        for m in ORDER_ALGO_RE.finditer(masked):
            algo = m.group(1)
            open_paren = m.end() - 1
            close_paren = find_matching(masked, open_paren)
            if close_paren is None:
                continue
            args = split_top_level(masked[open_paren + 1 : close_paren])
            if len(args) <= ORDER_ALGO_MIN_ARGS[algo]:
                continue  # no comparator argument supplied; uses the default std::less.
            last_arg_raw = args[-1]
            cmp_arg = last_arg_raw.strip()
            line = line_of(offsets, m.start())
            lam = LAMBDA_HEAD_RE.match(cmp_arg)
            if lam:
                # Offsets below are into `masked` and must use the *unstripped* arg text's own
                # length (from split_top_level) to stay aligned; `cmp_arg` is only for matching.
                last_arg_start = open_paren + 1 + sum(len(a) + 1 for a in args[:-1])
                brace_rel = last_arg_raw.find("{")
                abs_open = last_arg_start + brace_rel
                abs_close = find_matching(masked, abs_open)
                lambda_line = line_of(offsets, abs_open)
                # Interior only (no braces), matching the convention FunctionScope bodies use,
                # since classify_comparator_shape's patterns are anchored to a bare `return ...`.
                body = masked[abs_open + 1 : abs_close] if abs_close is not None else cmp_arg
                shape, reason = classify_comparator_shape(body)
                if shape is None:
                    continue
                # The lambda is defined at the call site, so comparator site == use site.
                emit_comparator(rel, lambda_line, "call-site comparator", rel, line, shape, reason)
                continue
            fname = cmp_arg.rsplit("::", 1)[-1].strip()
            if not re.fullmatch(r"[A-Za-z_]\w*", fname):
                # Not a lambda and not a plain identifier (a bind expression, a functor instance,
                # a qualified template name, ...): this parse cannot resolve the comparator, so
                # report it conservatively as not a total order rather than drop it.
                emit_comparator(
                    rel,
                    line,
                    "call-site comparator",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator expression {cmp_arg!r} passed to {algo} is not a lambda or a plain name this parse resolves",
                )
                continue
            named = [f for f in functions_by_name if f.name == fname]
            if not named:
                emit_comparator(
                    rel,
                    line,
                    "call-site comparator",
                    rel,
                    line,
                    "undecided",
                    f"classification undecided: the comparator {fname!r} passed to {algo} is not found among the in-scope files",
                )
                continue
            for f in named:
                body = file_masked[f.file][f.start : f.end]
                shape, reason = classify_comparator_shape(body)
                if shape is None:
                    continue
                emit_comparator(f.file, f.start_line, "call-site comparator", rel, line, shape, reason)

    comparator_rows.sort(key=lambda r: (r[0], r[1], r[2]))
    comparator_table = [row for _, _, row in comparator_rows]

    return container_table, comparator_table


def funcs_start_end(funcs: list[FunctionScope], pos: int) -> slice:
    """Return the (signature-through-body) slice of the innermost function containing `pos`.

    Starting at `sig_start` (not `start`, the body) means a parameter declaration is included in
    the search text along with the body, consistent with `enclosing_scope` using the same span.
    """
    best: FunctionScope | None = None
    for f in funcs:
        if f.sig_start <= pos < f.end:
            if best is None or (f.end - f.sig_start) < (best.end - best.sig_start):
                best = f
    if best is None:
        return slice(0, 0)
    return slice(best.sig_start, best.end)


@click.command()
def main() -> None:
    """Regenerate port/reports/order-containers.md and port/reports/order-comparators.md."""
    container_table, comparator_table = run(MANIFEST_PATH)

    write_table(
        CONTAINERS_REPORT,
        ["declaration", "container type", "declaring scope", "iteration", "reason", "port's choice", "diverges"],
        container_table,
    )
    write_table(
        COMPARATORS_REPORT,
        ["comparator", "reach", "use", "shape", "reason", "port's choice", "diverges"],
        comparator_table,
    )
    click.echo(f"{CONTAINERS_REPORT.relative_to(REPO_ROOT)}: {len(container_table)} rows")
    click.echo(f"{COMPARATORS_REPORT.relative_to(REPO_ROOT)}: {len(comparator_table)} rows")


if __name__ == "__main__":
    main()
