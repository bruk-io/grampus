# --self-test
# --------------------------------------------------------------------------------------------


def _selftest_source2() -> list[str]:
    """Source 2's two rules: an absent `crates/` contributes zero rows (not an error), and a
    marker under a present tree produces exactly one row per marker."""
    failures = []
    absent_dir = SELFTEST_ROOT / "sources-absent" / "crates"
    rows = fidelity_marker_rows(absent_dir)
    if rows:
        failures.append(f"fidelity-marker: expected 0 rows for an absent {absent_dir}, got {rows!r}")

    present_dir = SELFTEST_ROOT / "sources-present" / "crates"
    rows = fidelity_marker_rows(present_dir)
    if len(rows) != 1:
        failures.append(f"fidelity-marker: expected 1 row for {present_dir}, got {rows!r}")
    elif rows[0][0] != "fidelity-marker":
        failures.append(f"fidelity-marker: expected source cell 'fidelity-marker', got {rows[0]!r}")
    return failures


def _selftest_tsv_sources() -> list[str]:
    """Sources 3 and 4's two rules: an absent file contributes zero rows (not an error), a
    present file with every required column contributes its matching rows, and a present file
    missing a required column raises (the "present but unreadable is a failure" rule)."""
    failures = []

    absent_dir = SELFTEST_ROOT / "sources-absent"
    rows, present = read_tsv_source(
        absent_dir / "oracle-parity.tsv", ORACLE_PARITY_REQUIRED, _oracle_parity_predicate, _oracle_parity_row
    )
    if present or rows:
        failures.append(f"oracle-parity: expected absent/0 rows for a missing file, got present={present} rows={rows!r}")
    rows, present = read_tsv_source(
        absent_dir / "determinism.tsv", DETERMINISM_REQUIRED, _determinism_predicate, _determinism_row
    )
    if present or rows:
        failures.append(f"determinism: expected absent/0 rows for a missing file, got present={present} rows={rows!r}")

    present_dir = SELFTEST_ROOT / "sources-present"
    rows, present = read_tsv_source(
        present_dir / "oracle-parity.tsv", ORACLE_PARITY_REQUIRED, _oracle_parity_predicate, _oracle_parity_row
    )
    if not present or len(rows) != 1:
        failures.append(f"oracle-parity: expected present/1 row for {present_dir}, got present={present} rows={rows!r}")
    rows, present = read_tsv_source(
        present_dir / "determinism.tsv", DETERMINISM_REQUIRED, _determinism_predicate, _determinism_row
    )
    if not present or len(rows) != 1:
        failures.append(f"determinism: expected present/1 row for {present_dir}, got present={present} rows={rows!r}")

    for fixture, required, predicate, builder, bad_column in (
        ("renamed-level-reached", ORACLE_PARITY_REQUIRED, _oracle_parity_predicate, _oracle_parity_row, "level reached"),
        ("renamed-normative-oracle", ORACLE_PARITY_REQUIRED, _oracle_parity_predicate, _oracle_parity_row, "normative oracle"),
    ):
        path = SELFTEST_ROOT / fixture / "oracle-parity.tsv"
        try:
            read_tsv_source(path, required, predicate, builder)
            failures.append(f"{fixture}: expected SystemExit naming {bad_column!r}, got no error")
        except SystemExit as exc:
            if bad_column not in str(exc):
                failures.append(f"{fixture}: expected the error to name {bad_column!r}, got {exc}")

    path = SELFTEST_ROOT / "renamed-gate" / "determinism.tsv"
    try:
        read_tsv_source(path, DETERMINISM_REQUIRED, _determinism_predicate, _determinism_row)
        failures.append("renamed-gate: expected SystemExit naming 'gate', got no error")
    except SystemExit as exc:
        if "gate" not in str(exc):
            failures.append(f"renamed-gate: expected the error to name 'gate', got {exc}")

    return failures


def run_selftest() -> int:
    failures = _selftest_source2() + _selftest_tsv_sources()
    if failures:
        for failure in failures:
            click.echo(f"self-test: FAILED: {failure}")
        return 1
    click.echo("self-test: OK (source 2's absent/present rule, sources 3-4's absent/present/unreadable rules)")
    return 0


# --------------------------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------------------------


@click.command()
@click.option(
    "--out",
    "out_dir",
    type=click.Path(path_type=Path),
    default=None,
    help="Write order-containers.md, order-comparators.md and divergences.md under DIR instead "
    "of the committed port/reports/ tree. Lets a run be proved deterministic, and is what "
    "just audit-check uses to regenerate into a scratch directory, without committing anything.",
)
@click.option(
    "--check",
    "check",
    is_flag=True,
    help="just audit-check: regenerate all three reports into a scratch directory and fail, "
    "with a diff, when a committed one differs byte for byte. Never writes port/reports/.",
)
@click.option(
    "--self-test",
    "self_test",
    is_flag=True,
    help="Run every fixture under port/tests/audit-order/ and assert its expected result.",
)
def main(out_dir: Path | None, check: bool, self_test: bool) -> None:
    """Regenerate port/reports/order-containers.md, port/reports/order-comparators.md and
    port/reports/divergences.md."""
    if self_test:
        sys.exit(run_selftest())
    if check:
        if out_dir is not None:
            raise SystemExit("audit-order: --out and --check are mutually exclusive")
        run_check()
        return
    regenerate_all(out_dir)


if __name__ == "__main__":
    main()
