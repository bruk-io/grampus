def container_port_choice(type_name: str, verdict: str) -> str:
    """The fixed mapping from a container's classification to the port's choice."""
    if verdict == "looked_up":
        return "same container kind, no ordering guarantee"
    # verdict is "iterated" or "undecided" (reported conservatively as iterated).
    if type_name in MAP_KINDS:
        return "insertion-ordered map"
    if type_name in SET_KINDS:
        return "insertion-ordered set"
    raise AssertionError(f"unrecognised container type {type_name!r}")


def comparator_port_choice(shape: str) -> str:
    """The fixed mapping from a comparator's matched shape to the port's choice."""
    if shape == "disjunction":
        return "nested lexicographic chain over the same fields in the same order"
    if shape == "non_strict":
        return "the strict form of the same relation"
    if shape == "tolerance":
        return "the same comparison with the tolerance removed; the row's tier decides equality"
    if shape == "undecided":
        return "total-order comparator"
    raise AssertionError(f"unrecognised comparator shape {shape!r}")


def diverges(port_choice: str) -> tuple[str, str]:
    """Whether `port_choice` differs from the oracle's relation or iteration order.

    `yes` for every mapping except two named exceptions: a looked-up-only container (the port
    keeps the same container kind with no ordering guarantee, because its order never reaches
    output -- this branch is never reached by a row this script emits, since a looked-up-only
    container is never written to the report), and a non-strict-shaped comparator whose relation
    is already, in fact, strict despite the textual shape -- which a static script has no way to
    establish, so that branch is documented here but never taken: no code path below returns
    "no" for it.

    This script never attempts to decide whether a given site's order reaches compared output
    (a dynamic question a static audit cannot answer), so every row it emits carries that
    undecided note in its reason.
    """
    if port_choice == "same container kind, no ordering guarantee":
        return "no", "the container is only looked up; its order never reaches output"
    return "yes", "reaches-output undecided: this script does not establish whether this site's order reaches compared output"


