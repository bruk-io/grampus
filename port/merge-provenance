#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "click>=8.1.0",
# ]
# ///

"""Produce one resolved-configuration golden: slice, print its provenance, merge, write.

``port/merge-provenance <fixture> <configuration> <output-json> [--out <dir>]`` is the one
place this task's own work (R11) lives, invoked once per row by the `config-goldens` recipe in
the `justfile`. It is not a general-purpose JSON merger: it owns exactly the sequence
``05-oracle-provenance``'s own docstring assigns to "a step of its own" --

1. ``oracle/slice <fixture> <configuration> --export-settings --out <scratch>`` (a fresh
   throwaway ``--datadir``, as every ``oracle/slice`` invocation gets), producing
   ``<scratch>/settings.json`` and ``<scratch>/plate_1.gcode``.
2. ``oracle/provenance <fixture> <configuration> --oracle release --syntax json``, producing
   the nine-item ``{"provenance": {...}}`` object.
3. The merge: the settings document, with the provenance object's inner dict added as its own
   top-level ``"provenance"`` key, written to ``<output-json>``.

Neither ``oracle/slice`` nor ``oracle/provenance`` is modified or reimplemented here -- both are
invoked as subprocesses, exactly as a person would type them, so ``git diff oracle/slice`` and
``git diff oracle/provenance`` stay empty. This script owns only the merge and the sequencing.

``--out`` lets a caller pin the scratch directory (so the run that produced a golden can be
pointed back to afterwards, e.g. for ``port/config-block-diff``); when omitted, a fresh
directory is created under ``oracle/.cache/config-goldens/`` (git-ignored, same as
``oracle/slice``'s own scratch tree) and left behind for inspection.

Key order in the written JSON is the settings document's own key order (insertion order, which
``json.load``/``json.dumps`` preserve) with ``provenance`` appended last; nothing is sorted. That
is what keeps re-running this script over an unchanged ``docs/ORACLE.md`` row byte-identical --
the exported settings document itself is already proven byte-stable across runs (R11), and nei-
ther this script nor ``oracle/provenance`` reads anything that varies run to run.
"""

from __future__ import annotations

import json
import subprocess
import sys
import time
import uuid
from pathlib import Path

import click

REPO_ROOT = Path(__file__).resolve().parent.parent
ORACLE_SLICE = REPO_ROOT / "oracle" / "slice"
ORACLE_PROVENANCE = REPO_ROOT / "oracle" / "provenance"
SCRATCH_ROOT = REPO_ROOT / "oracle" / ".cache" / "config-goldens"


class MergeError(Exception):
    """Raised for a problem this script reports itself, never a Python traceback."""


def fresh_scratch_dir() -> Path:
    """Make and return a fresh scratch directory under oracle/.cache/config-goldens/."""
    run_id = f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
    scratch = SCRATCH_ROOT / run_id
    scratch.mkdir(parents=True)
    return scratch


def run_slice(fixture: str, configuration: str, out_dir: Path) -> Path:
    """Run oracle/slice --export-settings into `out_dir`; return the written settings.json."""
    cmd = [str(ORACLE_SLICE), fixture, configuration, "--export-settings", "--out", str(out_dir)]
    result = subprocess.run(cmd)
    if result.returncode != 0:
        raise MergeError(f"oracle/slice exited {result.returncode} ({' '.join(cmd)})")
    settings_path = out_dir / "settings.json"
    if not settings_path.is_file():
        raise MergeError(f"oracle/slice did not write {settings_path}")
    return settings_path


def run_provenance(fixture: str, configuration: str) -> dict:
    """Run oracle/provenance --syntax json; return its inner "provenance" dict."""
    cmd = [str(ORACLE_PROVENANCE), fixture, configuration, "--oracle", "release", "--syntax", "json"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        click.echo(result.stderr, err=True, nl=False)
        raise MergeError(f"oracle/provenance exited {result.returncode} ({' '.join(cmd)})")
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise MergeError(f"oracle/provenance printed non-JSON: {exc}") from exc
    provenance = data.get("provenance")
    if not isinstance(provenance, dict):
        raise MergeError(f"oracle/provenance's output carries no 'provenance' object: {result.stdout!r}")
    return provenance


def merge(settings_path: Path, provenance: dict, output_path: Path) -> int:
    """Merge `provenance` into the document at `settings_path`; write it to `output_path`.

    Returns the merged document's top-level key count (including "provenance"), for the
    caller's own success message.
    """
    settings = json.loads(settings_path.read_text())
    if not isinstance(settings, dict):
        raise MergeError(f"{settings_path} is not a JSON object")
    if "provenance" in settings:
        raise MergeError(
            f"{settings_path} already carries a 'provenance' key of its own "
            "(oracle/slice's --export-settings is not expected to ever write one)"
        )
    settings["provenance"] = provenance
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(settings, indent=2) + "\n")
    return len(settings)


@click.command()
@click.argument("fixture")
@click.argument("configuration")
@click.argument("output_json", type=click.Path(dir_okay=False))
@click.option(
    "--out",
    "out_dir_arg",
    type=click.Path(file_okay=False),
    default=None,
    help="Pin the scratch directory oracle/slice runs in, instead of a fresh one.",
)
def main(fixture: str, configuration: str, output_json: str, out_dir_arg: str | None) -> None:
    """Slice <fixture>/<configuration>, merge its provenance header, write <output_json>."""
    invocation_cwd = Path.cwd()
    output_path = (invocation_cwd / output_json).resolve()
    out_dir = (invocation_cwd / out_dir_arg).resolve() if out_dir_arg else fresh_scratch_dir()
    if out_dir_arg:
        out_dir.mkdir(parents=True, exist_ok=True)

    try:
        settings_path = run_slice(fixture, configuration, out_dir)
        provenance = run_provenance(fixture, configuration)
        key_count = merge(settings_path, provenance, output_path)
    except MergeError as exc:
        click.echo(f"error: {exc}", err=True)
        sys.exit(1)

    gcode_path = out_dir / "plate_1.gcode"
    click.echo(f"{output_path}: wrote {key_count} top-level keys")
    click.echo(f"run output: {out_dir} (plate_1.gcode: {gcode_path})")


if __name__ == "__main__":
    main()
