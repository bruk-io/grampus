#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "click>=8.1.0",
# ]
# ///

"""Fetch, verify and stage the pinned OrcaSlicer release binary used as the test oracle.

Downloads the OrcaSlicer v2.5.2 release asset, verifies its sha256 against the value
recorded in vendor/README.md, mounts the disk image read-only, copies the app bundle
into a scratch directory, detaches the image, verifies the bundle reports version 2.5.2,
and only then atomically promotes it into oracle/.cache/app/. A populated cache is
re-verified and reused rather than re-fetched; the cache is rebuilt from the download
onward when either check disagrees. An interrupted run never leaves oracle/.cache/app/
holding a bundle this script has not itself verified.
"""

from __future__ import annotations

import hashlib
import os
import plistlib
import re
import shutil
import subprocess
import sys
from pathlib import Path

import click

ASSET_NAME = "OrcaSlicer_Mac_universal_V2.5.2.dmg"
RELEASE_TAG = "v2.5.2"
SOURCE_REPO = "OrcaSlicer/OrcaSlicer"
EXPECTED_VERSION = "2.5.2"


def repo_root() -> Path:
    """Resolve the repository root from this script's own location, not the cwd."""
    return Path(__file__).resolve().parent.parent


def sha256_of(path: Path) -> str:
    """Compute the sha256 digest of a file's contents."""
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_recorded_sha256(readme_path: Path) -> str:
    """Read the oracle asset's recorded sha256 out of vendor/README.md by its label."""
    text = readme_path.read_text()
    match = re.search(r"Recorded sha256 \| `([^`]+)`", text)
    if match is None:
        print(f"error: no recorded sha256 found in {readme_path}", file=sys.stderr)
        sys.exit(1)
    return match.group(1)


def read_bundle_version(app_bundle: Path) -> str:
    """Read CFBundleShortVersionString from an app bundle's Info.plist, or '' if unreadable."""
    plist_path = app_bundle / "Contents" / "Info.plist"
    if not plist_path.is_file():
        return ""
    result = subprocess.run(
        ["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString", str(plist_path)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def fetch_asset(download_dir: Path, download_path: Path) -> None:
    """Download the pinned release asset into download_dir, overwriting any stale copy."""
    download_dir.mkdir(parents=True, exist_ok=True)
    print(f"action: download {ASSET_NAME} from {SOURCE_REPO}@{RELEASE_TAG}", flush=True)
    try:
        subprocess.run(
            [
                "gh",
                "release",
                "download",
                RELEASE_TAG,
                "-R",
                SOURCE_REPO,
                "-p",
                ASSET_NAME,
                "-D",
                str(download_dir),
                "--clobber",
            ],
            check=True,
        )
    except FileNotFoundError:
        print("error: gh is not installed or not on PATH", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as exc:
        print(f"error: gh release download failed (exit {exc.returncode})", file=sys.stderr)
        sys.exit(1)
    if not download_path.is_file():
        print(
            f"error: gh release download reported success but {download_path} is missing",
            file=sys.stderr,
        )
        sys.exit(1)


def attach_dmg(dmg_path: Path) -> tuple[str, Path]:
    """Mount a disk image read-only and return its device entry and mount point."""
    print(f"action: attach {dmg_path.name}", flush=True)
    try:
        result = subprocess.run(
            ["hdiutil", "attach", "-readonly", "-nobrowse", "-plist", str(dmg_path)],
            capture_output=True,
            check=True,
        )
    except subprocess.CalledProcessError as exc:
        stderr = exc.stderr.decode(errors="replace").strip() if exc.stderr else ""
        print(f"error: hdiutil attach failed: {stderr}", file=sys.stderr)
        sys.exit(1)
    plist = plistlib.loads(result.stdout)
    for entity in plist.get("system-entities", []):
        mount_point = entity.get("mount-point")
        dev_entry = entity.get("dev-entry")
        if mount_point and dev_entry:
            return dev_entry, Path(mount_point)
    print("error: hdiutil attach produced no mount point", file=sys.stderr)
    sys.exit(1)


def detach_dmg(dev_entry: str) -> None:
    """Detach a mounted disk image, retrying with -force if busy; exit non-zero if both fail."""
    print(f"action: detach {dev_entry}", flush=True)
    result = subprocess.run(["hdiutil", "detach", dev_entry], capture_output=True)
    if result.returncode == 0:
        return
    retry = subprocess.run(["hdiutil", "detach", "-force", dev_entry], capture_output=True)
    if retry.returncode != 0:
        stderr = retry.stderr.decode(errors="replace").strip() if retry.stderr else ""
        print(f"error: hdiutil detach failed for {dev_entry}: {stderr}", file=sys.stderr)
        sys.exit(1)


def copy_bundle(mount_point: Path, incoming_dir: Path, bundle_name: str) -> Path:
    """Copy the named .app bundle out of a mounted volume into a fresh incoming_dir.

    Returns the path of the copied bundle, still under incoming_dir — not yet promoted to the
    live cache. Any stale incoming_dir left by an interrupted previous run is cleared first.
    """
    source = mount_point / bundle_name
    if not source.is_dir():
        print(f"error: {bundle_name} not found on {mount_point}", file=sys.stderr)
        sys.exit(1)
    print(f"action: copy {bundle_name}", flush=True)
    if incoming_dir.exists():
        shutil.rmtree(incoming_dir)
    incoming_dir.mkdir(parents=True)
    dest = incoming_dir / bundle_name
    shutil.copytree(source, dest, symlinks=True)
    return dest


def promote_bundle(
    incoming_bundle: Path, incoming_dir: Path, app_dir: Path, app_bundle: Path
) -> None:
    """Atomically replace the live cached bundle with a verified incoming one."""
    app_dir.mkdir(parents=True, exist_ok=True)
    if app_bundle.exists():
        shutil.rmtree(app_bundle)
    os.replace(incoming_bundle, app_bundle)
    try:
        incoming_dir.rmdir()
    except OSError:
        pass


@click.command()
def main() -> None:
    """Fetch and verify the pinned OrcaSlicer release binary, reusing a valid cache."""
    root = repo_root()
    readme_path = root / "vendor" / "README.md"
    cache_dir = root / "oracle" / ".cache"
    download_dir = cache_dir / "download"
    download_path = download_dir / ASSET_NAME
    app_dir = cache_dir / "app"
    app_bundle = app_dir / "OrcaSlicer.app"
    binary = app_bundle / "Contents" / "MacOS" / "OrcaSlicer"
    incoming_dir = cache_dir / "app.incoming"

    expected_sha = read_recorded_sha256(readme_path)

    cached_download_valid = download_path.is_file() and sha256_of(download_path) == expected_sha
    cached_bundle_valid = (
        os.access(binary, os.X_OK) and read_bundle_version(app_bundle) == EXPECTED_VERSION
    )

    if cached_download_valid and cached_bundle_valid:
        print("action: reuse-cached-download")
        print("action: reuse-cached-bundle")
    else:
        fetch_asset(download_dir, download_path)
        measured_sha = sha256_of(download_path)
        if measured_sha != expected_sha:
            print(f"error: sha256 mismatch for {ASSET_NAME}", file=sys.stderr)
            print(f"  expected: {expected_sha}", file=sys.stderr)
            print(f"  measured: {measured_sha}", file=sys.stderr)
            sys.exit(1)

        dev_entry, mount_point = attach_dmg(download_path)
        try:
            incoming_bundle = copy_bundle(mount_point, incoming_dir, "OrcaSlicer.app")
        finally:
            detach_dmg(dev_entry)

        measured_version = read_bundle_version(incoming_bundle)
        if measured_version != EXPECTED_VERSION:
            print("error: OrcaSlicer.app bundle version mismatch", file=sys.stderr)
            print(f"  expected: {EXPECTED_VERSION}", file=sys.stderr)
            print(f"  measured: {measured_version or '(unreadable)'}", file=sys.stderr)
            shutil.rmtree(incoming_dir, ignore_errors=True)
            sys.exit(1)

        promote_bundle(incoming_bundle, incoming_dir, app_dir, app_bundle)

    print(f"sha256: {expected_sha}")
    print(f"version: {EXPECTED_VERSION}")
    print(f"binary: {binary}")


if __name__ == "__main__":
    main()
