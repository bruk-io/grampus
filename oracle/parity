class ParityError(Exception):
    """Raised for a problem this script reports itself, never a Python traceback."""


# ---------------------------------------------------------------------------
# docs/ORACLE.md's configuration table (deliberately duplicated from oracle/slice's and
# oracle/determinism's own table readers: these are standalone uv scripts, and this task touches
# no other script's file).
# ---------------------------------------------------------------------------

SEPARATOR_RE = re.compile(r"^:?-+:?$")


def split_row(line: str) -> list[str]:
    """Split one markdown table line into its trimmed cells."""
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


def strip_cell(cell: str) -> str:
    """Drop a cell's surrounding backticks and whitespace, and read "(none)" as empty."""
    cell = cell.strip()
    if cell.startswith("`") and cell.endswith("`") and len(cell) >= 2:
        cell = cell[1:-1].strip()
    if cell.lower() in ("", "(none)", "-", "—"):
        return ""
    return cell


def find_configuration_table(doc_text: str) -> list[dict[str, str]]:
    """Return the rows of the markdown table whose first column is "Configuration"."""
    lines = doc_text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i].strip()
        if line.startswith("|") and i + 1 < len(lines):
            header = split_row(line)
            sep_cells = split_row(lines[i + 1].strip()) if lines[i + 1].strip().startswith("|") else []
            if header and header[0] == "Configuration" and sep_cells and all(
                SEPARATOR_RE.match(c) for c in sep_cells
            ):
                rows = []
                j = i + 2
                while j < len(lines) and lines[j].strip().startswith("|"):
                    cells = split_row(lines[j])
                    rows.append(dict(zip(header, cells)))
                    j += 1
                return rows
            i += 1
        else:
            i += 1
    raise ParityError(f"no table headed 'Configuration' found in {ORACLE_DOC}")


def parse_semicolon_list(cell: str) -> list[str]:
    """Parse a ";"-separated cell (Fixtures) into its trimmed, non-empty parts."""
    parts = []
    for part in cell.split(";"):
        part = strip_cell(part)
        if part:
            parts.append(part)
    return parts


def parse_overrides(cell: str) -> list[tuple[str, str]]:
    """Parse an "Overrides" cell's ";"-separated key=value pairs (mirrors oracle/slice's own)."""
    cell = cell.strip()
    if not cell or strip_cell(cell) == "":
        return []
    pairs = []
    for part in cell.split(";"):
        part = strip_cell(part)
        if not part:
            continue
        if "=" not in part:
            raise ParityError(f"malformed override {part!r}: expected key=value")
        key, value = part.split("=", 1)
        pairs.append((key.strip(), value.strip()))
    return pairs


@dataclass
class ConfigurationRow:
    name: str
    fixtures: list[str]
    overrides: list[tuple[str, str]]


def load_configuration_rows() -> list[ConfigurationRow]:
    if not ORACLE_DOC.is_file():
        raise ParityError(f"{ORACLE_DOC} does not exist")
    rows = find_configuration_table(ORACLE_DOC.read_text())
    result = []
    for row in rows:
        name = strip_cell(row.get("Configuration", ""))
        if not name:
            continue
        fixtures = parse_semicolon_list(row.get("Fixtures", ""))
        if not fixtures:
            raise ParityError(f"configuration {name!r} names no fixture in {ORACLE_DOC}")
        overrides = parse_overrides(row.get("Overrides", ""))
        result.append(ConfigurationRow(name=name, fixtures=fixtures, overrides=overrides))
    return result


def fixture_stem(fixture: str) -> str:
    return Path(fixture).stem


# ---------------------------------------------------------------------------
# port/reports/determinism.tsv (task 27-oracle-determinism, already on main): this script's one
# signal for whether the release oracle is itself run-to-run deterministic for a given
# configuration and artifact -- see the module docstring's "Idempotence" section.
# ---------------------------------------------------------------------------


def load_release_determinism_gates() -> dict[tuple[str, str], str]:
    if not DETERMINISM_TSV.is_file():
        raise ParityError(f"{DETERMINISM_TSV} does not exist (run `just oracle-determinism` first)")
    lines = DETERMINISM_TSV.read_text().splitlines()
    if not lines:
        raise ParityError(f"{DETERMINISM_TSV} is empty")
    header = lines[0].split("\t")
    gates: dict[tuple[str, str], str] = {}
    for line in lines[1:]:
        if not line:
            continue
        cells = dict(zip(header, line.split("\t")))
        gates[(cells["configuration"], cells["artifact"])] = cells["gate"]
    return gates


def detail_is_safe_to_commit(
    determinism_gates: dict[tuple[str, str], str], configuration: str, artifact: str
) -> bool:
    """False when determinism.tsv has no row, or a `none` gate, for this (configuration,
    artifact) -- see the module docstring. Conservative on a missing row (treated as unsafe)
    rather than silently assuming a deterministic release oracle this script never measured."""
    return determinism_gates.get((configuration, artifact)) not in (None, "none")


# ---------------------------------------------------------------------------
# The built oracle's exact CMake flags, read out of oracle/build-libslic3r's own
# configure_cmd() rather than retyped here, so the two cannot drift (R6, R7).
# ---------------------------------------------------------------------------


def load_build_libslic3r_module():
    """Import oracle/build-libslic3r as a module, for its module-level constants and
    `inspect.getsource` on `run_stage_two` -- never calling either stage-two or stage-one
    function, so this never runs cmake or touches vendor/OrcaSlicer. Safe because every
    top-level statement in that file is a constant assignment or a `def`/`if __name__`
    guard (checked by reading the file); nothing executes at import time beyond defining
    them."""
    loader = importlib.machinery.SourceFileLoader("oracle_build_libslic3r_ro", str(BUILD_SCRIPT))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ParityError(f"could not build an import spec for {BUILD_SCRIPT}")
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


FLAG_LITERAL_RE = re.compile(r'^(f)?"((?:[^"\\]|\\.)*)"\s*,?\s*$')


def built_oracle_cmake_flags() -> list[str]:
    """Return stage two's exact `-D...` CMake configure flags, read out of
    oracle/build-libslic3r's own `configure_cmd()` (inside `run_stage_two`) rather than retyped
    here -- so a future change to that function (a new flag, a changed CXX_FLAGS value) is
    reflected the next time this report regenerates, with nothing in this file to keep in sync
    by hand. `-DCMAKE_PREFIX_PATH` is rendered with the same `<stage one's install prefix>`
    placeholder `docs/ORACLE.md` already uses for it, never this host's own resolved,
    worktree-specific path: that path is specific to whichever checkout happened to run this
    script (this task's own worktree is not even the checkout `vendor/OrcaSlicer/build/arm64`
    was configured against here -- its own CMakeCache.txt names a different one), so committing
    it literally would both be wrong about the build actually measured and put an absolute path
    under a user's home directory into an AGPL-published report -- the only file under
    `port/reports/` that would.

    Raises ParityError if `configure_cmd()`'s shape has changed in a way this extraction cannot
    follow, or if the result does not include `-ffp-contract=off` -- R6/R7's one flag this
    report exists to name -- rather than silently printing an incomplete list.
    """
    mod = load_build_libslic3r_module()
    source = inspect.getsource(mod.run_stage_two)
    match = re.search(
        r"def configure_cmd\(\) -> list\[str\]:\s*\n(.*?)\n\s*build_cmd = \[", source, re.DOTALL
    )
    if match is None:
        raise ParityError(
            "could not locate configure_cmd()'s return list in oracle/build-libslic3r; its "
            "source has moved and this script's own extraction needs updating"
        )
    body = match.group(1)
    substitutions = {
        "deps_prefix": "<stage one's install prefix>",
        "CMAKE_IGNORE_PREFIX_PATH": mod.CMAKE_IGNORE_PREFIX_PATH,
        "CMAKE_POLICY_VERSION_MINIMUM": mod.CMAKE_POLICY_VERSION_MINIMUM,
        "CXX_FLAGS": mod.CXX_FLAGS,
    }
    flags: list[str] = []
    for line in body.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        literal = FLAG_LITERAL_RE.match(stripped)
        if literal is None:
            continue
        is_fstring, text = literal.group(1), literal.group(2)
        if not text.startswith("-D"):
            continue
        if is_fstring:
            for name, value in substitutions.items():
                text = text.replace("{" + name + "}", value)
        flags.append(text)
    if not any("-ffp-contract=off" in f for f in flags):
        raise ParityError(
            "extracted CMake flags do not include -ffp-contract=off; oracle/build-libslic3r's "
            "CXX_FLAGS constant or configure_cmd()'s shape may have changed"
        )
    return flags


# ---------------------------------------------------------------------------
# Building oracle/stage-dump (never vendor/OrcaSlicer itself) and running both oracles.
# ---------------------------------------------------------------------------


def build_stage_dump() -> tuple[Path, float]:
    """Build oracle/stage-dump's stage_dump binary (the same two commands `just oracle-dump`
    runs). Fails loudly naming `just oracle-build` when the vendored libslic3r archives are
    missing, rather than rebuilding vendor/OrcaSlicer from empty or falling back to the release
    binary alone (R6's own requirement, task.md's "what it waits for"). Returns the binary's
    path and this build's own wall-clock seconds."""
    if not LIBSLIC3R_A.is_file() or not LIBSLIC3R_CGAL_A.is_file():
        raise ParityError(
            f"{LIBSLIC3R_A} and/or {LIBSLIC3R_CGAL_A} not found -- the vendored libslic3r has "
            "not been built on this platform. Run `just oracle-build` first; this script never "
            "builds it and never falls back to the release binary alone."
        )
    start = time.monotonic()
    configure = subprocess.run(
        [
            "cmake",
            "-S",
            str(STAGE_DUMP_SOURCE),
            "-B",
            str(STAGE_DUMP_BUILD_DIR),
            "-G",
            "Ninja",
            "-DCMAKE_BUILD_TYPE=Release",
        ],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
    )
    if configure.returncode != 0:
        raise ParityError(
            f"configuring oracle/stage-dump failed:\n--- stdout ---\n{configure.stdout}\n"
            f"--- stderr ---\n{configure.stderr}"
        )
    build = subprocess.run(
        ["cmake", "--build", str(STAGE_DUMP_BUILD_DIR), "--target", "stage_dump"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
    )
    if build.returncode != 0:
        raise ParityError(
            f"building oracle/stage-dump failed:\n--- stdout ---\n{build.stdout}\n"
            f"--- stderr ---\n{build.stderr}"
        )
    elapsed = time.monotonic() - start
    return STAGE_DUMP_BIN, elapsed


@dataclass
class RunArtifacts:
    gcode: Path | None
    settings: Path | None
    statistics: Path | None


def fresh_dir(label: str) -> Path:
    out_dir = SCRATCH_ROOT / f"{label}-{uuid.uuid4().hex[:8]}"
    out_dir.mkdir(parents=True, exist_ok=True)
    return out_dir


def collect_artifacts(out_dir: Path) -> RunArtifacts:
    gcode = out_dir / "plate_1.gcode"
    settings = out_dir / "settings.json"
    statistics = out_dir / "plate_1.statistics.json"
    return RunArtifacts(
        gcode=gcode if gcode.is_file() else None,
        settings=settings if settings.is_file() else None,
        statistics=statistics if statistics.is_file() else None,
    )


def run_release(fixture: str, configuration: str) -> tuple[RunArtifacts | None, Path, str]:
    """Run `just oracle-slice <fixture> <configuration> --export-settings --export-statistics`
    (task 04-oracle-slice's interface, no other flag, no --datadir). Returns the artifacts (or
    None on failure), the scratch directory, and any stdout/stderr captured for the failure
    case."""
    out_dir = fresh_dir(f"release-{configuration}-{fixture_stem(fixture)}")
    cmd = [
        "just",
        "oracle-slice",
        fixture,
        configuration,
        "--export-settings",
        "--export-statistics",
        "--out",
        str(out_dir),
    ]
    result = subprocess.run(cmd, cwd=REPO_ROOT, capture_output=True, text=True)
    if result.returncode != 0:
        return None, out_dir, result.stdout + result.stderr
    return collect_artifacts(out_dir), out_dir, ""


def run_built_config(
    binary: Path, fixture: str, configuration: str, golden: Path
) -> tuple[RunArtifacts | None, Path, str]:
    """Run `stage_dump <stem> <configuration> --out <dir> --unarmed --config <golden>` directly
    (never through `just oracle-dump`, which also runs an armed comparison and copies dumps into
    the committed port/dumps/ -- this task owns neither)."""
    out_dir = fresh_dir(f"built-{configuration}-{fixture_stem(fixture)}")
    cmd = [
        str(binary),
        fixture_stem(fixture),
        configuration,
        "--out",
        str(out_dir),
        "--unarmed",
        "--config",
        str(golden),
    ]
    result = subprocess.run(cmd, cwd=REPO_ROOT, capture_output=True, text=True)
    if result.returncode != 0:
        return None, out_dir, result.stdout + result.stderr
    return collect_artifacts(out_dir), out_dir, ""


def run_built_set(
    binary: Path, fixture: str, configuration: str, overrides: list[tuple[str, str]]
) -> tuple[RunArtifacts | None, Path, str]:
    """Run `stage_dump <stem> <configuration> --out <dir> --unarmed --set k=v ...` directly --
    C12's fallback for a configuration the pinned CLI cannot construct (R11: resolves no preset
    and no `inherits` chain). Not exercised by any row this script's own docs/ORACLE.md names
    today; see the module docstring."""
    out_dir = fresh_dir(f"built-{configuration}-{fixture_stem(fixture)}")
    cmd = [str(binary), fixture_stem(fixture), configuration, "--out", str(out_dir), "--unarmed"]
    for key, value in overrides:
        cmd += ["--set", f"{key}={value}"]
    result = subprocess.run(cmd, cwd=REPO_ROOT, capture_output=True, text=True)
    if result.returncode != 0:
        return None, out_dir, result.stdout + result.stderr
    return collect_artifacts(out_dir), out_dir, ""


# ---------------------------------------------------------------------------
# The comparison: through crates/oracle-compare's stable-keyed JSON (`just compare ... --format
# json`), read from the JSON object and never from an exit code or the human-readable text --
# the JSON schema exists for exactly this (format.rs's own doc comment names this task as one
# of its callers).
# ---------------------------------------------------------------------------


def run_compare_json(args: list[str]) -> dict:
    cmd = ["just", "compare", *args, "--format", "json"]
    result = subprocess.run(cmd, cwd=REPO_ROOT, capture_output=True, text=True)
    try:
        report = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ParityError(
            f"{' '.join(cmd)} exited {result.returncode} with no parseable JSON: "
            f"{result.stderr.strip()}"
        ) from exc
    if result.returncode != 0:
        # crates/oracle-compare/src/main.rs only exits non-zero for a named-error (which never
        # prints parseable JSON, caught above) or when `--require <level>` was passed and not
        # met -- this script never passes `--require`, so parseable JSON should always come
        # with exit 0. Asserted rather than silently discarded, so a future change to either
        # side's contract fails loudly here instead of reading as a clean comparison.
        raise ParityError(
            f"{' '.join(cmd)} printed parseable JSON but exited {result.returncode} (this "
            "script never passes --require, so that should not happen): "
            f"{result.stderr.strip()}"
        )
    return report


def gcode_level_reached(report: dict) -> str:
    """The strictest (lowest-index) level whose outcome is a pass; "none" if no level passed.
    Each level is read independently off the `levels` object (R4: not assumed nested)."""
    levels = report.get("levels", {})
    for level in LEVELS:
        if levels.get(level, {}).get("outcome") == "pass":
            return level
    return "none"


def json_level_reached(report: dict) -> str:
    level = report.get("level")
    return level if level in ("L0", "L1") else "none"


def gcode_reaches_l1(report: dict) -> bool:
    """Whether this pair reaches L1 against each other (L0 implies L1): read directly off
    `levels.L0.outcome` and `levels.L1.outcome`, each evaluated independently (R4: never assumed
    nested), rather than inferred from `gcode_level_reached`'s strictest-pass scan -- so a future
    change to that scan's own vocabulary can never silently change what counts as "reaches L1"."""
    levels = report.get("levels", {})
    return levels.get("L0", {}).get("outcome") == "pass" or levels.get("L1", {}).get("outcome") == "pass"


def json_reaches_l1(report: dict) -> bool:
    """Whether this JSON artifact pair reaches L1 against each other (L0 implies L1)."""
    return report.get("level") in ("L0", "L1")


@dataclass
class Difference:
    """One level's (or, for a JSON artifact, the whole comparison's) failing location, or a
    note that this row's literal detail is withheld because the release oracle is not
    run-to-run deterministic here (see detail_is_safe_to_commit).

    `detail` is always safe to commit as-is. `stdout_detail`, set only when `withheld` is True,
    carries this run's real failing location -- never written into the committed report (that
    would break idempotence), but costing nothing to print to stdout, which is not committed."""

    level: str
    detail: str  # already-rendered prose, safe to commit as-is
    withheld: bool = False
    stdout_detail: str | None = None  # withheld only: this run's real, uncommitted location


def gcode_differences(report: dict, safe_to_commit: bool) -> list[Difference]:
    """Every level L0-L4 whose outcome failed, each with its own failing location -- not only
    the first -- per task.md's "lists every difference found".

    L0's own byte offset is never committed literally, for a reason measured empirically on this
    very branch (two consecutive runs of a row `determinism.tsv` marks deterministic at L1):
    L0 compares *raw* bytes, before R4's G-code normalisation strips the oracle's own
    `; generated by ... at HH:MM:SS` line, and the release and the built oracle are two separate
    process invocations whose own copies of that line only sometimes land in the same
    wall-clock second. When they do not, L0's first differing byte sits inside that line itself
    (an early, small offset); when they happen to match to the second, L0's search continues
    past it to whatever the next raw-byte difference is (a much larger offset) -- so the number
    is not a property of this row at all, only of how two runs happened to race, and committing
    it literally would fail this report's own idempotence requirement regardless of
    `safe_to_commit` (confirmed: a row `determinism.tsv` gates `L1`, i.e. release-vs-release
    deterministic, still produced two different L0 offsets across two consecutive
    `just oracle-parity` runs here). L1 onward evaluate the already-normalised streams, so none
    of them carries this hazard; see `safe_to_commit` for the one that remains (a row whose
    content itself -- not just this timing race -- is not run-to-run deterministic)."""
    levels = report.get("levels", {})
    out: list[Difference] = []
    for level in LEVELS:
        outcome = levels.get(level, {})
        if outcome.get("outcome") != "fail":
            continue
        if level == "L0":
            out.append(
                Difference(
                    level=level,
                    detail=(
                        "raw bytes differ before R4's declared normalisation (expected: each "
                        "run's own `; generated by ... at HH:MM:SS` line; its first differing "
                        "byte offset is a race between the two oracles' own process starts, "
                        "not a property of this row, so it is never committed literally -- see "
                        "the next level below for the first normalised difference, if any)."
                    ),
                )
            )
            continue
        if not safe_to_commit:
            out.append(
                Difference(
                    level=level,
                    detail=(
                        "withheld: this row's release oracle is not run-to-run deterministic "
                        "for this artifact (`port/reports/determinism.tsv`'s gate is `none`), "
                        "so this run's literal failing location would not reproduce on the next "
                        "regeneration; see stdout for this run's measurement."
                    ),
                    withheld=True,
                    stdout_detail=render_gcode_fail(level, outcome),
                )
            )
            continue
        out.append(Difference(level=level, detail=render_gcode_fail(level, outcome)))
    return out


def render_group(group) -> str:
    """Render an `AggregateGroup` JSON object (`crates/oracle-compare/src/format.rs`'s
    `group_json`) the same way its own `Display` impl (`levels.rs`) renders it in text mode --
    never a raw Python dict repr, which is what `{group!r}` would otherwise leak into a
    committed report."""
    if not isinstance(group, dict):
        return repr(group)
    kind = group.get("kind")
    if kind == "whole_file":
        return "whole file"
    if kind == "layer":
        return f"layer {group.get('layer')}"
    if kind == "role":
        return f"role {group.get('role')}"
    if kind == "layer_role":
        return f"layer {group.get('layer')}, role {group.get('role')}"
    if kind == "object":
        return f"object {group.get('object')}"
    return f"group {group!r}"


def render_gcode_fail(level: str, outcome: dict) -> str:
    kind = set(outcome.keys()) - {"outcome"}
    if "line" in outcome:
        return (
            f"line {outcome['line']}: a=`{outcome.get('a')}` b=`{outcome.get('b')}`"
        )
    if "token_index" in outcome:
        return (
            f"token {outcome['token_index']} (a: line {outcome.get('line_a')} `{outcome.get('a')}`; "
            f"b: line {outcome.get('line_b')} `{outcome.get('b')}`)"
        )
    if "move_index" in outcome:
        return (
            f"move {outcome['move_index']} (layer={outcome.get('layer')}, role={outcome.get('role')}, "
            f"object={outcome.get('object')}; move count a={outcome.get('count_a')} "
            f"b={outcome.get('count_b')})"
        )
    if "group" in outcome and "quantity" in outcome:
        return (
            f"the {render_group(outcome['group'])}'s {outcome['quantity']} differs "
            f"(a={outcome.get('a')} b={outcome.get('b')}, tolerance={outcome.get('tolerance')})"
        )
    if "differing_layer" in outcome:
        return (
            f"the {render_group(outcome['group'])}'s layer count differs "
            f"(a={outcome.get('count_a')} b={outcome.get('count_b')}); layer "
            f"{outcome['differing_layer']} present only in {outcome.get('present_in')}"
        )
    return f"unrecognised fail shape at {level}: {outcome!r} (keys: {sorted(kind)})"


def render_json_fail(diff: dict) -> str:
    """Render a JSON artifact's `difference` object as prose, the same rendering used whether
    or not the result ends up committed -- shared so a withheld row's `stdout_detail` is the
    exact same text an un-withheld row would commit."""
    if diff.get("kind") == "pointer":
        a = diff.get("a") if diff.get("a_present") else "<absent>"
        b = diff.get("b") if diff.get("b_present") else "<absent>"
        return f"first difference at `{diff.get('pointer')}`: a={a!r} b={b!r}"
    if diff.get("kind") == "no_pointer":
        byte = diff.get("first_differing_byte")
        if byte is None:
            return "no JSON pointer could be named (both sides parse equal; raw bytes agree)"
        return f"no JSON pointer could be named; first differing byte: {byte}"
    return f"unrecognised difference shape: {diff!r}"


def json_difference(report: dict, safe_to_commit: bool) -> Difference | None:
    """The one difference a JSON artifact's report carries when it reached neither L0 nor L1,
    or None when it reached one of those (nothing to report)."""
    if report.get("level") is not None:
        return None
    diff = report.get("difference") or {}
    if not safe_to_commit:
        return Difference(
            level="none",
            detail=(
                "withheld: this row's release oracle is not run-to-run deterministic for this "
                "artifact (`port/reports/determinism.tsv`'s gate is `none`); see stdout for "
                "this run's measurement."
            ),
            withheld=True,
            stdout_detail=render_json_fail(diff),
        )
    return Difference(level="none", detail=render_json_fail(diff))


# ---------------------------------------------------------------------------
# Per-row measurement.
# ---------------------------------------------------------------------------


@dataclass
class ArtifactMeasurement:
    configuration: str
    fixture: str
    artifact: str
    level_reached: str
    reaches_l1: bool = False
    differences: list[Difference] = field(default_factory=list)


@dataclass
class RowResult:
    configuration: str
    fixture: str
    constructible: bool
    release_failed: bool  # an *attempted* release run that exited non-zero (unexpected)
    built_failed: bool  # an *attempted* built run that exited non-zero (unexpected)
    failure_detail: str
    measurements: list[ArtifactMeasurement]
    normative_oracle: str


def measure_row(
    row: ConfigurationRow,
    fixture: str,
    stage_dump_bin: Path,
    determinism_gates: dict[tuple[str, str], str],
) -> RowResult:
    golden = GOLDENS_DIR / f"{row.name}.json"
    constructible = golden.is_file()

    release_artifacts: RunArtifacts | None = None
    release_failed = False
    failure_detail = ""

    if constructible:
        release_artifacts, release_dir, release_log = run_release(fixture, row.name)
        if release_artifacts is None:
            release_failed = True
            failure_detail += f"release run failed (see {release_dir}):\n{release_log}\n"
        built_artifacts, built_dir, built_log = run_built_config(stage_dump_bin, fixture, row.name, golden)
    else:
        built_artifacts, built_dir, built_log = run_built_set(stage_dump_bin, fixture, row.name, row.overrides)

    built_failed = built_artifacts is None
    if built_failed:
        failure_detail += f"built run failed (see {built_dir}):\n{built_log}\n"

    measurements: list[ArtifactMeasurement] = []
    for artifact in ARTIFACTS:
        safe = detail_is_safe_to_commit(determinism_gates, row.name, artifact)
        a_path = getattr(release_artifacts, artifact_attr(artifact)) if release_artifacts else None
        b_path = getattr(built_artifacts, artifact_attr(artifact)) if built_artifacts else None

        # Each of task.md's "three shapes" gets its own sentinel in the "level reached" column
        # itself, not a shared bare "none" -- a reader of the .tsv must be able to tell "this
        # configuration cannot be built through the pinned CLI" apart from "the release run
        # failed" apart from "both sides ran but only one produced this artifact" without
        # opening the .md's prose. `reaches_l1` is always False for a sentinel row: there was no
        # comparison to reach anything.
        if not constructible:
            # A non-constructible row never attempts a release-side run (release_failed is
            # always False here), but its built-side `stage_dump --set` run can still fail --
            # that is still "a run that fails ... is a row and a non-zero exit, not a silent
            # omission" (task.md), so a failed built run is reported as such rather than masked
            # behind the not-constructible sentinel.
            measurements.append(
                ArtifactMeasurement(
                    configuration=row.name,
                    fixture=fixture,
                    artifact=artifact,
                    level_reached=LEVEL_BUILT_RUN_FAILED if built_failed else LEVEL_NOT_CONSTRUCTIBLE,
                )
            )
            continue

        if release_failed:
            measurements.append(
                ArtifactMeasurement(
                    configuration=row.name, fixture=fixture, artifact=artifact, level_reached=LEVEL_RELEASE_RUN_FAILED
                )
            )
            continue

        if built_failed:
            measurements.append(
                ArtifactMeasurement(
                    configuration=row.name, fixture=fixture, artifact=artifact, level_reached=LEVEL_BUILT_RUN_FAILED
                )
            )
            continue

        if a_path is None:
            # Not observed today (release_failed is False here): the release run exited 0 but
            # did not produce this one artifact.
            measurements.append(
                ArtifactMeasurement(
                    configuration=row.name,
                    fixture=fixture,
                    artifact=artifact,
                    level_reached=LEVEL_RELEASE_NO_ARTIFACT,
                )
            )
            continue

        if b_path is None:
            measurements.append(
                ArtifactMeasurement(
                    configuration=row.name, fixture=fixture, artifact=artifact, level_reached=LEVEL_BUILT_NO_ARTIFACT
                )
            )
            continue

        if artifact == "gcode":
            report = run_compare_json([str(a_path), str(b_path)])
            level = gcode_level_reached(report)
            reaches_l1 = gcode_reaches_l1(report)
            diffs = gcode_differences(report, safe) if level != "L0" else []
        else:
            flag = "--settings" if artifact == "settings-json" else "--statistics"
            report = run_compare_json([flag, str(a_path), str(b_path)])
            level = json_level_reached(report)
            reaches_l1 = json_reaches_l1(report)
            diff = json_difference(report, safe)
            diffs = [diff] if diff is not None else []

        measurements.append(
            ArtifactMeasurement(
                configuration=row.name,
                fixture=fixture,
                artifact=artifact,
                level_reached=level,
                reaches_l1=reaches_l1,
                differences=diffs,
            )
        )

    # Read directly off each measurement's own `reaches_l1` (R4: never inferred by re-parsing
    # the "level reached" column's vocabulary, which a sentinel row's own string is not drawn
    # from the level namespace at all).
    normative = "release" if all(m.reaches_l1 for m in measurements) else "built"

    return RowResult(
        configuration=row.name,
        fixture=fixture,
        constructible=constructible,
        release_failed=release_failed,
        built_failed=built_failed,
        failure_detail=failure_detail,
        measurements=measurements,
        normative_oracle=normative,
    )


def artifact_attr(artifact: str) -> str:
    return {"gcode": "gcode", "settings-json": "settings", "statistics-json": "statistics"}[artifact]


# ---------------------------------------------------------------------------
# Rendering the two committed files.
# ---------------------------------------------------------------------------


def render_tsv(results: list[RowResult]) -> str:
    lines = ["\t".join(TSV_HEADER)]
    for result in results:
        for m in result.measurements:
            lines.append(
                "\t".join([m.configuration, m.fixture, m.artifact, m.level_reached, result.normative_oracle])
            )
    return "\n".join(lines) + "\n"


def fetch_provenance_header(fixture: str, configuration: str) -> str:
    result = subprocess.run(
        ["./oracle/provenance", fixture, configuration, "--oracle", "built", "--syntax", "markdown"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise ParityError(f"oracle/provenance failed: {result.stderr.strip()}")
    return result.stdout.rstrip("\n")


def render_markdown(results: list[RowResult], cmake_flags: list[str]) -> str:
    if not results:
        raise ParityError("no configuration rows to report")

    # The provenance header must be the file's leading content for oracle/provenance --check's
    # leading_table_block to find it -- nothing may precede it, not even a heading (mirrors
    # oracle/determinism.md exactly, and its own doc comment names this report by name as the
    # reason that rule exists: "a report that quotes a different artifact's provenance table
    # later in its body ... the kind of report 28-oracle-parity writes").
    header_table = fetch_provenance_header(results[0].fixture, results[0].configuration)

    lines = [header_table, ""]
    lines.append(f"Generated: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}")
    lines.append("")
    lines.append(
        "Whether the pinned v2.5.2 release binary and the locally built `libslic3r` reach L1 "
        "against each other (R6), measured once per configuration and fixture named in "
        "`docs/ORACLE.md`'s configuration table, for the G-code, the `--export-settings` JSON "
        "and the `--export-statistics` JSON. **Run shape: unarmed for every row below** -- the "
        "`slicing_pipeline_plugin` hook is never registered on the built side, so its armed/"
        "unarmed exemption never applies and every byte of `--export-settings` is compared with "
        "no normalisation of its own."
    )
    lines.append("")
    lines.append(
        "**\"Reaches L1\" reads L0 as included**: a byte-identical pair (L0) has also reached "
        "L1. `normative oracle` is `release` for a configuration-and-fixture pair only when "
        "*every one* of its three artifact rows reaches L0 or L1; `built` otherwise. Per the "
        "recorded decision (`intent/libslic3r-rust-port/spec.md`, R6/C2), the locally built "
        "library is normative for every per-unit and per-stage proof regardless of this table; "
        "for the end-to-end gates the release binary is normative only where this table shows "
        "`release`, and goldens are kept per oracle for a pair that reads `built`."
    )
    lines.append("")
    lines.append(
        "Neither this file nor `port/reports/oracle-parity.tsv` is authored by hand -- both are "
        "regenerated by `just oracle-parity`, which builds `oracle/stage-dump`'s `stage_dump` "
        "fresh each run (never rebuilding the vendored tree itself; `vendor/OrcaSlicer/build/arm64` "
        "is a precondition `just oracle-build` produces). That build's own wall-clock time is "
        "left out of this committed file on purpose -- it is not a timestamp and would otherwise "
        "break this report's own idempotence (\"Done when\": re-running `just oracle-parity` "
        "leaves both committed files unchanged apart from their generated-at timestamp); it is "
        "printed to stdout on every run and reported once in this task's own pull request."
    )
    lines.append("")
    lines.append("**The built oracle's exact CMake configure flags** (stage two), read out of")
    lines.append("`oracle/build-libslic3r`'s own `configure_cmd()` rather than retyped here:")
    lines.append("")
    lines.append("```")
    lines.extend(cmake_flags)
    lines.append("```")
    lines.append("")
    lines.append(
        "**The `/thumbnails` key is not a release-vs-built divergence.** It is the only "
        "`settings-json` difference, and the G-code's first L1 difference, on every "
        "golden-driven row below -- produced by the built side's own golden-ingestion route "
        "through the *shared* vendored source, not by engine disagreement. Every golden-driven "
        "row feeds the built side through `--config <golden>` (this task's own driver choice), "
        "and `DynamicPrintConfig::load_from_json` (`vendor/OrcaSlicer/src/libslic3r/Config.cpp`) "
        "runs `handle_legacy_composite` on any fully-loaded JSON config, which rebuilds "
        "`thumbnails` with a comma-space separator "
        "(`vendor/OrcaSlicer/src/libslic3r/PrintConfig.cpp`); the release side never re-loads "
        "its own export, so it keeps the preset default without the space. Because this route "
        "is structural -- every golden-driven row takes it -- `settings-json` cannot reach L0/L1 "
        "through this driver regardless of how faithful the port becomes, so its `normative "
        "oracle` is pinned to `built` by this mechanism rather than by a measured geometric "
        "disagreement; a later task may need to decide at the golden, the comparator or "
        "`docs/ORACLE.md` whether that is acceptable long-term. This is not a normalisation of "
        "the key -- the full byte-for-byte comparison below is unchanged."
    )
    lines.append("")
    lines.append(
        "**Three shapes this table always has a row for**, so a later command never finds a "
        "missing lookup, each with its own `level reached` value rather than a shared `none` "
        "(`none` means something else below: both sides ran and were compared, and no level "
        "passed). A configuration `docs/ORACLE.md` marks as not constructible through the pinned "
        "CLI gets a row reading `release-not-constructible`, `normative oracle` `built`, with no "
        "release-side run attempted (its own section below says so explicitly). An artifact only "
        "one of the two oracles produces gets `release-no-artifact` or `built-no-artifact` rather "
        "than being absent. A run that fails on either side -- unexpected for a constructible row "
        "-- gets `release-run-failed` or `built-run-failed`, still a row, and this script still "
        "exits non-zero for it, never a silent omission."
    )

    for index, result in enumerate(results):
        lines.append("")
        lines.append(f"## {result.configuration} / {result.fixture}")
        lines.append("")
        if index == 0:
            lines.append("(its `oracle/provenance` header is this report's leading table, above.)")
        else:
            lines.append(fetch_provenance_header(result.fixture, result.configuration))
        lines.append("")
        if not result.constructible:
            lines.append(
                "**Not constructible through the pinned CLI** (no committed golden under "
                f"`port/goldens/configs/{result.configuration}.json`): no release-side run was "
                "attempted for this row; the built oracle ran `stage_dump --set` with this row's "
                "own `docs/ORACLE.md` overrides."
            )
            lines.append("")
        if result.release_failed:
            lines.append(f"**The release-side run failed.** {result.failure_detail.strip()}")
            lines.append("")
        if result.built_failed:
            lines.append(f"**The built-side run failed.** {result.failure_detail.strip()}")
            lines.append("")
        lines.append("| Artifact | Level reached | Normative oracle |")
        lines.append("|---|---|---|")
        for m in result.measurements:
            lines.append(f"| {m.artifact} | {m.level_reached} | {result.normative_oracle} |")
        lines.append("")
        any_diff = False
        for m in result.measurements:
            # One bullet per difference found (task.md's own "lists one entry per difference
            # found with its first failing location"), never collapsed across levels even when
            # several carry the identical withheld sentence -- a reader must be able to count
            # "four levels failed here", not just "something failed".
            for d in m.differences:
                any_diff = True
                if d.withheld:
                    # A JSON artifact's withheld `Difference` always carries `level="none"`
                    # (`json_difference` has no per-level breakdown to name, unlike gcode's
                    # L1-L4) -- naming it here would read as "level reached: none" rather than
                    # as the literal string `Difference.level` happens to hold, so it is left
                    # out and only a real gcode level is named.
                    marker = f"{d.level}, withheld" if d.level != "none" else "withheld"
                else:
                    marker = d.level
                lines.append(f"- **{m.artifact}** ({marker}): {d.detail}")
        if not any_diff:
            lines.append("No differences recorded beyond L0/L1 for this row's artifacts.")

    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# CLI.
# ---------------------------------------------------------------------------


@click.command()
def main() -> None:
    """Report whether the pinned release binary and the locally built libslic3r agree (R6)."""
    SCRATCH_ROOT.mkdir(parents=True, exist_ok=True)

    # Probed once, up front, environment-wide (mirrors oracle/slice's and oracle/determinism's
    # own check): a missing release binary must stop this script before any committed file is
    # touched, not silently skip every release-side run.
    import os

    if not os.access(ORACLE_BINARY, os.X_OK):
        click.echo(f"error: oracle binary not found or not executable: {ORACLE_BINARY}", err=True)
        click.echo("run `just oracle-fetch` first.", err=True)
        sys.exit(1)

    try:
        rows = load_configuration_rows()
        determinism_gates = load_release_determinism_gates()
        cmake_flags = built_oracle_cmake_flags()
        stage_dump_bin, stage_dump_build_seconds = build_stage_dump()
    except ParityError as exc:
        click.echo(f"error: {exc}", err=True)
        sys.exit(1)

    click.echo(f"built {stage_dump_bin} in {stage_dump_build_seconds:.1f}s")

    results: list[RowResult] = []
    try:
        for row in rows:
            for fixture in row.fixtures:
                result = measure_row(row, fixture, stage_dump_bin, determinism_gates)
                results.append(result)
                for m in result.measurements:
                    click.echo(
                        f"{m.configuration} {m.fixture} {m.artifact}: level {m.level_reached}, "
                        f"normative {result.normative_oracle}"
                    )
                    for d in m.differences:
                        tag = "withheld (see determinism.tsv)" if d.withheld else d.level
                        click.echo(f"  [{tag}] {d.detail}")
                        if d.withheld and d.stdout_detail:
                            # This run's real, uncommitted location -- never written to the
                            # committed .md (see Difference.stdout_detail), printed here because
                            # stdout is not a committed file and costs nothing against
                            # idempotence.
                            click.echo(f"  [{tag}, this run's actual measurement] {d.stdout_detail}")
    except ParityError as exc:
        # A problem measuring one row stops the whole run before either committed file is
        # written, rather than publishing a partial .tsv/.md that silently omits the rows after
        # it -- itself the "missing lookup" failure task.md's own three shapes exist to prevent.
        click.echo(f"error: {exc}", err=True)
        sys.exit(1)

    # task.md's third shape: "a run that fails on either side is a row and a non-zero exit, not
    # a silent omission" -- so both committed files are written from whatever was measured
    # (each failed row carries its own `release-run-failed`/`built-run-failed` sentinel, never a
    # bare `none`) *before* this script decides its exit code, rather than refusing to publish.
    tsv_text = render_tsv(results)
    try:
        md_text = render_markdown(results, cmake_flags)
    except ParityError as exc:
        click.echo(f"error: {exc}", err=True)
        sys.exit(1)

    PARITY_TSV.parent.mkdir(parents=True, exist_ok=True)
    PARITY_TSV.write_text(tsv_text)
    PARITY_MD.write_text(md_text)

    click.echo(f"wrote {PARITY_TSV.relative_to(REPO_ROOT)} ({sum(len(r.measurements) for r in results)} rows)")
    click.echo(f"wrote {PARITY_MD.relative_to(REPO_ROOT)}")

    # A run that fails on either side -- whether or not the row was constructible, since a
    # non-constructible row's own built-side `--set` run can still fail -- is a harness anomaly,
    # not a measured outcome worth a clean exit: the row is still in both files above (never a
    # silent omission), but this script's own exit status says so too (task.md: "a run that
    # fails on either side is a row and a non-zero exit, not a silent omission").
    failed = [r for r in results if r.release_failed or r.built_failed]
    if failed:
        for r in failed:
            click.echo(f"error: {r.configuration} {r.fixture}: {r.failure_detail.strip()}", err=True)
        sys.exit(1)


if __name__ == "__main__":
    main()
