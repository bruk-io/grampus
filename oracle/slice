#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "click>=8.1.0",
# ]
# ///

"""Run the pinned oracle headlessly on a named configuration from docs/ORACLE.md.

Resolves <configuration> to a row of the configuration table in docs/ORACLE.md, then invokes
the binary oracle/fetch-release staged at oracle/.cache/app/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
from a fresh scratch directory as:

    "$BIN" --datadir "$SCRATCH/datadir" \\
      --load-settings "<machine json>;<process json>" \\
      --load-filaments "<filament json>" \\
      --slice 0 --arrange 0 --outputdir "$OUT" \\
      [--<override-key>=<override-value> ...] \\
      [--export-settings "$OUT/settings.json"] [--export-statistics] <fixture>

Every run gets a fresh --datadir and a fresh working directory under oracle/.cache/slice/, both
git-ignored, so a failing run's 00000.log never lands in the working tree. --datadir is never
selectable from this script's own command line.

A configuration row's "Overrides" cell holds the key=value pairs this task's own documentation
fixes (e.g. enable_support=1), passed through as --enable-support=1 — the equals form the pinned
CLI's read_cli() accepts for every option type, including the coBool ones a space-separated value
would silently misparse as a stray positional file argument.

A row naming no filament is rejected here, before the binary runs, because omitting
--load-filaments still exits 0 and slices with a different filament. A row naming no machine or
process omits --load-settings entirely and lets the binary fail on its own terms. A filament path
that is named but absent from disk is likewise left to the binary's own CLI_CONFIG_FILE_ERROR.

This script writes no provenance header of its own and does not call oracle/provenance.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path

import click

REPO_ROOT = Path(__file__).resolve().parent.parent
ORACLE_DOC = REPO_ROOT / "docs" / "ORACLE.md"
BINARY = REPO_ROOT / "oracle" / ".cache" / "app" / "OrcaSlicer.app" / "Contents" / "MacOS" / "OrcaSlicer"
PROFILES_DIR = REPO_ROOT / "vendor" / "OrcaSlicer" / "resources" / "profiles" / "BBL"
SCRATCH_ROOT = REPO_ROOT / "oracle" / ".cache" / "slice"

# Transcribed from vendor/OrcaSlicer/src/libslic3r/Utils.hpp:42-94. Exactly these nine entries;
# an exit code not listed here is reported as its converted value, never as a success.
EXIT_CODES = {
    0: "CLI_SUCCESS",
    -2: "CLI_INVALID_PARAMS",
    -5: "CLI_CONFIG_FILE_ERROR",
    -17: "CLI_PROCESS_NOT_COMPATIBLE",
    -50: "CLI_NO_SUITABLE_OBJECTS",
    -51: "CLI_VALIDATE_ERROR",
    -60: "CLI_NO_SUITABLE_OBJECTS_AFTER_SKIP",
    -100: "CLI_SLICING_ERROR",
    -101: "CLI_GCODE_PATH_CONFLICTS",
}

SEPARATOR_RE = re.compile(r"^:?-+:?$")


class ConfigurationError(Exception):
    """Raised for a problem in docs/ORACLE.md's configuration table itself."""


def split_row(line: str) -> list[str]:
    """Split one markdown table line into its trimmed cells."""
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


def strip_cell(cell: str) -> str:
    """Drop a cell's surrounding backticks and whitespace, and read "(none)" as empty."""
    cell = cell.strip()
    if cell.startswith("`") and cell.endswith("`") and len(cell) >= 2:
        cell = cell[1:-1].strip()
    if cell.lower() in ("", "(none)", "-", "—"):
        return ""
    return cell


def find_configuration_table(doc_text: str) -> list[dict[str, str]]:
    """Return the rows of the markdown table whose first column is "Configuration".

    docs/ORACLE.md holds more than one table (the asset table, the gate table a later task
    adds); only the one headed "Configuration" is this script's row source.
    """
    lines = doc_text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i].strip()
        if line.startswith("|") and i + 1 < len(lines):
            header = split_row(line)
            sep_cells = split_row(lines[i + 1].strip()) if lines[i + 1].strip().startswith("|") else []
            if header and header[0] == "Configuration" and sep_cells and all(
                SEPARATOR_RE.match(c) for c in sep_cells
            ):
                rows = []
                j = i + 2
                while j < len(lines) and lines[j].strip().startswith("|"):
                    cells = split_row(lines[j])
                    rows.append(dict(zip(header, cells)))
                    j += 1
                return rows
            i += 1
        else:
            i += 1
    raise ConfigurationError(f"no table headed 'Configuration' found in {ORACLE_DOC}")


def resolve_preset(cell: str) -> Path:
    """Resolve a table cell naming a preset path under the vendored BBL profiles directory."""
    return PROFILES_DIR / cell


def load_row(name: str) -> dict[str, str]:
    """Find and return the configuration row named `name`, or raise ConfigurationError."""
    if not ORACLE_DOC.is_file():
        raise ConfigurationError(f"{ORACLE_DOC} does not exist")
    rows = find_configuration_table(ORACLE_DOC.read_text())
    for row in rows:
        if strip_cell(row.get("Configuration", "")) == name:
            return row
    known = ", ".join(strip_cell(r.get("Configuration", "")) for r in rows)
    raise ConfigurationError(f"no configuration row named {name!r} in {ORACLE_DOC} (known: {known})")


def parse_overrides(cell: str) -> list[tuple[str, str]]:
    """Parse an "Overrides" cell's ;-separated key=value pairs."""
    cell = cell.strip()
    if not cell or strip_cell(cell) == "":
        return []
    pairs = []
    for part in cell.split(";"):
        part = strip_cell(part)
        if not part:
            continue
        if "=" not in part:
            raise ConfigurationError(f"malformed override {part!r}: expected key=value")
        key, value = part.split("=", 1)
        pairs.append((key.strip(), value.strip()))
    return pairs


def parse_filaments(cell: str) -> list[str]:
    """Parse a "Filament(s)" cell's ;-separated preset paths."""
    filaments = []
    for part in cell.split(";"):
        part = strip_cell(part)
        if part:
            filaments.append(part)
    return filaments


def fresh_scratch_dir() -> Path:
    """Make and return a fresh scratch directory under oracle/.cache/slice/."""
    run_id = f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
    scratch = SCRATCH_ROOT / run_id
    scratch.mkdir(parents=True)
    return scratch


@click.command()
@click.argument("fixture")
@click.argument("configuration")
@click.option("--export-settings", is_flag=True, help="Write settings.json beside the G-code.")
@click.option(
    "--export-statistics", is_flag=True, help="Write plate_1.statistics.json beside the G-code."
)
@click.option(
    "--out",
    "out_dir_arg",
    type=click.Path(file_okay=False),
    default=None,
    help="Output directory; defaults to a fresh directory under the scratch directory.",
)
def main(
    fixture: str, configuration: str, export_settings: bool, export_statistics: bool, out_dir_arg: str | None
) -> None:
    """Run the pinned oracle on <fixture> with the named <configuration> row."""
    invocation_cwd = Path.cwd()

    fixture_path = (invocation_cwd / fixture).resolve()
    if not fixture_path.is_file():
        click.echo(f"error: no such fixture file: {fixture_path}", err=True)
        sys.exit(1)

    if not os.access(BINARY, os.X_OK):
        click.echo(f"error: oracle binary not found or not executable: {BINARY}", err=True)
        click.echo("run `just oracle-fetch` first.", err=True)
        sys.exit(1)

    try:
        row = load_row(configuration)
    except ConfigurationError as exc:
        click.echo(f"error: {exc}", err=True)
        sys.exit(1)

    try:
        filaments = parse_filaments(row.get("Filament(s)", ""))
        overrides = parse_overrides(row.get("Overrides", ""))
    except ConfigurationError as exc:
        click.echo(f"error: configuration {configuration!r}: {exc}", err=True)
        sys.exit(1)

    # The two shapes the oracle will not catch for us.
    if not filaments:
        click.echo(
            f"error: configuration {configuration!r} names no filament "
            "(omitting --load-filaments still exits 0 and slices with a different filament)",
            err=True,
        )
        sys.exit(1)

    machine_cell = strip_cell(row.get("Machine", ""))
    process_cell = strip_cell(row.get("Process", ""))

    scratch = fresh_scratch_dir()
    datadir = scratch / "datadir"
    datadir.mkdir()
    out_dir = (invocation_cwd / out_dir_arg).resolve() if out_dir_arg else scratch / "out"
    out_dir.mkdir(parents=True, exist_ok=True)

    cmd = [str(BINARY), "--datadir", str(datadir)]
    if machine_cell and process_cell:
        machine_path = resolve_preset(machine_cell)
        process_path = resolve_preset(process_cell)
        cmd += ["--load-settings", f"{machine_path};{process_path}"]
    filament_paths = [str(resolve_preset(f)) for f in filaments]
    cmd += ["--load-filaments", ";".join(filament_paths)]
    cmd += ["--slice", "0", "--arrange", "0", "--outputdir", str(out_dir)]
    for key, value in overrides:
        cmd.append(f"--{key.replace('_', '-')}={value}")
    if export_settings:
        cmd += ["--export-settings", str(out_dir / "settings.json")]
    if export_statistics:
        cmd += ["--export-statistics"]
    cmd.append(str(fixture_path))

    click.echo(f"+ {' '.join(cmd)}")
    result = subprocess.run(cmd, cwd=scratch)
    rc = result.returncode

    gcode_path = out_dir / "plate_1.gcode"
    gcode_size = gcode_path.stat().st_size if gcode_path.is_file() else 0

    if rc == 0 and gcode_size > 0:
        click.echo(f"{gcode_path}: {gcode_size} bytes")
        return

    converted = rc - 256 if rc > 127 else rc
    name = EXIT_CODES.get(converted)
    if rc == 0:
        click.echo(
            f"error: exit 0 but {gcode_path} was not written or is empty "
            "(no --outputdir, or a run that silently produced nothing)",
            err=True,
        )
        sys.exit(1)
    if name is not None:
        click.echo(f"error: oracle exited {rc} ({converted} {name})", err=True)
    else:
        click.echo(f"error: oracle exited {rc} ({converted}, unmapped)", err=True)
    sys.exit(rc)


if __name__ == "__main__":
    main()
